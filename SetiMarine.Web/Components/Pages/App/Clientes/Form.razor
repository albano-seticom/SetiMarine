@page "/clientes/novo"
@page "/clientes/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@inject ClienteService ClienteService
@inject AuthService AuthService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>@(_isNovo ? "Novo Cliente" : "Editar Cliente") — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/clientes" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Clientes</a> /</span>
        <h1>@(_isNovo ? "Novo Cliente" : _cliente.Nome)</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <EditForm Model="_cliente" OnValidSubmit="SalvarAsync" style="max-width:640px;">
        <DataAnnotationsValidator />

        <div class="form-section">
            <div class="form-section-title">Dados Pessoais</div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Nome completo *</label>
                    <InputText @bind-Value="_cliente.Nome" placeholder="Nome do cliente" />
                    <ValidationMessage For="() => _cliente.Nome" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>CPF / CNPJ</label>
                    <InputText @bind-Value="_cliente.CpfCnpj" placeholder="000.000.000-00" />
                </div>
                <div class="field">
                    <label>Telefone</label>
                    <InputText @bind-Value="_cliente.Telefone" placeholder="(00) 00000-0000" />
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>E-mail</label>
                    <InputText @bind-Value="_cliente.Email" placeholder="email@exemplo.com" type="email" />
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Endereço</label>
                    <InputText @bind-Value="_cliente.Endereco" placeholder="Rua, número, bairro, cidade" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Acesso ao Portal</div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Senha @(_isNovo ? "*" : "(deixe em branco para não alterar)")</label>
                    <input type="password" @bind="_senha" placeholder="@(_isNovo ? "Senha de acesso ao portal" : "Nova senha (opcional)")" class="@(_isNovo ? "" : "")" style="width:100%;" />
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_cliente.Ativo" />
                        Cliente ativo
                    </label>
                </div>
            </div>
        </div>

        @if (_erro != null)
        {
            <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">
                @_erro
            </div>
        }

        <div class="form-actions">
            <a href="/clientes" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Cliente _cliente = new();
    private string _senha = "";
    private bool _isNovo => Id is null;
    private bool _carregando = true;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        if (!_isNovo)
        {
            var existente = await ClienteService.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/clientes"); return; }
            _cliente = existente;
        }
        else
        {
            _cliente = new Cliente { EmpresaId = UserCtx.EmpresaId, Ativo = true };
        }
        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_senha))
                _cliente.SenhaHash = AuthService.HashSenha(_senha);
            else if (_isNovo)
            {
                _erro = "A senha é obrigatória para novos clientes.";
                _salvando = false;
                return;
            }

            if (_isNovo) await ClienteService.CriarAsync(_cliente);
            else         await ClienteService.EditarAsync(_cliente);
            Nav.NavigateTo("/clientes");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
