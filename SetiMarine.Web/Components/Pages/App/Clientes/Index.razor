@page "/clientes"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@inject ClienteService ClienteService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UsuarioContextService UserCtx

<PageTitle>Clientes — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Cadastros</span>
        <h1>Clientes</h1>
    </div>
    <div class="page-head-actions">
        <a href="/clientes/novo" class="btn btn-primary btn-sm">+ Novo Cliente</a>
    </div>
</div>

<!-- Busca -->
<div style="margin-bottom:1.5rem;max-width:340px;">
    <div class="field" style="margin:0;">
        <input type="search" placeholder="Buscar por nome, CPF/CNPJ ou e-mail..."
               @bind="_busca" @bind:event="oninput" @bind:after="BuscarAsync"
               style="width:100%;height:34px;" />
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;justify-content:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_clientes.Any())
{
    <div style="padding:4rem 2rem;text-align:center;color:var(--ink-300);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin:0 auto 1rem;display:block;opacity:.4;">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.25rem;">
            @(string.IsNullOrWhiteSpace(_busca) ? "Nenhum cliente cadastrado" : "Nenhum cliente encontrado")
        </p>
        @if (string.IsNullOrWhiteSpace(_busca))
        {
            <a href="/clientes/novo" class="btn btn-primary btn-sm">Cadastrar Primeiro Cliente</a>
        }
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF / CNPJ</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>Embarcações</th>
                    <th>Status</th>
                    <th style="width:88px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _clientes)
                {
                    <tr>
                        <td><strong style="font-weight:500;">@c.Nome</strong></td>
                        <td style="color:var(--ink-500);font-size:.82rem;font-family:monospace;">@(c.CpfCnpj ?? "—")</td>
                        <td style="color:var(--ink-500);">@(c.Email ?? "—")</td>
                        <td style="color:var(--ink-500);">@(c.Telefone ?? "—")</td>
                        <td>
                            @if (c.Embarcacoes.Any())
                            {
                                <span class="badge badge-occ">@c.Embarcacoes.Count embarcação@(c.Embarcacoes.Count != 1 ? "ões" : "")</span>
                            }
                            else
                            {
                                <span style="color:var(--ink-300);font-size:.8rem;">—</span>
                            }
                        </td>
                        <td>
                            @if (c.Ativo)
                            { <span class="badge badge-free">Ativo</span> }
                            else
                            { <span class="badge" style="background:var(--line);color:var(--ink-500);">Inativo</span> }
                        </td>
                        <td>
                            <div style="display:flex;gap:.4rem;justify-content:flex-end;">
                                <a href="/clientes/@c.Id" class="btn btn-ghost btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="btn btn-danger btn-sm" title="Excluir" @onclick="() => ConfirmarExclusao(c)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_erro != null)
{
    <div style="margin-top:1.5rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;display:flex;justify-content:space-between;align-items:center;">
        @_erro
        <button @onclick="() => _erro = null" style="background:none;border:none;cursor:pointer;color:inherit;font-size:1rem;line-height:1;padding:0 0 0 1rem;">×</button>
    </div>
}

@code {
    private List<Cliente> _clientes = new();
    private string _busca = "";
    private bool _carregando = true;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _clientes = await ClienteService.ListarPorEmpresaAsync(UserCtx.EmpresaId, _busca);
        _carregando = false;
    }

    private async Task BuscarAsync()
        => await CarregarAsync();

    private async Task ConfirmarExclusao(Cliente cliente)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Excluir o cliente '{cliente.Nome}'?")) return;
        try
        {
            await ClienteService.ExcluirAsync(cliente.Id, UserCtx.EmpresaId);
            await CarregarAsync();
        }
        catch (InvalidOperationException ex) { _erro = ex.Message; }
    }
}
