@page "/secoes"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@inject SecaoService SecaoSvc
@inject UsuarioContextService UserCtx

<PageTitle>Seções — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Marina</span>
        <h1>Seções</h1>
    </div>
    <div class="page-head-actions">
        <a href="/secoes/nova" class="btn btn-primary btn-sm">+ Nova</a>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_secoes.Any())
{
    <div style="padding:3rem 2rem;text-align:center;color:var(--ink-300);">
        <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.5rem;">Nenhuma seção cadastrada</p>
        <a href="/secoes/nova" class="btn btn-primary btn-sm">+ Nova Seção</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Corredores</th>
                    <th style="width:60px;text-align:center;">Ordem</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _secoes)
                {
                    <tr>
                        <td><strong style="font-weight:500;">@s.Nome</strong></td>
                        <td style="color:var(--ink-400);font-size:.82rem;">@(s.Descricao ?? "—")</td>
                        <td style="color:var(--ink-500);">@s.Corredores.Count(c => c.Ativo)</td>
                        <td style="text-align:center;color:var(--ink-400);">@s.Ordem</td>
                        <td>
                            <div style="display:flex;gap:.35rem;justify-content:flex-end;">
                                <a href="/secoes/@s.Id" class="btn btn-ghost btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="btn btn-ghost btn-sm" title="Excluir" style="color:var(--s-maint);"
                                        @onclick="() => ExcluirAsync(s)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_erro != null)
{
    <div style="margin-top:1rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_erro</div>
}

@code {
    private List<Secao> _secoes   = new();
    private bool        _carregando = true;
    private string?     _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _secoes     = await SecaoSvc.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _carregando = false;
    }

    private async Task ExcluirAsync(Secao s)
    {
        _erro = null;
        try
        {
            await SecaoSvc.ExcluirAsync(s.Id, UserCtx.EmpresaId);
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
    }
}
