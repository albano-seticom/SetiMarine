@page "/produtos"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject ProdutoService ProdService
@inject SeederService Seeder
@inject UsuarioContextService UserCtx

<PageTitle>Produtos — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Loja</span>
        <h1>Produtos</h1>
    </div>
    <div class="page-head-actions">
        <div class="field" style="margin:0;min-width:160px;">
            <select @bind="_filtroCategoria" @bind:after="CarregarAsync" style="height:34px;">
                <option value="">Todas as categorias</option>
                <option value="Acessorio">Acessório</option>
                <option value="Combustivel">Combustível</option>
                <option value="Lubrificante">Lubrificante</option>
                <option value="Peca">Peça</option>
                <option value="Equipamento">Equipamento</option>
                <option value="Alimento">Alimento</option>
                <option value="Outro">Outro</option>
            </select>
        </div>
        <a href="/produtos/vendas" class="btn btn-ghost btn-sm">Ver Transações</a>
        <a href="/produtos/novo" class="btn btn-primary btn-sm">+ Novo</a>
        <button class="btn btn-ghost btn-sm" @onclick="SeedAsync" disabled="@_seeding" title="Popular catálogo com produtos base de marina">
            @(_seeding ? "Importando..." : "Catálogo Padrão")
        </button>
    </div>
</div>

@if (_seedMsg != null)
{
    <div style="margin-bottom:1.25rem;padding:.75rem 1rem;background:rgba(34,139,34,.08);border:1px solid rgba(34,139,34,.25);color:#2a7a2a;font-size:.84rem;border-radius:4px;display:flex;justify-content:space-between;align-items:center;">
        @_seedMsg
        <button @onclick="() => _seedMsg = null" style="background:none;border:none;cursor:pointer;color:inherit;font-size:1.1rem;line-height:1;padding:0 0 0 1rem;">×</button>
    </div>
}

@* Contadores *@
<div style="display:flex;gap:.75rem;margin-bottom:1.75rem;flex-wrap:wrap;">
    <div style="padding:.65rem 1rem;border:1px solid var(--line);border-radius:3px;min-width:110px;">
        <div style="font-size:1.4rem;font-weight:700;color:var(--navy-700);line-height:1;">@_produtos.Count</div>
        <div style="font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-400);margin-top:.15rem;">Produtos</div>
    </div>
    <div style="padding:.65rem 1rem;border:1px solid var(--line);border-radius:3px;min-width:110px;">
        <div style="font-size:1.4rem;font-weight:700;color:var(--s-free);line-height:1;">@_produtos.Count(p => p.Alugavel)</div>
        <div style="font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-400);margin-top:.15rem;">Alugáveis</div>
    </div>
    @if (_semEstoque > 0)
    {
        <div style="padding:.65rem 1rem;border:1px solid rgba(164,68,54,.3);border-radius:3px;min-width:110px;background:rgba(164,68,54,.05);">
            <div style="font-size:1.4rem;font-weight:700;color:var(--s-maint);line-height:1;">@_semEstoque</div>
            <div style="font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--s-maint);margin-top:.15rem;opacity:.8;">Sem estoque</div>
        </div>
    }
</div>

@* Lista *@
@if (_carregando)
{
    <div style="padding:2rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_produtos.Any())
{
    <div style="padding:3rem 2rem;text-align:center;color:var(--ink-300);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin:0 auto 1rem;display:block;opacity:.35;">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.5rem;">Nenhum produto cadastrado</p>
        <button class="btn btn-primary btn-sm" @onclick="SeedAsync" disabled="@_seeding">
            @(_seeding ? "Importando..." : "Importar Catálogo Padrão de Marina")
        </button>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Unidade</th>
                    <th>Custo</th>
                    <th>Preço Venda</th>
                    <th>Aluguel/h</th>
                    <th>Aluguel/dia</th>
                    <th>Estoque</th>
                    <th style="width:80px;text-align:center;">Status</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _produtos)
                {
                    var aux          = p.Aux;
                    var estoque      = aux?.Estoque ?? 0;
                    var estoqueMin   = aux?.EstoqueMinimo ?? 0;
                    var estoqueOk    = estoque > estoqueMin;
                    var estoqueBaixo = estoque > 0 && estoque <= estoqueMin;
                    <tr style="@(!p.Ativo ? "opacity:.45;" : "")">
                        <td>
                            <strong style="font-weight:500;">@p.Nome</strong>
                            @if (p.Alugavel)
                            { <span class="badge badge-occ" style="margin-left:.35rem;font-size:.65rem;">Aluguel</span> }
                        </td>
                        <td style="color:var(--ink-500);">@CategoriaLabel(p.Categoria)</td>
                        <td style="color:var(--ink-400);font-size:.8rem;">@p.Unidade</td>
                        <td style="color:var(--ink-400);font-size:.82rem;">@(aux?.PrecoCusto.HasValue == true ? aux.PrecoCusto!.Value.ToString("C2") : "—")</td>
                        <td style="font-weight:500;">@(aux?.PrecoVenda.HasValue == true ? aux.PrecoVenda!.Value.ToString("C2") : "—")</td>
                        <td style="color:var(--ink-500);">@(aux?.PrecoAluguelHora.HasValue == true ? aux.PrecoAluguelHora!.Value.ToString("C2") : "—")</td>
                        <td style="color:var(--ink-500);">@(aux?.PrecoAluguelDia.HasValue == true ? aux.PrecoAluguelDia!.Value.ToString("C2") : "—")</td>
                        <td>
                            @if (aux?.ControlaEstoque == true)
                            {
                                <span style="font-weight:600;color:@(estoqueOk ? "var(--ink-900)" : estoqueBaixo ? "#9a7420" : "var(--s-maint)");">
                                    @estoque
                                </span>
                                @if (estoqueMin > 0)
                                {
                                    <span style="font-size:.72rem;color:var(--ink-300);margin-left:.3rem;">/ mín @estoqueMin</span>
                                }
                            }
                            else
                            {
                                <span style="color:var(--ink-300);font-size:.78rem;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <span class="badge @(p.Ativo ? "badge-free" : "badge-maint")">
                                @(p.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div style="display:flex;gap:.35rem;justify-content:flex-end;">
                                <a href="/produtos/@p.Id" class="btn btn-ghost btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="btn btn-ghost btn-sm" title="@(p.Ativo ? "Desativar" : "Ativar")"
                                        @onclick="() => ToggleAtivoAsync(p)"
                                        style="color:@(p.Ativo ? "var(--s-maint)" : "var(--s-free)");">
                                    @if (p.Ativo)
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Produto> _produtos = new();
    private string _filtroCategoria = "";
    private bool _carregando = true;
    private bool _seeding;
    private int _semEstoque;
    private string? _seedMsg;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        CategoriaProduto? cat = Enum.TryParse<CategoriaProduto>(_filtroCategoria, out var cv) ? cv : null;
        _produtos   = await ProdService.ListarAsync(UserCtx.EmpresaId, apenasAtivos: null, categoria: cat);
        _semEstoque = _produtos.Count(p => p.Aux?.ControlaEstoque == true && p.Aux.Estoque == 0 && p.Ativo);
        _carregando = false;
    }

    private async Task ToggleAtivoAsync(Produto p)
    {
        await ProdService.AlternarAtivoAsync(p.Id, UserCtx.EmpresaId);
        await CarregarAsync();
    }

    private async Task SeedAsync()
    {
        _seeding = true;
        _seedMsg = null;

        await Seeder.SeedEmpresaAsync(UserCtx.EmpresaId);
        var prods = await Seeder.SeedProdutosAsync(UserCtx.EmpresaId);

        _seedMsg = prods == 0
            ? "O catálogo completo já foi importado anteriormente."
            : $"{prods} produto(s) do catálogo importados com sucesso.";

        _seeding = false;
        await CarregarAsync();
    }

    private static string CategoriaLabel(CategoriaProduto c) => c switch
    {
        CategoriaProduto.Acessorio    => "Acessório",
        CategoriaProduto.Combustivel  => "Combustível",
        CategoriaProduto.Lubrificante => "Lubrificante",
        CategoriaProduto.Peca         => "Peça",
        CategoriaProduto.Equipamento  => "Equipamento",
        CategoriaProduto.Alimento     => "Alimento",
        _                             => "Outro",
    };
}
