@page "/produtos/novo"
@page "/produtos/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject ProdutoService ProdService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>@(_isNovo ? "Novo Produto" : "Editar Produto") — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/produtos" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Produtos</a> /</span>
        <h1>@(_isNovo ? "Novo Produto" : _prod.Nome)</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <EditForm Model="_prod" OnValidSubmit="SalvarAsync" style="max-width:720px;">
        <DataAnnotationsValidator />

        <div class="form-section">
            <div class="form-section-title">Identificação</div>

            <div class="form-row">
                <div class="field">
                    <label>Nome *</label>
                    <InputText @bind-Value="_prod.Nome" placeholder="Ex: Colete Salva-Vidas" />
                    <ValidationMessage For="() => _prod.Nome" />
                </div>
                <div class="field">
                    <label>Categoria</label>
                    <select value="@_categoriaStr" @onchange="e => _categoriaStr = e.Value?.ToString() ?? string.Empty">
                        <option value="Acessorio">Acessório</option>
                        <option value="Combustivel">Combustível</option>
                        <option value="Lubrificante">Lubrificante</option>
                        <option value="Peca">Peça</option>
                        <option value="Equipamento">Equipamento</option>
                        <option value="Alimento">Alimento</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Descrição</label>
                    <InputTextArea @bind-Value="_prod.Descricao" rows="2" style="resize:vertical;" placeholder="Detalhes, especificações, referências..." />
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_prod.Alugavel" />
                        Disponível para aluguel
                    </label>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Preços</div>

            <div class="form-row">
                <div class="field">
                    <label>Unidade</label>
                    <InputText @bind-Value="_prod.Unidade" placeholder="un, L, kg, m..." />
                </div>
                <div class="field">
                    <label>Preço de Custo (R$)</label>
                    <InputNumber @bind-Value="_aux.PrecoCusto" />
                </div>
                <div class="field">
                    <label>Preço de Venda (R$)</label>
                    <InputNumber @bind-Value="_aux.PrecoVenda" />
                </div>
            </div>

            @if (_prod.Alugavel)
            {
                <div class="form-row">
                    <div class="field">
                        <label>Aluguel por Hora (R$)</label>
                        <InputNumber @bind-Value="_aux.PrecoAluguelHora" />
                    </div>
                    <div class="field">
                        <label>Aluguel por Dia (R$)</label>
                        <InputNumber @bind-Value="_aux.PrecoAluguelDia" />
                    </div>
                </div>
            }
        </div>

        <div class="form-section">
            <div class="form-section-title">Estoque</div>

            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_aux.ControlaEstoque" />
                        Controla estoque
                    </label>
                </div>
            </div>

            @if (_aux.ControlaEstoque)
            {
                <div class="form-row">
                    <div class="field">
                        <label>Estoque atual</label>
                        <InputNumber @bind-Value="_aux.Estoque" />
                    </div>
                    <div class="field">
                        <label>Estoque mínimo (alerta)</label>
                        <InputNumber @bind-Value="_aux.EstoqueMinimo" />
                    </div>
                </div>
            }
        </div>

        <div class="form-section">
            <div class="form-section-title">Dados Fiscais</div>

            <div class="form-row">
                <div class="field">
                    <label>NCM</label>
                    <InputText @bind-Value="_aux.Ncm" placeholder="Ex: 8903.91.00" />
                </div>
                <div class="field">
                    <label>CFOP</label>
                    <InputText @bind-Value="_aux.Cfop" placeholder="Ex: 5102" />
                </div>
                <div class="field">
                    <label>CST ICMS</label>
                    <InputText @bind-Value="_aux.CstIcms" placeholder="Ex: 00, 40, 60" />
                </div>
                <div class="field">
                    <label>CST PIS/COFINS</label>
                    <InputText @bind-Value="_aux.CstPisCofins" placeholder="Ex: 01, 07" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Alíq. ICMS (%)</label>
                    <InputNumber @bind-Value="_aux.AliquotaICMS" />
                </div>
                <div class="field">
                    <label>Alíq. IPI (%)</label>
                    <InputNumber @bind-Value="_aux.AliquotaIPI" />
                </div>
                <div class="field">
                    <label>Alíq. PIS (%)</label>
                    <InputNumber @bind-Value="_aux.AliquotaPIS" />
                </div>
                <div class="field">
                    <label>Alíq. COFINS (%)</label>
                    <InputNumber @bind-Value="_aux.AliquotaCOFINS" />
                </div>
                <div class="field">
                    <label>Alíq. ISS (%)</label>
                    <InputNumber @bind-Value="_aux.AliquotaISS" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Situação</div>
            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_prod.Ativo" />
                        Produto ativo
                    </label>
                </div>
            </div>
        </div>

        @if (_erro != null)
        {
            <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">@_erro</div>
        }

        <div class="form-actions">
            <a href="/produtos" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Produto    _prod = new() { Ativo = true, Unidade = "un" };
    private ProdutoAux _aux  = new();
    private string     _categoriaStr = "Outro";

    private bool _isNovo     => Id is null;
    private bool _carregando  = true;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();

        if (!_isNovo)
        {
            var existente = await ProdService.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/produtos"); return; }
            _prod         = existente;
            _aux          = existente.Aux ?? new ProdutoAux();
            _categoriaStr = _prod.Categoria.ToString();
        }
        else
        {
            _prod = new Produto { EmpresaId = UserCtx.EmpresaId, Ativo = true, Unidade = "un" };
            _aux  = new ProdutoAux();
        }
        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro     = null;
        try
        {
            _prod.Categoria = Enum.Parse<CategoriaProduto>(_categoriaStr);
            _prod.EmpresaId = UserCtx.EmpresaId;

            if (_isNovo) await ProdService.CriarAsync(_prod, _aux);
            else         await ProdService.EditarAsync(_prod, _aux);

            Nav.NavigateTo("/produtos");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
