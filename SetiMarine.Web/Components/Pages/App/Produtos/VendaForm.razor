@page "/produtos/vendas/nova"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject ProdutoService ProdService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>Registrar Venda / Aluguel — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/produtos/vendas" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Transações</a> /</span>
        <h1>Registrar Venda ou Aluguel</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <div style="max-width:680px;">
        <div class="form-section">
            <div class="form-section-title">Tipo de Transação</div>
            <div style="display:flex;gap:.75rem;">
                <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;padding:.6rem 1rem;border:1px solid var(--line);border-radius:3px;@(_tipo == "Venda" ? "border-color:var(--navy-700);background:rgba(36,53,149,.04);" : "")">
                    <input type="radio" name="tipo" value="Venda" @onchange="@(() => _tipo = "Venda")" checked="@(_tipo == "Venda")" />
                    <span style="font-size:.82rem;font-weight:500;">Venda</span>
                </label>
                <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;padding:.6rem 1rem;border:1px solid var(--line);border-radius:3px;@(_tipo == "Aluguel" ? "border-color:var(--navy-700);background:rgba(36,53,149,.04);" : "")">
                    <input type="radio" name="tipo" value="Aluguel" @onchange="@(() => _tipo = "Aluguel")" checked="@(_tipo == "Aluguel")" />
                    <span style="font-size:.82rem;font-weight:500;">Aluguel</span>
                </label>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Produto e Quantidade</div>

            <div class="form-row">
                <div class="field">
                    <label>Produto *</label>
                    <select @bind="_produtoIdStr" @bind:after="AtualizarPreco">
                        <option value="">Selecione...</option>
                        @foreach (var p in _produtos.Where(p => _tipo != "Aluguel" || p.Alugavel))
                        {
                            var estoque = p.Aux?.ControlaEstoque == true ? $" — Estoque: {p.Aux.Estoque} {p.Unidade}" : "";
                            <option value="@p.Id">@p.Nome@estoque</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Quantidade *</label>
                    <InputNumber @bind-Value="_quantidade" min="1" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Preço Unitário (R$) *</label>
                    <InputNumber @bind-Value="_precoUnitario" />
                </div>
                <div class="field" style="display:flex;flex-direction:column;justify-content:flex-end;">
                    <div style="padding:.6rem 0;font-size:.95rem;font-weight:600;color:var(--navy-700);">
                        Total: @((_quantidade * _precoUnitario).ToString("C2"))
                    </div>
                </div>
            </div>
        </div>

        @if (_tipo == "Aluguel")
        {
            <div class="form-section">
                <div class="form-section-title">Período do Aluguel</div>
                <div class="form-row">
                    <div class="field">
                        <label>Devolução Prevista *</label>
                        <InputDate @bind-Value="_devolucaoPrevista" />
                    </div>
                </div>
            </div>
        }

        <div class="form-section">
            <div class="form-section-title">Cliente e Observações</div>

            <div class="form-row">
                <div class="field">
                    <label>Cliente</label>
                    <select @bind="_clienteIdStr">
                        <option value="">Não identificado</option>
                        @foreach (var c in _clientes)
                        { <option value="@c.Id">@c.Nome</option> }
                    </select>
                </div>
            </div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Observação</label>
                    <InputTextArea @bind-Value="_observacao" rows="2" style="resize:vertical;" placeholder="Observações adicionais..." />
                </div>
            </div>
        </div>

        @if (_erro != null)
        {
            <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">@_erro</div>
        }

        <div class="form-actions">
            <a href="/produtos/vendas" class="btn btn-ghost">Cancelar</a>
            <button class="btn btn-primary" @onclick="SalvarAsync" disabled="@_salvando">
                @(_salvando ? "Registrando..." : _tipo == "Aluguel" ? "Registrar Aluguel" : "Registrar Venda")
            </button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int? ProdutoId { get; set; }

    private List<Produto> _produtos = new();
    private List<Cliente> _clientes = new();

    private string _tipo = "Venda";
    private string _produtoIdStr = "";
    private string _clienteIdStr = "";
    private int    _quantidade   = 1;
    private decimal _precoUnitario;
    private DateTime? _devolucaoPrevista = DateTime.Today.AddDays(7);
    private string? _observacao;

    private bool _carregando = true;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _produtos = await ProdService.ListarAsync(UserCtx.EmpresaId, apenasAtivos: true);
        _clientes = await ProdService.ListarClientesAsync(UserCtx.EmpresaId);

        if (ProdutoId.HasValue)
        {
            _produtoIdStr = ProdutoId.Value.ToString();
            AtualizarPreco();
        }
        _carregando = false;
    }

    private void AtualizarPreco()
    {
        if (!int.TryParse(_produtoIdStr, out var pid)) return;
        var prod = _produtos.FirstOrDefault(p => p.Id == pid);
        if (prod == null) return;
        _precoUnitario = _tipo == "Aluguel"
            ? prod.Aux?.PrecoAluguelDia ?? 0
            : prod.Aux?.PrecoVenda      ?? 0;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro     = null;
        try
        {
            if (!int.TryParse(_produtoIdStr, out var pid) || pid == 0)
            { _erro = "Selecione o produto."; _salvando = false; return; }

            if (_quantidade <= 0)
            { _erro = "Quantidade deve ser maior que zero."; _salvando = false; return; }

            if (_tipo == "Aluguel" && _devolucaoPrevista == null)
            { _erro = "Informe a data de devolução prevista."; _salvando = false; return; }

            var t = new VendaProduto
            {
                EmpresaId             = UserCtx.EmpresaId,
                ProdutoId             = pid,
                ClienteId             = int.TryParse(_clienteIdStr, out var cid) ? cid : null,
                UsuarioId             = UserCtx.UsuarioId,
                Quantidade            = _quantidade,
                PrecoUnitario         = _precoUnitario,
                Observacao            = _observacao,
                DataDevolucaoPrevista = _tipo == "Aluguel" ? _devolucaoPrevista!.Value.ToUniversalTime() : null,
            };

            if (_tipo == "Aluguel") await ProdService.RegistrarAluguelAsync(t);
            else                    await ProdService.RegistrarVendaAsync(t);

            Nav.NavigateTo("/produtos/vendas");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
