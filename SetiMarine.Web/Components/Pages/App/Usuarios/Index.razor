@page "/usuarios"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject UsuarioService UsuarioService
@inject UsuarioContextService UserCtx

<PageTitle>Usuários — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Gestão</span>
        <h1>Usuários</h1>
    </div>
    <div class="page-head-actions">
        <a href="/usuarios/novo" class="btn btn-primary btn-sm">+ Novo Usuário</a>
    </div>
</div>

<div style="margin-bottom:1.5rem;max-width:340px;">
    <div class="field" style="margin:0;">
        <input type="search" placeholder="Buscar por nome ou e-mail..."
               @bind="_busca" @bind:event="oninput" @bind:after="CarregarAsync"
               style="width:100%;height:34px;" />
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;justify-content:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_usuarios.Any())
{
    <div style="padding:4rem 2rem;text-align:center;color:var(--ink-300);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin:0 auto 1rem;display:block;opacity:.4;"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.25rem;">
            @(string.IsNullOrWhiteSpace(_busca) ? "Nenhum usuário cadastrado" : "Nenhum usuário encontrado")
        </p>
        @if (string.IsNullOrWhiteSpace(_busca))
        { <a href="/usuarios/novo" class="btn btn-primary btn-sm">Criar Primeiro Usuário</a> }
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Cadastrado em</th>
                    <th>Status</th>
                    <th style="width:110px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _usuarios)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:.6rem;">
                                <div style="width:30px;height:30px;border-radius:3px;background:var(--navy-900);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0;">
                                    @u.Nome[0].ToString().ToUpper()
                                </div>
                                <strong style="font-weight:500;">@u.Nome</strong>
                            </div>
                        </td>
                        <td style="color:var(--ink-500);">@u.Email</td>
                        <td>
                            @if (u.Perfil == PerfilUsuario.Admin)
                            { <span class="badge" style="background:rgba(38,58,154,.1);color:var(--navy-700);">Administrador</span> }
                            else if (u.Perfil == PerfilUsuario.SuperAdmin)
                            { <span class="badge" style="background:rgba(164,68,54,.1);color:var(--s-maint);">Super Admin</span> }
                            else
                            { <span class="badge" style="background:var(--line);color:var(--ink-500);">Operacional</span> }
                        </td>
                        <td style="color:var(--ink-500);font-size:.8rem;">@u.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (u.Ativo)
                            { <span class="badge badge-free">Ativo</span> }
                            else
                            { <span class="badge" style="background:var(--line);color:var(--ink-500);">Inativo</span> }
                        </td>
                        <td>
                            <div style="display:flex;gap:.4rem;justify-content:flex-end;">
                                <a href="/usuarios/@u.Id" class="btn btn-ghost btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="btn btn-ghost btn-sm" title="@(u.Ativo ? "Inativar" : "Ativar")"
                                        @onclick="() => AlternarAtivo(u)"
                                        style="color:@(u.Ativo ? "var(--ink-400)" : "var(--s-free)");">
                                    @if (u.Ativo)
                                    { <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg> }
                                    else
                                    { <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_erro != null)
{
    <div style="margin-top:1.5rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;display:flex;justify-content:space-between;align-items:center;">
        @_erro <button @onclick="() => _erro = null" style="background:none;border:none;cursor:pointer;color:inherit;font-size:1rem;line-height:1;padding:0 0 0 1rem;">×</button>
    </div>
}

@code {
    private List<Usuario> _usuarios = new();
    private string _busca = "";
    private bool _carregando = true;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _usuarios = await UsuarioService.ListarPorEmpresaAsync(UserCtx.EmpresaId, _busca);
        _carregando = false;
    }

    private async Task AlternarAtivo(Usuario u)
    {
        try { await UsuarioService.AlternarAtivoAsync(u.Id, UserCtx.EmpresaId); await CarregarAsync(); }
        catch (Exception ex) { _erro = ex.Message; }
    }
}
