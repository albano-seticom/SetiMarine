@page "/usuarios/novo"
@page "/usuarios/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject UsuarioService UsuarioService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>@(_isNovo ? "Novo Usuário" : "Editar Usuário") — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/usuarios" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Usuários</a> /</span>
        <h1>@(_isNovo ? "Novo Usuário" : _usuario.Nome)</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <EditForm Model="_usuario" OnValidSubmit="SalvarAsync" style="max-width:560px;">
        <DataAnnotationsValidator />

        <div class="form-section">
            <div class="form-section-title">Dados do Usuário</div>

            <div class="form-row" style="grid-template-columns:1fr;">
                <div class="field">
                    <label>Nome completo *</label>
                    <InputText @bind-Value="_usuario.Nome" placeholder="Nome do colaborador" />
                    <ValidationMessage For="() => _usuario.Nome" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>E-mail *</label>
                    <InputText @bind-Value="_usuario.Email" placeholder="email@marina.com" type="email" />
                    <ValidationMessage For="() => _usuario.Email" />
                </div>
                <div class="field">
                    <label>Perfil de acesso</label>
                    <select @bind="_perfilStr">
                        <option value="Operacional">Operacional (Colaborador)</option>
                        <option value="Admin">Administrador (Gerente)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Senha @(_isNovo ? "" : "(deixe em branco para não alterar)")</div>

            <div class="form-row">
                <div class="field">
                    <label>@(_isNovo ? "Senha *" : "Nova senha")</label>
                    <input type="password" @bind="_senha"
                           placeholder="@(_isNovo ? "Senha de acesso" : "Nova senha (opcional)")"
                           style="width:100%;" />
                </div>
                <div class="field">
                    <label>@(_isNovo ? "Confirmar senha *" : "Confirmar nova senha")</label>
                    <input type="password" @bind="_senhaConfirm"
                           placeholder="Repita a senha"
                           style="width:100%;" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Status</div>
            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_usuario.Ativo" />
                        Usuário ativo
                    </label>
                </div>
            </div>
        </div>

        @if (_erro != null)
        {
            <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">@_erro</div>
        }

        <div class="form-actions">
            <a href="/usuarios" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Usuario _usuario = new();
    private string _perfilStr  = "Operacional";
    private string _senha      = "";
    private string _senhaConfirm = "";
    private bool _isNovo    => Id is null;
    private bool _carregando = true;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        if (!_isNovo)
        {
            var existente = await UsuarioService.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/usuarios"); return; }
            _usuario    = existente;
            _perfilStr  = _usuario.Perfil.ToString();
        }
        else
        {
            _usuario = new Usuario { EmpresaId = UserCtx.EmpresaId, Ativo = true };
        }
        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro     = null;
        try
        {
            if (_isNovo && string.IsNullOrWhiteSpace(_senha))
            { _erro = "A senha é obrigatória."; _salvando = false; return; }

            if (!string.IsNullOrWhiteSpace(_senha) && _senha != _senhaConfirm)
            { _erro = "As senhas não coincidem."; _salvando = false; return; }

            _usuario.Perfil = Enum.Parse<PerfilUsuario>(_perfilStr);

            if (_isNovo) await UsuarioService.CriarAsync(_usuario, _senha);
            else         await UsuarioService.EditarAsync(_usuario, _senha);

            Nav.NavigateTo("/usuarios");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
