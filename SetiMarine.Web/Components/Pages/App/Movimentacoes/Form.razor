@page "/movimentacoes/nova"
@page "/movimentacoes/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject MovimentacaoService MovService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>@(_isNovo ? "Nova Movimentação" : "Movimentação") — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/movimentacoes" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Movimentações</a> /</span>
        <h1>@(_isNovo ? "Nova Movimentação" : $"Movimentação #{ Id}")</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <div style="max-width:680px;">

        @if (!_isNovo && _mov != null)
        {
            <!-- Pipeline visual de progresso -->
            <div style="margin-bottom:1.75rem;padding:1rem 1.25rem;border:1px solid var(--line);border-radius:3px;">
                <div style="font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-300);margin-bottom:.85rem;">Progresso da Movimentação</div>
                <div style="display:flex;gap:0;overflow-x:auto;">
                    @foreach (var (st, label) in _etapas)
                    {
                        var concluido = (int)_mov.Status >= (int)st;
                        var atual     = _mov.Status == st;
                        <div style="flex:1;min-width:60px;text-align:center;">
                            <div style="height:4px;background:@(concluido ? "var(--navy-700)" : "var(--line)");margin-bottom:.4rem;border-radius:2px;transition:background .3s;"></div>
                            <div style="font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:@(atual ? "var(--navy-700)" : concluido ? "var(--ink-500)" : "var(--ink-300)");font-weight:@(atual ? "700" : "400");">@label</div>
                        </div>
                    }
                </div>
                @if (_mov.Status != StatusMovimentacao.Finalizado)
                {
                    <div style="margin-top:1rem;">
                        <button class="btn btn-primary btn-sm" @onclick="AvancarStatusAsync">
                            Avançar para próxima etapa →
                        </button>
                    </div>
                }
            </div>
        }

        <EditForm Model="_mov" OnValidSubmit="SalvarAsync">
            <DataAnnotationsValidator />

            <div class="form-section">
                <div class="form-section-title">Embarcação e Vaga</div>

                <div class="form-row">
                    <div class="field">
                        <label>Embarcação *</label>
                        <select value="@_embarcacaoIdStr" @onchange="e => _embarcacaoIdStr = e.Value?.ToString() ?? string.Empty" disabled="@(!_isNovo)">
                            <option value="">Selecione...</option>
                            @foreach (var e in _embarcacoes)
                            { <option value="@e.Id">@e.Nome @(e.Cliente != null ? $"({e.Cliente.Nome})" : "")</option> }
                        </select>
                    </div>
                    <div class="field">
                        <label>Vaga *</label>
                        <select value="@_vagaIdStr" @onchange="e => _vagaIdStr = e.Value?.ToString() ?? string.Empty" disabled="@(!_isNovo)">
                            <option value="">Selecione...</option>
                            @foreach (var v in _vagas)
                            { <option value="@v.Id">@v.Codigo @(v.Corredor != null ? $"— {v.Corredor.Nome}" : "")</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Agendamento</div>

                <div class="form-row">
                    <div class="field">
                        <label>Data e hora agendada *</label>
                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_mov!.AgendadoPara" />
                    </div>
                    <div class="field">
                        <label>Responsável</label>
                        <select value="@_responsavelIdStr" @onchange="e => _responsavelIdStr = e.Value?.ToString() ?? string.Empty">
                            <option value="">Não atribuído</option>
                            @foreach (var u in _colaboradores)
                            { <option value="@u.Id">@u.Nome</option> }
                        </select>
                    </div>
                </div>

                <div class="form-row" style="grid-template-columns:1fr;">
                    <div class="field">
                        <label>Observação</label>
                        <InputTextArea @bind-Value="_mov.Observacao" rows="2" style="resize:vertical;" placeholder="Informações adicionais sobre a movimentação..." />
                    </div>
                </div>
            </div>

            @if (_erro != null)
            {
                <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">@_erro</div>
            }

            <div class="form-actions">
                <a href="/movimentacoes" class="btn btn-ghost">Cancelar</a>
                @if (_isNovo)
                {
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Registrar Movimentação")
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar Alterações")
                    </button>
                }
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Movimentacao _mov = new() { AgendadoPara = DateTime.UtcNow.AddHours(1) };
    private List<Embarcacao> _embarcacoes  = new();
    private List<Vaga>       _vagas        = new();
    private List<Usuario>    _colaboradores = new();

    private string _embarcacaoIdStr  = "";
    private string _vagaIdStr        = "";
    private string _responsavelIdStr = "";

    private bool _isNovo    => Id is null;
    private bool _carregando = true;
    private bool _salvando;
    private string? _erro;

    private static readonly (StatusMovimentacao, string)[] _etapas =
    {
        (StatusMovimentacao.Agendado,          "Agend."),
        (StatusMovimentacao.AguardandoPreparo, "Aguard."),
        (StatusMovimentacao.EmPreparo,         "Preparo"),
        (StatusMovimentacao.Pronto,            "Pronto"),
        (StatusMovimentacao.Descendo,          "Descendo"),
        (StatusMovimentacao.NaAgua,            "Na Água"),
        (StatusMovimentacao.Retornando,        "Retorno"),
        (StatusMovimentacao.Subindo,           "Subindo"),
        (StatusMovimentacao.Finalizado,        "Concl."),
    };

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _embarcacoes   = await MovService.ListarEmbarcacoesAsync(UserCtx.EmpresaId);
        _vagas         = await MovService.ListarVagasAsync(UserCtx.EmpresaId);
        _colaboradores = await MovService.ListarColaboradoresAsync(UserCtx.EmpresaId);

        if (!_isNovo)
        {
            var existente = await MovService.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/movimentacoes"); return; }
            _mov                 = existente;
            _embarcacaoIdStr     = _mov.EmbarcacaoId.ToString();
            _vagaIdStr           = _mov.VagaId.ToString();
            _responsavelIdStr    = _mov.ResponsavelId?.ToString() ?? "";
        }
        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro     = null;
        try
        {
            if (!int.TryParse(_embarcacaoIdStr, out var embId) || embId == 0)
            { _erro = "Selecione a embarcação."; _salvando = false; return; }
            if (!int.TryParse(_vagaIdStr, out var vagId) || vagId == 0)
            { _erro = "Selecione a vaga."; _salvando = false; return; }

            _mov.EmbarcacaoId  = embId;
            _mov.VagaId        = vagId;
            _mov.EmpresaId     = UserCtx.EmpresaId;
            _mov.ResponsavelId = int.TryParse(_responsavelIdStr, out var rid) ? rid : null;
            _mov.AgendadoPara  = DateTime.SpecifyKind(_mov.AgendadoPara, DateTimeKind.Utc);

            if (_isNovo) await MovService.CriarAsync(_mov);
            else         await MovService.AtualizarAsync(_mov);
            Nav.NavigateTo("/movimentacoes");
        }
        catch (Exception ex) { _erro = ex.InnerException?.Message ?? ex.Message; }
        finally { _salvando = false; }
    }

    private async Task AvancarStatusAsync()
    {
        try { await MovService.AvancarStatusAsync(_mov.Id, UserCtx.EmpresaId); Nav.NavigateTo("/movimentacoes"); }
        catch (Exception ex) { _erro = ex.InnerException?.Message ?? ex.Message; }
    }
}
