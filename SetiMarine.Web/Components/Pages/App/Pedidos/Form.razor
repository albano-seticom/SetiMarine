@page "/pedidos/novo"
@page "/pedidos/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject PedidoService PedidoSvc
@inject CaixaService CaixaSvc
@inject ConfiguracaoMarinaService CfgSvc
@inject NotaService NotaSvc
@inject UsuarioContextService UserCtx
@inject NavigationManager Nav

<PageTitle>@(_isNovo ? "Novo Pedido" : $"Pedido #{Id}") — SetiMarine</PageTitle>

<style>
.pdv-wrap {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1rem;
    height: max(380px, calc(100vh - 310px));
    align-items: stretch;
}
.pdv-catalog {
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.pdv-tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
}
.pdv-tab {
    flex: 1;
    padding: .5rem .5rem;
    font-size: .75rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-400);
    background: transparent;
    border: none;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: .12s;
}
.pdv-tab.ativa { color: var(--navy-700); border-bottom-color: var(--navy-700); background: rgba(0,53,128,.03); }
.pdv-search { padding: .4rem .6rem; border-bottom: 1px solid var(--line); flex-shrink: 0; }
.pdv-search input { width: 100%; height: 30px; font-size: .83rem; }
.pdv-list { overflow-y: auto; flex: 1; min-height: 0; }
.pdv-row {
    display: flex; align-items: center; gap: .4rem;
    padding: .48rem .7rem; border-bottom: 1px solid var(--line);
    cursor: pointer; transition: background .1s; user-select: none;
}
.pdv-row:hover { background: rgba(0,53,128,.04); }
.pdv-row:last-child { border-bottom: none; }
.pdv-row-nome { flex: 1; font-size: .83rem; color: var(--ink-700); font-weight: 500; line-height: 1.3; }
.pdv-row-sub  { font-size: .7rem; color: var(--ink-400); font-weight: 400; display: block; }
.pdv-row-preco { font-size: .78rem; color: var(--ink-500); white-space: nowrap; margin-right: .2rem; }
.pdv-add-btn {
    width: 20px; height: 20px; border-radius: 50%;
    border: 1px solid var(--line); background: transparent;
    color: var(--navy-700); font-size: .9rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: .12s; line-height: 1;
}
.pdv-add-btn:hover { background: var(--navy-700); color: #fff; border-color: var(--navy-700); }
/* Painel direito */
.pdv-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.pdv-items-area { flex: 1; overflow-y: auto; min-height: 0; }
.pdv-items {
    border: 1px solid var(--line); border-radius: 6px;
    overflow: hidden; background: var(--paper);
}
.pdv-items table { width: 100%; border-collapse: collapse; font-size: .83rem; }
.pdv-items th {
    padding: .45rem .55rem; font-size: .67rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-400); font-weight: 600;
    border-bottom: 2px solid var(--line); background: rgba(0,0,0,.015);
    text-align: left; white-space: nowrap;
}
.pdv-items td { padding: .32rem .55rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
.pdv-items tr:last-child td { border-bottom: none; }
.pdv-items tr.dev-row td { background: rgba(0,0,0,.012); padding-top: .2rem; padding-bottom: .3rem; }
.pdv-items input[type=number] { width: 68px; height: 26px; text-align: right; font-size: .82rem; padding: 0 .35rem; }
.pdv-items input[type=text]   { height: 26px; font-size: .82rem; padding: 0 .4rem; width: 100%; }
.pdv-items select { height: 26px; font-size: .8rem; padding: 0 .25rem; }
.pdv-empty {
    padding: 2.5rem 1rem; text-align: center; color: var(--ink-300);
    border: 1px dashed var(--line); border-radius: 6px;
}
.pdv-footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    border-top: 1px solid var(--line);
    padding-top: .6rem;
    margin-top: .5rem;
    background: var(--paper, #fff);
}
.pdv-total {
    display: flex; justify-content: space-between; align-items: center;
    padding: .6rem 1rem;
    background: var(--navy-700); color: #fff; border-radius: 4px;
}
.pdv-total strong { font-size: 1.05rem; }
.badge-svc { background: rgba(120,80,220,.1); color: #6040c0; }

/* Força cor explícita nos selects do cabeçalho — evita invisibilidade em dark mode */
.pdv-header .field select {
    background-color: #fff !important;
    color: #12172c !important;
    border: 1px solid var(--line) !important;
    border-radius: 4px !important;
    padding: 0 .4rem !important;
}
</style>

<div class="page-head">
    <div style="display:flex;align-items:baseline;gap:.5rem;">
        <a href="/pedidos" style="font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-400);text-decoration:none;border-bottom:1px solid var(--line);white-space:nowrap;">Pedidos</a>
        <span style="color:var(--ink-300);font-size:.8rem;">/</span>
        <h1 style="margin:0;">@(_isNovo ? "Novo Pedido" : $"Pedido #{Id}")</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    @* ── Cabeçalho compacto ─────────────────────────────────────────── *@
    <div class="pdv-header" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:flex-end;margin-bottom:.75rem;padding:.45rem .75rem;background:var(--paper);border:1px solid var(--line);border-radius:6px;">

        <div style="display:flex;gap:.25rem;flex-shrink:0;align-self:center;">
            @{ var temOS  = _linhas.Any(l => l.EhServico);
               var temVnd = _linhas.Any(l => !l.EhServico && l.TipoStr == "Venda");
               var temEmp = _linhas.Any(l => !l.EhServico && l.TipoStr == "Emprestimo"); }
            <span style="padding:.26rem .6rem;border-radius:3px;font-size:.76rem;white-space:nowrap;border:1px solid @(temOS?"var(--navy-700)":"var(--line)");background:@(temOS?"var(--navy-700)":"transparent");color:@(temOS?"#fff":"var(--ink-300)");">
                Ordem de Serviço
            </span>
            <span style="padding:.26rem .6rem;border-radius:3px;font-size:.76rem;white-space:nowrap;border:1px solid @(temVnd?"var(--s-free)":"var(--line)");background:@(temVnd?"var(--s-free)":"transparent");color:@(temVnd?"#fff":"var(--ink-300)");">
                Venda
            </span>
            <span style="padding:.26rem .6rem;border-radius:3px;font-size:.76rem;white-space:nowrap;border:1px solid @(temEmp?"var(--s-mov)":"var(--line)");background:@(temEmp?"var(--s-mov)":"transparent");color:@(temEmp?"#fff":"var(--ink-300)");">
                Empréstimo
            </span>
        </div>
        <div style="width:1px;background:var(--line);height:22px;flex-shrink:0;align-self:center;"></div>

        <div class="field" style="margin:0;flex:2;min-width:140px;">
            <label style="font-size:.66rem;">Cliente</label>
            <select value="@_clienteIdStr" @onchange="OnClienteChanged" style="height:27px;font-size:.81rem;">
                <option value="">Selecione...</option>
                @foreach (var c in _clientes)
                { <option value="@c.Id" selected="@(_clienteIdStr == c.Id.ToString())">@c.Nome</option> }
            </select>
        </div>

        <div class="field" style="margin:0;flex:2;min-width:130px;">
            <label style="font-size:.66rem;">Embarcação</label>
            <select value="@_embarcacaoIdStr" @onchange="@(ev => _embarcacaoIdStr = ev.Value?.ToString() ?? "")" style="height:27px;font-size:.81rem;">
                <option value="">—</option>
                @foreach (var emb in _embarcacoesFiltradas)
                { <option value="@emb.Id" selected="@(_embarcacaoIdStr == emb.Id.ToString())">@emb.Nome</option> }
            </select>
        </div>

        @if (_pedido.Tipo == TipoPedido.OrdemServico)
        {
            <div class="field" style="margin:0;flex:2;min-width:140px;">
                <label style="font-size:.66rem;">Responsável</label>
                <select value="@_responsavelIdStr" @onchange="@(ev => _responsavelIdStr = ev.Value?.ToString() ?? "")" style="height:27px;font-size:.81rem;">
                    <option value="">Não atribuído</option>
                    @foreach (var u in _colaboradores)
                    { <option value="@u.Id" selected="@(_responsavelIdStr == u.Id.ToString())">@u.Nome</option> }
                </select>
            </div>
        }

        <div class="field" style="margin:0;min-width:120px;">
            <label style="font-size:.66rem;">Previsão</label>
            <input type="date" @bind="_pedido.PrevisaoConclusao" @bind:format="yyyy-MM-dd" style="height:27px;font-size:.81rem;" />
        </div>

        @if (!_isNovo)
        {
            <div class="field" style="margin:0;min-width:110px;">
                <label style="font-size:.66rem;">Status</label>
                <select value="@_statusStr" @onchange="OnStatusChanged" style="height:27px;font-size:.81rem;">
                    <option value="Rascunho" selected="@(_statusStr == "Rascunho")">Rascunho</option>
                    <option value="Aberto" selected="@(_statusStr == "Aberto")">Aberto</option>
                    <option value="EmAndamento" selected="@(_statusStr == "EmAndamento")">Em Andamento</option>
                    <option value="Concluido" selected="@(_statusStr == "Concluido")">Concluído</option>
                    <option value="Cancelado" selected="@(_statusStr == "Cancelado")">Cancelado</option>
                </select>
            </div>
        }
    </div>

    @* Banner: serviços já concluídos — bloqueia edição *@
    @if (_servicosConcluidos > 0)
    {
        <div style="margin-bottom:.75rem;padding:.7rem 1rem;background:rgba(154,116,32,.08);border:1px solid rgba(154,116,32,.35);border-radius:4px;display:flex;align-items:center;gap:.75rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9a7420" stroke-width="2" stroke-linecap="round" flex-shrink="0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span style="font-size:.83rem;color:#7a5c10;flex:1;">
                <strong>@_servicosConcluidos serviço@(_servicosConcluidos != 1 ? "s" : "") já concluído@(_servicosConcluidos != 1 ? "s" : "").</strong>
                Para editar ou reabrir este pedido, cancele ess@(_servicosConcluidos != 1 ? "es serviços" : "e serviço") primeiro na página de
                <a href="/tarefas" style="color:#7a5c10;font-weight:600;">Tarefas</a>.
            </span>
        </div>
    }

    @* ── PDV ─────────────────────────────────────────────────────────── *@
    <div class="pdv-wrap">

        @* Catálogo *@
        <div class="pdv-catalog">
            <div class="pdv-tabs">
                <button class="pdv-tab @(_tabAtiva == "produtos" ? "ativa" : "")"
                        type="button" @onclick='() => { _tabAtiva = "produtos"; _busca = ""; }'>
                    Produtos
                </button>
                <button class="pdv-tab @(_tabAtiva == "servicos" ? "ativa" : "")"
                        type="button" @onclick='() => { _tabAtiva = "servicos"; _busca = ""; }'>
                    Serviços
                </button>
            </div>

            <div class="pdv-search">
                <input type="search" @bind="_busca" @bind:event="oninput"
                       placeholder="@(_tabAtiva == "produtos" ? "Buscar produto..." : "Buscar serviço...")" />
            </div>

            <div class="pdv-list">
                @if (_tabAtiva == "produtos")
                {
                    @foreach (var p in ProdutosFiltrados())
                    {
                        <div class="pdv-row" @onclick="() => AdicionarProduto(p)">
                            <div class="pdv-row-nome">
                                @p.Nome
                                <span class="pdv-row-sub">@p.Unidade · @CategoriaLabel(p.Categoria)</span>
                            </div>
                            <div class="pdv-row-preco">
                                @if (_pedido.Tipo == TipoPedido.Emprestimo && p.Aux?.PrecoAluguelDia != null)
                                { <text>@p.Aux.PrecoAluguelDia.Value.ToString("C2")/dia</text> }
                                else if (p.Aux?.PrecoVenda != null)
                                { <text>@p.Aux.PrecoVenda.Value.ToString("C2")</text> }
                            </div>
                            <button type="button" class="pdv-add-btn" tabindex="-1">+</button>
                        </div>
                    }
                    @if (!ProdutosFiltrados().Any())
                    {
                        <div style="padding:1.5rem;text-align:center;color:var(--ink-300);font-size:.78rem;">Nenhum produto encontrado</div>
                    }
                }
                else
                {
                    @foreach (var s in ServicosFiltrados())
                    {
                        <div class="pdv-row" @onclick="() => AdicionarServico(s.Nome, s.ValorPadrao)">
                            <div class="pdv-row-nome">
                                @s.Nome
                                <span class="pdv-row-sub">
                                    @(s.DuracaoHoras.HasValue ? $"{s.DuracaoHoras:0.#}h · " : "")A cada @s.FrequenciaDias dia(s)
                                </span>
                            </div>
                            <div class="pdv-row-preco">
                                @(s.ValorPadrao.HasValue ? s.ValorPadrao.Value.ToString("C2") : "")
                            </div>
                            <button type="button" class="pdv-add-btn" tabindex="-1">+</button>
                        </div>
                    }
                    <div class="pdv-row" style="background:rgba(0,0,0,.015);" @onclick='() => AdicionarServico("")'>
                        <div class="pdv-row-nome" style="color:var(--ink-400);font-style:italic;">Serviço personalizado...</div>
                        <button type="button" class="pdv-add-btn" tabindex="-1">+</button>
                    </div>
                    @if (!_tiposServico.Any())
                    {
                        <div style="padding:1rem .75rem;font-size:.75rem;color:var(--ink-300);">
                            Nenhum serviço configurado.<br/>
                            <a href="/servicos/nova" style="color:var(--navy-700);">Configure em Ordens de Serviço</a>
                        </div>
                    }
                }
            </div>
        </div>

        @* Painel do pedido *@
        <div class="pdv-panel">

            @* Itens — área scrollável *@
            <div class="pdv-items-area">
                @if (_linhas.Any())
                {
                    <div class="pdv-items">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:22px;">#</th>
                                    <th style="width:60px;">Tipo</th>
                                    <th>Descrição</th>
                                    <th style="width:76px;text-align:right;">Qtd</th>
                                    <th style="width:130px;text-align:right;">R$ Unit.</th>
                                    <th style="width:140px;">Modalidade / Responsável</th>
                                    <th style="width:96px;text-align:right;">Total</th>
                                    <th style="width:28px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (ln, i) in _linhas.Select((ln, i) => (ln, i)))
                                {
                                    <tr>
                                        <td style="color:var(--ink-300);font-size:.74rem;">@(i+1)</td>
                                        <td>
                                            @if (ln.EhServico)
                                            { <span class="badge badge-svc" style="font-size:.68rem;">Serviço</span> }
                                            else
                                            { <span class="badge badge-occ" style="font-size:.68rem;">Prod.</span> }
                                        </td>
                                        <td>
                                            @if (ln.EhServico)
                                            { <input type="text" @bind="ln.Nome" placeholder="Descrição do serviço..." /> }
                                            else
                                            { <span style="font-weight:500;">@ln.Nome</span> }
                                        </td>
                                        <td style="text-align:right;">
                                            @if (!ln.EhServico)
                                            { <input type="number" @bind="ln.Quantidade" min="1" /> }
                                            else
                                            { <span style="color:var(--ink-300);font-size:.8rem;">—</span> }
                                        </td>
                                        <td style="text-align:right;">
                                            <input type="number"
                                                   value="@ln.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                   @onchange="@(e => SetPreco(ln, e.Value?.ToString()))"
                                                   min="0" step="0.01" style="width:112px;" />
                                        </td>
                                        <td>
                                            @if (!ln.EhServico)
                                            {
                                                <select value="@ln.TipoStr"
                                                        @onchange="@(ev => OnTipoItemChanged(ln, ev.Value?.ToString() ?? "Venda"))">
                                                    <option value="Venda">Venda</option>
                                                    @if (ln.Alugavel)
                                                    {
                                                        <option value="Emprestimo">Empréstimo</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <select value="@ln.ResponsavelIdStr"
                                                        @onchange="@(ev => ln.ResponsavelIdStr = ev.Value?.ToString() ?? "")">
                                                    <option value="">— Responsável —</option>
                                                    @foreach (var u in _colaboradores)
                                                    { <option value="@u.Id" selected="@(ln.ResponsavelIdStr == u.Id.ToString())">@u.Nome</option> }
                                                </select>
                                            }
                                        </td>
                                        <td style="text-align:right;font-weight:600;color:var(--navy-700);white-space:nowrap;">
                                            @ln.Total.ToString("C2")
                                        </td>
                                        <td>
                                            <button type="button" @onclick="() => _linhas.RemoveAt(i)"
                                                    style="background:none;border:none;cursor:pointer;color:var(--ink-300);padding:2px;display:flex;">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                            </button>
                                        </td>
                                    </tr>
                                    @if (!ln.EhServico && ln.TipoStr == "Emprestimo")
                                    {
                                        <tr class="dev-row">
                                            <td></td><td></td>
                                            <td colspan="4">
                                                <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;">
                                                    <span style="font-size:.7rem;color:var(--ink-400);">Horas:</span>
                                                    <input type="number" value="@ln.HorasAluguel" min="1" step="1"
                                                           @oninput="@(ev => OnHorasChanged(ln, ev.Value?.ToString()))"
                                                           style="height:24px;font-size:.76rem;width:60px;text-align:center;" />
                                                    @if (ln.PrecoUnitAluguelHora.HasValue)
                                                    {
                                                        <span style="font-size:.7rem;color:var(--ink-400);">× @ln.PrecoUnitAluguelHora.Value.ToString("C2")/h</span>
                                                    }
                                                    else if (ln.PrecoUnitAluguelDia.HasValue)
                                                    {
                                                        <span style="font-size:.7rem;color:var(--ink-400);">× @ln.PrecoUnitAluguelDia.Value.ToString("C2")/dia</span>
                                                    }
                                                    <span style="font-size:.7rem;color:var(--ink-300);margin-left:.25rem;">Dev. prevista:</span>
                                                    <input type="date" @bind="ln.DataDevolucaoPrevista" @bind:format="yyyy-MM-dd" style="height:24px;font-size:.76rem;width:128px;" />
                                                    <span style="font-size:.7rem;color:var(--ink-300);">Real:</span>
                                                    <input type="date" @bind="ln.DataDevolucaoReal" @bind:format="yyyy-MM-dd" style="height:24px;font-size:.76rem;width:128px;" />
                                                </div>
                                            </td>
                                            <td></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="pdv-empty">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin:0 auto .6rem;display:block;opacity:.3;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        <span style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;">Clique em um item para adicionar</span>
                    </div>
                }
            </div>

            @* Footer fixo: totais + observações + ações *@
            <div class="pdv-footer">
                @if (_linhas.Any())
                {
                    <div class="pdv-total">
                        <span style="font-size:.82rem;letter-spacing:.06em;">
                            @_linhas.Count item@(_linhas.Count != 1 ? "s" : "")
                            @if (_linhas.Any(l => l.EhServico))
                            { <text> · @_linhas.Count(l => !l.EhServico) prod. · @_linhas.Count(l => l.EhServico) serv.</text> }
                        </span>
                        <strong>@_linhas.Sum(l => l.Total).ToString("C2")</strong>
                    </div>
                }

                <textarea @bind="_pedido.Observacoes" rows="1"
                          style="width:100%;font-size:.76rem;color:var(--ink-500);border:1px solid var(--line);border-radius:3px;padding:.28rem .5rem;resize:none;background:transparent;margin:0;"
                          placeholder="Observações..."></textarea>

                @if (_erro != null)
                {
                    <div style="padding:.6rem .85rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">@_erro</div>
                }

                @* ── Botões de nota fiscal (só em pedidos existentes) ── *@
                @if (!_isNovo)
                {
                    <div style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;padding:.3rem 0;border-top:1px solid var(--line);">
                        <span style="font-size:.66rem;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-300);flex-shrink:0;">Nota fiscal:</span>
                        @foreach (var tipoNota in new[] { TipoNota.NFe, TipoNota.NFSe, TipoNota.NFCe })
                        {
                            var notaExistente = _notasDoPedido.FirstOrDefault(n => n.Tipo == tipoNota);
                            var label = tipoNota switch { TipoNota.NFe => "NF-e", TipoNota.NFSe => "NFS-e", _ => "NFC-e" };
                            @if (notaExistente != null)
                            {
                                <a href="/notas/@notaExistente.Id"
                                   style="display:inline-flex;align-items:center;gap:.25rem;padding:.2rem .6rem;font-size:.72rem;font-weight:600;border-radius:3px;border:1px solid var(--line);color:var(--ink-500);text-decoration:none;background:rgba(0,0,0,.02);">
                                    @label
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--s-free)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                </a>
                            }
                            else
                            {
                                <button type="button" @onclick="() => GerarNotaAsync(tipoNota)" disabled="@_gerandoNota"
                                        style="padding:.2rem .6rem;font-size:.72rem;font-weight:600;border-radius:3px;border:1px solid var(--line);color:var(--navy-700);background:transparent;cursor:pointer;transition:.12s;">
                                    + @label
                                </button>
                            }
                        }
                        @if (_gerandoNota)
                        {
                            <span style="font-size:.7rem;color:var(--ink-300);display:flex;align-items:center;gap:.3rem;">
                                <div style="width:10px;height:10px;border:1.5px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
                                Gerando...
                            </span>
                        }
                    </div>
                }

                @* ── Linha de ação ── *@
                <div style="display:flex;align-items:center;gap:.5rem;justify-content:flex-end;padding-bottom:.1rem;">
                    <a href="/pedidos" class="btn btn-ghost">Cancelar</a>

                    @if (!_isNovo && _pedido.Status == StatusPedido.Concluido)
                    {
                        <button type="button" @onclick="ReabrirAsync" disabled="@_salvando"
                                style="padding:.5rem 1.25rem;border-radius:3px;font-size:.85rem;font-weight:600;cursor:pointer;transition:.2s;background:var(--s-mov);border:1px solid var(--s-mov);color:#fff;">
                            @(_salvando ? "Reabrindo..." : "Reabrir Pedido")
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="SalvarAsync" disabled="@(_salvando || _salvo)"
                                style="@(_salvo ? "background:#2a7a2a;border-color:#2a7a2a;color:#fff;" : "") padding:.5rem 1.25rem;border-radius:3px;font-size:.85rem;font-weight:600;cursor:pointer;transition:.2s;">
                            @if (_salvo)        { <text>✓ Pedido salvo!</text> }
                            else if (_salvando) { <text>Salvando...</text> }
                            else                { <text>Salvar</text> }
                        </button>
                        @if (_linhas.Any())
                        {
                            <button type="button" @onclick="AbrirModalPagamento" disabled="@_salvando"
                                    style="padding:.5rem 1.25rem;border-radius:3px;font-size:.85rem;font-weight:600;cursor:pointer;transition:.2s;background:var(--s-free);border:1px solid var(--s-free);color:#fff;">
                                Fechar Pedido
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ── Modal de Pagamento ── *@
@if (_mostrarModal)
{
    <div style="position:fixed;inset:0;background:rgba(10,18,40,.55);z-index:900;display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(2px);">
        <div style="background:#fff;border-radius:12px;width:520px;max-width:100%;overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,.22);">

            @* Cabeçalho *@
            <div style="padding:1.1rem 1.4rem;background:var(--navy-700);display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.2rem;">Recebimento do Pedido</div>
                    <div style="font-size:1.5rem;font-weight:800;color:#fff;line-height:1;">@TotalPedido.ToString("C2")</div>
                </div>
                <button type="button" @onclick="() => _mostrarModal = false"
                        style="background:rgba(255,255,255,.12);border:none;border-radius:50%;width:32px;height:32px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;transition:.15s;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            @* Grade de formas de pagamento *@
            <div style="padding:1.25rem 1.4rem;display:grid;grid-template-columns:1fr 1fr 1fr;gap:.65rem;">
                @foreach (var fp in _formasPagamento)
                {
                    var ativo = _valoresPagamento[fp.Key] > 0;
                    <label for="pg-@fp.Key"
                           style="display:block;border-radius:8px;border:1.5px solid @(ativo ? "var(--navy-700)" : "var(--line)");padding:.7rem .8rem;cursor:pointer;transition:.15s;background:@(ativo ? "rgba(0,53,128,.05)" : "transparent");">
                        <div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.55rem;">
                            <span style="display:flex;color:@(ativo ? "var(--navy-700)" : "var(--ink-300)");transition:.15s;">
                                @((MarkupString)IconePagamento(fp.Key))
                            </span>
                            <span style="font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:@(ativo ? "var(--navy-700)" : "var(--ink-400)");transition:.15s;">@fp.Value</span>
                        </div>
                        <div style="position:relative;display:flex;align-items:center;">
                            <span style="position:absolute;left:.5rem;font-size:.78rem;font-weight:600;color:@(ativo ? "var(--navy-700)" : "var(--ink-300)");pointer-events:none;user-select:none;transition:.15s;">R$</span>
                            <input id="pg-@fp.Key" type="number" min="0" step="0.01"
                                   value="@(_valoresPagamento[fp.Key] > 0 ? _valoresPagamento[fp.Key].ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   placeholder="0,00"
                                   @onchange="@(ev => { if (decimal.TryParse(ev.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) && v >= 0) _valoresPagamento[fp.Key] = v; else _valoresPagamento[fp.Key] = 0; })"
                                   onfocus="this.select()"
                                   style="width:100%;padding:.32rem .4rem .32rem 1.85rem;height:34px;font-size:.9rem;font-weight:@(ativo ? "700" : "400");color:@(ativo ? "var(--navy-700)" : "var(--ink-500)");border:1px solid @(ativo ? "var(--navy-700)" : "var(--line)");border-radius:5px;background:transparent;text-align:right;transition:.15s;" />
                        </div>
                    </label>
                }
            </div>

            @* Resumo *@
            <div style="margin:0 1.4rem;border-radius:8px;background:rgba(0,0,0,.03);border:1px solid var(--line);padding:.8rem 1rem;margin-bottom:1rem;">
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:.83rem;margin-bottom:.35rem;">
                    <span style="color:var(--ink-400);">Total do pedido</span>
                    <span style="font-weight:600;color:var(--ink-700);">@TotalPedido.ToString("C2")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:.83rem;">
                    <span style="color:var(--ink-400);">Total recebido</span>
                    <span style="font-weight:700;font-size:.95rem;color:@(TotalPago >= TotalPedido ? "#1e783c" : "var(--s-maint)");">@TotalPago.ToString("C2")</span>
                </div>
                @if (Troco > 0)
                {
                    <div style="margin-top:.5rem;padding-top:.5rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:.83rem;font-weight:600;color:#1e783c;">Troco</span>
                        <span style="font-size:1.05rem;font-weight:800;color:#1e783c;">@Troco.ToString("C2")</span>
                    </div>
                }
                @if (TotalPago > 0 && TotalPago < TotalPedido)
                {
                    <div style="margin-top:.5rem;padding-top:.5rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:.78rem;color:var(--s-maint);">Falta</span>
                        <span style="font-size:.88rem;font-weight:700;color:var(--s-maint);">@((TotalPedido - TotalPago).ToString("C2"))</span>
                    </div>
                }
            </div>

            @* Ações *@
            <div style="padding:.9rem 1.4rem;border-top:1px solid var(--line);display:flex;gap:.5rem;justify-content:flex-end;">
                <button type="button" @onclick="() => _mostrarModal = false" class="btn btn-ghost">Cancelar</button>
                <button type="button" @onclick="ConfirmarFecharAsync"
                        disabled="@(_salvando || TotalPago < TotalPedido)"
                        style="padding:.5rem 1.4rem;border-radius:6px;font-size:.85rem;font-weight:700;cursor:pointer;transition:.2s;background:@(TotalPago >= TotalPedido ? "var(--s-free)" : "var(--line)");border:none;color:@(TotalPago >= TotalPedido ? "#fff" : "var(--ink-300)");">
                    @(_salvando ? "Fechando..." : "Confirmar e Fechar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Pedido _pedido = new() { Tipo = TipoPedido.OrdemServico };
    private List<LinhaRow> _linhas = new();

    private List<Cliente>           _clientes             = new();
    private List<Embarcacao>        _embarcacoes          = new();
    private List<Embarcacao>        _embarcacoesFiltradas = new();
    private List<Produto>           _produtos             = new();
    private List<Usuario>           _colaboradores        = new();
    private List<TipoServicoConfig> _tiposServico         = new();

    private string _clienteIdStr     = "";
    private string _embarcacaoIdStr  = "";
    private string _responsavelIdStr = "";
    private string _statusStr        = "Aberto";
    private string _busca            = "";
    private string _tabAtiva         = "produtos";

    private bool _isNovo    => Id is null;
    private bool _carregando = true;
    private bool _salvando;
    private bool _salvo;
    private bool _gerandoNota;
    private int  _servicosConcluidos;
    private string? _erro;
    private List<Nota> _notasDoPedido = new();

    // Pagamento
    private string  _formaPagamentoStr = "Dinheiro";
    private decimal _valorPago;
    private string  _statusOriginal    = "";
    private bool    _mostrarModal;
    private ConfiguracaoMarina _cfg = new();

    private Dictionary<string, decimal> _valoresPagamento = new()
    {
        ["Dinheiro"]      = 0,
        ["PIX"]           = 0,
        ["DebitoCartao"]  = 0,
        ["CreditoCartao"] = 0,
        ["Transferencia"] = 0,
        ["Outro"]         = 0,
    };

    private decimal TotalPedido => _linhas.Sum(l => l.Total);
    private decimal TotalPago   => _valoresPagamento.Values.Sum();
    private decimal Troco       => TotalPago - TotalPedido;

    private static readonly Dictionary<string, string> _formasPagamento = new()
    {
        ["Dinheiro"]      = "Dinheiro",
        ["PIX"]           = "PIX",
        ["DebitoCartao"]  = "Débito",
        ["CreditoCartao"] = "Crédito",
        ["Transferencia"] = "Transferência",
        ["Outro"]         = "Outro",
    };

    private static string IconePagamento(string forma) => forma switch
    {
        "Dinheiro"      => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='6' width='20' height='12' rx='2'/><circle cx='12' cy='12' r='2'/><path d='M6 12h.01M18 12h.01'/></svg>",
        "PIX"           => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/></svg>",
        "DebitoCartao"  => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='4' width='22' height='16' rx='2'/><line x1='1' y1='10' x2='23' y2='10'/></svg>",
        "CreditoCartao" => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='1' y='4' width='22' height='16' rx='2'/><line x1='1' y1='10' x2='23' y2='10'/><line x1='5' y1='15' x2='9' y2='15'/></svg>",
        "Transferencia" => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='17 1 21 5 17 9'/><path d='M3 11V9a4 4 0 0 1 4-4h14'/><polyline points='7 23 3 19 7 15'/><path d='M21 13v2a4 4 0 0 1-4 4H3'/></svg>",
        _               => "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round'><circle cx='12' cy='12' r='1'/><circle cx='19' cy='12' r='1'/><circle cx='5' cy='12' r='1'/></svg>",
    };

    private class LinhaRow
    {
        public bool      EhServico              { get; set; }
        public bool      Alugavel               { get; set; }
        public string    ProdutoIdStr           { get; set; } = "";
        public string    Nome                   { get; set; } = "";
        public int       Quantidade             { get; set; } = 1;
        public decimal   Preco                  { get; set; }
        public string    TipoStr                { get; set; } = "Venda";
        public string    ResponsavelIdStr       { get; set; } = "";
        public int       HorasAluguel           { get; set; } = 1;
        public decimal?  PrecoUnitAluguelHora   { get; set; }
        public decimal?  PrecoUnitAluguelDia    { get; set; }
        public DateTime? DataDevolucaoPrevista  { get; set; }
        public DateTime? DataDevolucaoReal      { get; set; }
        public decimal Total => EhServico ? Preco : Quantidade * Preco;
    }

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _cfg           = await CfgSvc.ObterAsync(UserCtx.EmpresaId);
        _clientes      = await PedidoSvc.ListarClientesAsync(UserCtx.EmpresaId);
        _embarcacoes   = await PedidoSvc.ListarEmbarcacoesAsync(UserCtx.EmpresaId);
        _produtos      = await PedidoSvc.ListarProdutosAsync(UserCtx.EmpresaId);
        _colaboradores = await PedidoSvc.ListarColaboradoresAsync(UserCtx.EmpresaId);
        _tiposServico  = await PedidoSvc.ListarTiposServicoAsync(UserCtx.EmpresaId);
        _embarcacoesFiltradas = _embarcacoes;

        if (!_isNovo)
        {
            var existente = await PedidoSvc.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/pedidos"); return; }

            _pedido               = existente;
            _clienteIdStr         = existente.ClienteId?.ToString() ?? "";
            _embarcacaoIdStr      = existente.EmbarcacaoId?.ToString() ?? "";
            _responsavelIdStr     = existente.ResponsavelId?.ToString() ?? "";
            _statusStr            = existente.Status.ToString();
            _statusOriginal       = existente.Status.ToString();
            _servicosConcluidos   = existente.Servicos.Count(s => s.Concluido);

            _linhas = existente.Itens.Select(i =>
            {
                var prod = _produtos.FirstOrDefault(p => p.Id == i.ProdutoId);
                return new LinhaRow
                {
                    EhServico             = false,
                    Alugavel              = prod?.Alugavel ?? false,
                    ProdutoIdStr          = i.ProdutoId.ToString(),
                    Nome                  = prod?.Nome ?? "",
                    Quantidade            = i.Quantidade,
                    Preco                 = i.PrecoUnitario,
                    TipoStr               = i.Tipo.ToString(),
                    HorasAluguel          = i.HorasAluguel ?? 1,
                    PrecoUnitAluguelHora  = prod?.Aux?.PrecoAluguelHora,
                    PrecoUnitAluguelDia   = prod?.Aux?.PrecoAluguelDia,
                    DataDevolucaoPrevista = i.DataDevolucaoPrevista,
                    DataDevolucaoReal     = i.DataDevolucaoReal,
                };
            })
            .Concat(existente.Servicos.Select(s => new LinhaRow
            {
                EhServico        = true,
                Nome             = s.Descricao,
                Preco            = s.Valor ?? 0,
                ResponsavelIdStr = s.ResponsavelId?.ToString() ?? "",
            }))
            .ToList();

            AtualizarEmbarcacoes();
            _notasDoPedido = await NotaSvc.ListarPorPedidoAsync(Id!.Value, UserCtx.EmpresaId);
        }
        else
        {
            _pedido = new Pedido { EmpresaId = UserCtx.EmpresaId, Tipo = TipoPedido.OrdemServico };

            // Pré-selecionar responsável = usuário logado
            _responsavelIdStr = UserCtx.UsuarioId.ToString();

            // Pré-selecionar cliente "Consumidor"
            var consumidor = _clientes.FirstOrDefault(c => c.Nome.Equals("Consumidor", StringComparison.OrdinalIgnoreCase));
            if (consumidor != null)
            {
                _clienteIdStr = consumidor.Id.ToString();
                AtualizarEmbarcacoes();
                if (_embarcacoesFiltradas.Count == 1)
                    _embarcacaoIdStr = _embarcacoesFiltradas[0].Id.ToString();
            }
        }

        _carregando = false;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        _statusStr = e.Value?.ToString() ?? "Aberto";
    }

    private void OnClienteChanged(ChangeEventArgs e)
    {
        _clienteIdStr = e.Value?.ToString() ?? "";
        AtualizarEmbarcacoes();
    }

    private void AtualizarEmbarcacoes()
    {
        _embarcacoesFiltradas = int.TryParse(_clienteIdStr, out var cid) && cid > 0
            ? _embarcacoes.Where(e => e.ClienteId == cid).ToList()
            : _embarcacoes;
    }

    private IEnumerable<Produto> ProdutosFiltrados()
    {
        var lista = _pedido.Tipo == TipoPedido.Emprestimo
            ? _produtos.Where(p => p.Alugavel)
            : (IEnumerable<Produto>)_produtos;

        if (!string.IsNullOrWhiteSpace(_busca))
            lista = lista.Where(p => p.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase));

        return lista;
    }

    private IEnumerable<TipoServicoConfig> ServicosFiltrados()
    {
        var lista = (IEnumerable<TipoServicoConfig>)_tiposServico;
        if (!string.IsNullOrWhiteSpace(_busca))
            lista = lista.Where(s => s.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase));
        return lista;
    }

    private static decimal PrecoEmprestimo(Produto p, int horas)
    {
        if (p.Aux?.PrecoAluguelHora != null) return horas * p.Aux.PrecoAluguelHora.Value;
        if (p.Aux?.PrecoAluguelDia  != null) return (horas / 24m) * p.Aux.PrecoAluguelDia.Value;
        return p.Aux?.PrecoVenda ?? 0;
    }

    private static decimal RecalcularPreco(LinhaRow ln)
    {
        if (ln.PrecoUnitAluguelHora.HasValue) return ln.HorasAluguel * ln.PrecoUnitAluguelHora.Value;
        if (ln.PrecoUnitAluguelDia.HasValue)  return (ln.HorasAluguel / 24m) * ln.PrecoUnitAluguelDia.Value;
        return ln.Preco;
    }

    private void AdicionarProduto(Produto p)
    {
        var tipoStr   = _pedido.Tipo == TipoPedido.Emprestimo && p.Alugavel ? "Emprestimo" : "Venda";
        var existente = _linhas.FirstOrDefault(l => !l.EhServico && l.ProdutoIdStr == p.Id.ToString() && l.TipoStr == tipoStr);
        if (existente != null) { existente.Quantidade++; return; }

        var horas = 1;
        _linhas.Add(new LinhaRow
        {
            EhServico             = false,
            Alugavel              = p.Alugavel,
            ProdutoIdStr          = p.Id.ToString(),
            Nome                  = p.Nome,
            Quantidade            = 1,
            PrecoUnitAluguelHora  = p.Aux?.PrecoAluguelHora,
            PrecoUnitAluguelDia   = p.Aux?.PrecoAluguelDia,
            HorasAluguel          = horas,
            Preco                 = tipoStr == "Emprestimo" ? PrecoEmprestimo(p, horas) : (p.Aux?.PrecoVenda ?? 0),
            TipoStr               = tipoStr,
            DataDevolucaoPrevista = tipoStr == "Emprestimo"
                ? DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Utc)
                : null,
        });
    }

    private void OnTipoItemChanged(LinhaRow ln, string novoTipo)
    {
        if (novoTipo == "Emprestimo" && !ln.Alugavel) return;
        ln.TipoStr = novoTipo;
        if (novoTipo == "Emprestimo")
        {
            ln.HorasAluguel          = 1;
            ln.Preco                 = RecalcularPreco(ln);
            ln.DataDevolucaoPrevista ??= DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Utc);
        }
        else
        {
            ln.DataDevolucaoPrevista = null;
            ln.DataDevolucaoReal     = null;
        }
    }

    private void OnHorasChanged(LinhaRow ln, string? valor)
    {
        if (int.TryParse(valor, out var h) && h >= 1)
        {
            ln.HorasAluguel = h;
            ln.Preco        = RecalcularPreco(ln);
        }
    }

    private void AdicionarServico(string nome, decimal? valorPadrao = null)
    {
        var vendedor = _colaboradores.FirstOrDefault(u => u.Nome == "Vendedor");
        var responsavelPadrao = vendedor?.Id.ToString() ?? _responsavelIdStr;
        _linhas.Add(new LinhaRow
        {
            EhServico        = true,
            Nome             = nome,
            Preco            = valorPadrao ?? 0,
            ResponsavelIdStr = responsavelPadrao,
        });
    }


    private static void SetPreco(LinhaRow ln, string? val)
    {
        if (decimal.TryParse(val, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v))
            ln.Preco = v;
    }

    private static string CategoriaLabel(CategoriaProduto c) => c switch
    {
        CategoriaProduto.Combustivel  => "Combustível",
        CategoriaProduto.Lubrificante => "Lubrificante",
        CategoriaProduto.Peca         => "Peça",
        CategoriaProduto.Equipamento  => "Equipamento",
        CategoriaProduto.Alimento     => "Alimento",
        CategoriaProduto.Acessorio    => "Acessório",
        _                             => "Outro",
    };

    private static DateTime? Utc(DateTime? dt)
        => dt.HasValue ? DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc) : null;

    private async Task ReabrirAsync()
    {
        _salvando = true;
        _erro     = null;
        try
        {
            await PedidoSvc.ReabrirAsync(Id!.Value, UserCtx.EmpresaId);
            var atualizado = await PedidoSvc.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (atualizado != null)
            {
                _pedido             = atualizado;
                _statusStr          = atualizado.Status.ToString();
                _servicosConcluidos = atualizado.Servicos.Count(s => s.Concluido);
            }
        }
        catch (Exception ex) { _erro = ex.InnerException?.Message ?? ex.Message; }
        finally { _salvando = false; }
    }

    private async Task GerarNotaAsync(TipoNota tipo)
    {
        _gerandoNota = true;
        _erro        = null;
        try
        {
            var nota = await NotaSvc.GerarDePedidoAsync(Id!.Value, UserCtx.EmpresaId, tipo);
            _notasDoPedido.Add(nota);
        }
        catch (Exception ex) { _erro = ex.InnerException?.Message ?? ex.Message; }
        finally { _gerandoNota = false; }
    }

    private void AbrirModalPagamento()
    {
        foreach (var key in _valoresPagamento.Keys.ToList())
            _valoresPagamento[key] = 0;
        _valoresPagamento["Dinheiro"] = TotalPedido;
        _mostrarModal = true;
    }

    private Task ConfirmarFecharAsync()
    {
        _mostrarModal = false;
        var usados    = _valoresPagamento.Where(kv => kv.Value > 0).ToList();
        _formaPagamentoStr = usados.Count == 1 ? usados[0].Key : "Outro";
        _valorPago         = TotalPago;
        _statusStr         = "Concluido";
        return SalvarAsync();
    }

    private async Task SalvarAsync()
    {
        if (!_isNovo && _servicosConcluidos > 0)
        {
            _erro = $"Não é possível salvar: {_servicosConcluidos} serviço(s) já concluído(s). Cancele-os em Tarefas antes de editar o pedido.";
            return;
        }

        var itemInvalido = _linhas.FirstOrDefault(l => !l.EhServico && l.TipoStr == "Emprestimo" && !l.Alugavel);
        if (itemInvalido != null)
        {
            _erro = $"'{itemInvalido.Nome}' não está disponível para aluguel. Altere o tipo para Venda.";
            return;
        }

        _salvando = true;
        _erro     = null;
        try
        {
            _pedido.ClienteId        = int.TryParse(_clienteIdStr,     out var cid) && cid > 0 ? cid : null;
            _pedido.EmbarcacaoId     = int.TryParse(_embarcacaoIdStr,  out var eid) && eid > 0 ? eid : null;
            _pedido.ResponsavelId    = int.TryParse(_responsavelIdStr, out var rid) && rid > 0 ? rid : null;
            _pedido.PrevisaoConclusao = Utc(_pedido.PrevisaoConclusao);

            var itens = _linhas
                .Where(l => !l.EhServico && int.TryParse(l.ProdutoIdStr, out _))
                .Select(l => new PedidoItem
                {
                    ProdutoId             = int.Parse(l.ProdutoIdStr),
                    Tipo                  = Enum.Parse<TipoItemPedido>(l.TipoStr),
                    Quantidade            = l.Quantidade,
                    PrecoUnitario         = l.Preco,
                    HorasAluguel          = l.TipoStr == "Emprestimo" ? l.HorasAluguel : null,
                    DataDevolucaoPrevista = Utc(l.DataDevolucaoPrevista),
                    DataDevolucaoReal     = Utc(l.DataDevolucaoReal),
                    StatusEmprestimo      = l.TipoStr == "Emprestimo" ? StatusAluguel.Ativo : null,
                }).ToList();

            var servicos = _linhas
                .Where(l => l.EhServico && !string.IsNullOrWhiteSpace(l.Nome))
                .Select(l => new PedidoServico
                {
                    Descricao     = l.Nome,
                    Valor         = l.Preco > 0 ? l.Preco : null,
                    ResponsavelId = int.TryParse(l.ResponsavelIdStr, out var sid) && sid > 0 ? sid : null,
                })
                .ToList();

            var fechando = _statusStr == "Concluido" && _statusOriginal != "Concluido";
            if (fechando)
            {
                if (string.IsNullOrEmpty(_formaPagamentoStr)) _formaPagamentoStr = "Dinheiro";
                _pedido.FormaPagamento = Enum.Parse<FormaPagamento>(_formaPagamentoStr);
                _pedido.ValorPago      = _valorPago > 0 ? _valorPago : _linhas.Sum(l => l.Total);
            }

            if (_isNovo)
            {
                _pedido.Status = fechando ? StatusPedido.Concluido : StatusPedido.Aberto;
                await PedidoSvc.CriarAsync(_pedido, itens, servicos);

                if (fechando && _cfg.CaixaAutomatico)
                {
                    var total     = _linhas.Sum(l => l.Total);
                    var cliente   = _clientes.FirstOrDefault(c => c.Id.ToString() == _clienteIdStr);
                    var fpLabel   = _formasPagamento.GetValueOrDefault(_formaPagamentoStr, _formaPagamentoStr);
                    var descricao = $"Pedido #{_pedido.Id}" +
                                    (cliente != null ? $" — {cliente.Nome}" : "") +
                                    $" ({fpLabel})";
                    await CaixaSvc.RegistrarAutomaticoAsync(
                        UserCtx.EmpresaId,
                        TipoMovimentoCaixa.Entrada,
                        OrigemMovimentoCaixa.ServicoPedido,
                        total, descricao, pedidoId: _pedido.Id);
                }

                _salvo = true;
                StateHasChanged();
                await Task.Delay(800);
                Nav.NavigateTo("/pedidos");
            }
            else
            {
                _pedido.Status = Enum.Parse<StatusPedido>(_statusStr);
                await PedidoSvc.EditarAsync(_pedido, itens, servicos);

                if (fechando && _cfg.CaixaAutomatico)
                {
                    var total      = _linhas.Sum(l => l.Total);
                    var cliente    = _clientes.FirstOrDefault(c => c.Id.ToString() == _clienteIdStr);
                    var fpLabel    = _formasPagamento.GetValueOrDefault(_formaPagamentoStr, _formaPagamentoStr);
                    var descricao  = $"Pedido #{Id}" +
                                     (cliente != null ? $" — {cliente.Nome}" : "") +
                                     $" ({fpLabel})";

                    await CaixaSvc.RegistrarAutomaticoAsync(
                        UserCtx.EmpresaId,
                        TipoMovimentoCaixa.Entrada,
                        OrigemMovimentoCaixa.ServicoPedido,
                        total, descricao, pedidoId: Id);
                }

                var atualizado = await PedidoSvc.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
                if (atualizado != null)
                {
                    _pedido         = atualizado;
                    _statusStr      = atualizado.Status.ToString();
                    _statusOriginal = atualizado.Status.ToString();
                    _servicosConcluidos = atualizado.Servicos.Count(s => s.Concluido);
                }

                _salvo = true;
                StateHasChanged();
                await Task.Delay(800);
                _salvo = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _erro  = ex.InnerException?.Message ?? ex.Message;
            _salvo = false;
        }
        finally { _salvando = false; }
    }
}
