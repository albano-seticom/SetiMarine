@page "/dashboard"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@using System.Text.Json
@inject VagaService VagaService
@inject IJSRuntime JS
@inject UsuarioContextService UserCtx

<PageTitle>Dashboard - SetiMarine</PageTitle>

<style>
.dash{display:flex;flex-direction:column;gap:1.1rem;height:100%;}
.dash-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.8rem;}
.dash-title{font-family:'Barlow Condensed',sans-serif;font-size:1.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--ocean-800,#0d1f3c);}
.dash-sub{font-size:.8rem;color:var(--ocean-200,#4d8fd4);margin-top:2px;text-transform:capitalize;}
.dash-actions{display:flex;gap:.5rem;}
.btn-dash{display:inline-flex;align-items:center;gap:.4rem;padding:.45rem 1rem;border-radius:7px;font-family:'Barlow',sans-serif;font-size:.83rem;font-weight:600;cursor:pointer;text-decoration:none;transition:all .15s;border:none;}
.btn-dash.outline{background:transparent;color:var(--ocean-600,#112a52);border:1.5px solid rgba(22,53,103,.2);}
.btn-dash.outline:hover{background:var(--ocean-50,#e8f3fb);border-color:var(--ocean-400,#1d4785);}
.btn-dash.coral{background:var(--coral,#e8453c);color:#fff;box-shadow:0 2px 8px rgba(232,69,60,.3);}
.btn-dash.coral:hover{background:#c43832;transform:translateY(-1px);}
.btn-dash.teal{background:var(--teal,#1ab3a6);color:#fff;box-shadow:0 2px 6px rgba(26,179,166,.3);}
.btn-dash.teal:hover{background:#128f84;transform:translateY(-1px);}

.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;}
@@media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr);}}
.mc{background:#fff;border:1px solid rgba(22,53,103,.1);border-radius:10px;padding:.9rem 1.1rem;display:flex;align-items:center;gap:.9rem;position:relative;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.07);transition:box-shadow .2s,transform .2s;}
.mc:hover{box-shadow:0 4px 18px rgba(0,0,0,.12);transform:translateY(-2px);}
.mc-bar{position:absolute;top:0;left:0;right:0;height:3px;}
.mc.g .mc-bar{background:#1ab3a6;} .mc.b .mc-bar{background:#1d4785;} .mc.y .mc-bar{background:#c9a84c;} .mc.r .mc-bar{background:#e8453c;}
.mc-ico{width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.mc.g .mc-ico{background:rgba(26,179,166,.1);color:#1ab3a6;}
.mc.b .mc-ico{background:rgba(22,53,103,.09);color:#1d4785;}
.mc.y .mc-ico{background:rgba(201,168,76,.12);color:#c9a84c;}
.mc.r .mc-ico{background:rgba(232,69,60,.09);color:#e8453c;}
.mc-lbl{font-size:.68rem;font-weight:600;color:#4d8fd4;text-transform:uppercase;letter-spacing:.07em;margin-bottom:2px;}
.mc-val{font-family:'Barlow Condensed',sans-serif;font-size:1.9rem;font-weight:700;line-height:1;}
.mc.g .mc-val{color:#1ab3a6;} .mc.b .mc-val{color:#1d4785;} .mc.y .mc-val{color:#c9a84c;} .mc.r .mc-val{color:#e8453c;}

.mapa-wrap{flex:1;background:#fff;border:1px solid rgba(22,53,103,.1);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;min-height:400px;box-shadow:0 2px 8px rgba(0,0,0,.07);}
.mapa-top{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1.2rem;border-bottom:1px solid rgba(22,53,103,.08);flex-shrink:0;background:var(--ocean-900,#060f1e);}
.mapa-title{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.95rem;letter-spacing:.4px;text-transform:uppercase;display:flex;align-items:center;gap:.5rem;color:#fff;}
.live-dot{width:8px;height:8px;border-radius:50%;background:#1ab3a6;animation:pulse 2s ease-in-out infinite;}
@@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.35)}}
.leg{display:flex;gap:.9rem;align-items:center;}
.leg-i{display:flex;align-items:center;gap:.3rem;font-size:.72rem;color:rgba(255,255,255,.55);}
.leg-d{width:10px;height:10px;border-radius:2px;}

.mapa-body{flex:1;position:relative;background:#050d1a;background-image:linear-gradient(rgba(0,212,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.025) 1px,transparent 1px);background-size:40px 40px;overflow:hidden;cursor:default;}
.canvas-inner{position:absolute;width:2400px;height:1600px;transform-origin:0 0;}

/* Vagas */
.vaga-item{position:absolute;border-radius:6px;border:1.5px solid;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;cursor:pointer;user-select:none;transition:border-color .15s,box-shadow .15s,transform .1s;overflow:hidden;padding:3px;}
.vaga-item:hover{z-index:20;transform:scale(1.04);box-shadow:0 0 0 3px rgba(255,255,255,.12);}
.vaga-item.livre{background:rgba(26,179,166,.1);border-color:rgba(26,179,166,.45);}
.vaga-item.ocupada{background:rgba(22,53,103,.22);border-color:rgba(29,71,133,.55);}
.vaga-item.emmovimentacao{background:rgba(201,168,76,.15);border-color:rgba(201,168,76,.5);}
.vaga-item.manutencao{background:rgba(232,69,60,.12);border-color:rgba(232,69,60,.45);}
.vcod{font-family:'Barlow Condensed',sans-serif;font-size:.65rem;font-weight:700;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.7);letter-spacing:.5px;line-height:1;margin-bottom:2px;width:100%;text-align:center;}
.vaga-tipo{position:absolute;bottom:3px;right:4px;}
.vaga-tipo svg{width:9px;height:9px;opacity:.35;}

/* Container de barcos dentro da vaga */
.boat-container{position:absolute;inset:4px;pointer-events:none;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:3px;}
.boat-slot{position:relative;display:flex;align-items:center;justify-content:center;}
.boat-slot img{width:100%;height:100%;object-fit:contain;transition:transform .15s,opacity .15s;pointer-events:none;user-select:none;}

/* Manutencao overlay */
.vaga-item.manutencao .vaga-tipo-txt{font-size:.55rem;color:rgba(255,77,60,.7);text-align:center;padding:0 2px;margin-top:auto;}

/* Controles */
.ctrls{position:absolute;bottom:12px;left:12px;z-index:50;display:flex;gap:.35rem;flex-direction:column;}
.ctrls-row{display:flex;gap:.35rem;}
.cbtn{width:30px;height:30px;border-radius:7px;background:rgba(5,13,26,.85);border:1px solid rgba(0,200,255,.15);color:rgba(255,255,255,.7);cursor:pointer;font-size:.85rem;display:grid;place-items:center;backdrop-filter:blur(8px);transition:all .15s;}
.cbtn:hover{border-color:rgba(0,212,255,.4);color:#fff;}
.hint-txt{position:absolute;bottom:12px;right:14px;font-size:.68rem;color:rgba(255,255,255,.3);}

/* Painel de detalhes */
.det-panel{position:absolute;right:16px;top:50%;transform:translateY(-50%);width:230px;background:#071525;border:1px solid rgba(0,200,255,.12);border-radius:12px;padding:1.1rem;z-index:100;animation:slin .2s ease;box-shadow:0 8px 40px rgba(0,0,0,.6);}
@@keyframes slin{from{opacity:0;transform:translateY(-50%) translateX(14px)}to{opacity:1;transform:translateY(-50%) translateX(0)}}
.det-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;}
.det-cod{font-family:'Barlow Condensed',sans-serif;font-size:1.1rem;font-weight:700;color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.det-x{background:none;border:none;color:rgba(255,255,255,.35);cursor:pointer;font-size:1rem;line-height:1;padding:2px;transition:color .15s;}
.det-x:hover{color:#fff;}
.det-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.7rem;font-weight:700;padding:2px 9px;border-radius:20px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.7rem;}
.det-badge.livre{background:rgba(26,179,166,.15);color:#1ab3a6;}
.det-badge.ocupada{background:rgba(29,71,133,.2);color:#4d8fd4;}
.det-badge.emmovimentacao{background:rgba(201,168,76,.15);color:#c9a84c;}
.det-badge.manutencao{background:rgba(232,69,60,.12);color:#e8453c;}
.det-row{display:flex;justify-content:space-between;font-size:.78rem;padding:.28rem 0;border-bottom:1px solid rgba(255,255,255,.06);}
.det-row:last-of-type{border-bottom:none;}
.det-key{color:rgba(255,255,255,.4);}
.det-val{color:rgba(255,255,255,.8);text-align:right;}
.det-emb-lbl{font-size:.68rem;font-weight:600;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.08em;margin:.65rem 0 .35rem;}
.det-emb-tag{display:inline-block;background:rgba(0,212,255,.1);border:1px solid rgba(0,212,255,.2);color:#00d4ff;border-radius:4px;padding:2px 7px;font-size:.72rem;margin:.1rem .1rem;}
.det-link{display:block;margin-top:.8rem;text-align:center;background:rgba(26,179,166,.12);border:1px solid rgba(26,179,166,.25);color:#1ab3a6;border-radius:7px;padding:.4rem;font-size:.78rem;text-decoration:none;transition:background .2s;font-weight:600;letter-spacing:.3px;}
.det-link:hover{background:rgba(26,179,166,.22);}

.empty-mapa{display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:.5rem;color:rgba(255,255,255,.3);}
.empty-mapa svg{opacity:.2;}

/* Tipo de vaga (agua/seco) */
.tipo-agua svg{color:#4d8fd4;}
.tipo-seco svg{color:#c9a84c;}
</style>

<div class="dash">

  <div class="dash-header">
    <div>
      <div class="dash-title">Marina — Visao Geral</div>
      <div class="dash-sub">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</div>
    </div>
    <div class="dash-actions">
      <a href="/corredores" class="btn-dash outline">Corredores</a>
      <a href="/vagas" class="btn-dash outline">Listar Vagas</a>
      <a href="/vagas/layout" class="btn-dash teal">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
        Mapa Completo
      </a>
      <a href="/vagas/nova" class="btn-dash coral">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nova Vaga
      </a>
    </div>
  </div>

  <div class="metrics">
    <div class="mc g">
      <div class="mc-bar"></div>
      <div class="mc-ico">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </div>
      <div>
        <div class="mc-lbl">Vagas Livres</div>
        <div class="mc-val">@_livres</div>
      </div>
    </div>
    <div class="mc b">
      <div class="mc-bar"></div>
      <div class="mc-ico">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2"/><path d="M7 20c0-4.4 2.24-8 5-8s5 3.6 5 8"/><path d="M12 12V3"/></svg>
      </div>
      <div>
        <div class="mc-lbl">Ocupadas</div>
        <div class="mc-val">@_ocupadas</div>
      </div>
    </div>
    <div class="mc y">
      <div class="mc-bar"></div>
      <div class="mc-ico">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
      <div>
        <div class="mc-lbl">Em Movimentacao</div>
        <div class="mc-val">@_mov</div>
      </div>
    </div>
    <div class="mc r">
      <div class="mc-bar"></div>
      <div class="mc-ico">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      </div>
      <div>
        <div class="mc-lbl">Manutencao</div>
        <div class="mc-val">@_manut</div>
      </div>
    </div>
  </div>

  <div class="mapa-wrap">
    <div class="mapa-top">
      <div class="mapa-title">
        <div class="live-dot"></div>
        Mapa da Marina
      </div>
      <div class="leg">
        <div class="leg-i"><div class="leg-d" style="background:#1ab3a6"></div>Livre</div>
        <div class="leg-i"><div class="leg-d" style="background:#1d4785"></div>Ocupada</div>
        <div class="leg-i"><div class="leg-d" style="background:#c9a84c"></div>Movimentacao</div>
        <div class="leg-i"><div class="leg-d" style="background:#e8453c"></div>Manutencao</div>
      </div>
    </div>

    <div class="mapa-body" id="marina-canvas" @onclick="DeselecionarVaga">
      @if (_load)
      {
        <div class="empty-mapa">
          <div style="width:28px;height:28px;border:3px solid rgba(0,200,255,.15);border-top-color:#1ab3a6;border-radius:50%;animation:spin .7s linear infinite;"></div>
          <span style="font-size:.8rem">Carregando mapa...</span>
        </div>
      }
      else if (!_vagas.Any())
      {
        <div class="empty-mapa">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2"/><path d="M7 20c0-4.4 2.24-8 5-8s5 3.6 5 8"/><path d="M12 12V3"/></svg>
          <span>Nenhuma vaga cadastrada ainda.</span>
          <a href="/vagas/nova" class="btn-dash coral" style="margin-top:.5rem">+ Criar primeira vaga</a>
        </div>
      }
      else
      {
        <div class="canvas-inner" style="transform:translate(@(_px)px,@(_py)px) scale(@(_sc.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)))">
          @foreach (var v in _vagas)
          {
            var sc   = v.Status switch { StatusVaga.Livre=>"livre", StatusVaga.Ocupada=>"ocupada", StatusVaga.EmMovimentacao=>"emmovimentacao", StatusVaga.Manutencao=>"manutencao", _=>"livre" };
            var embs = v.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
            var embJson = System.Text.Json.JsonSerializer.Serialize(embs.Select(e => new {
              id   = e.EmbarcacaoId,
              nome = e.Embarcacao?.Nome ?? "",
              tipo = e.Embarcacao?.Tipo.ToString() ?? "Outro",
            }));
            <div class="vaga-item @sc"
                 data-vaga-id="@v.Id"
                 data-embarcacoes="@embJson"
                 style="left:@(v.PosX)px;top:@(v.PosY)px;width:@(v.Largura)px;height:@(v.Altura)px;"
                 @onclick="()=>Sel(v)"
                 @onclick:stopPropagation="true">
              <div class="vcod">@v.Codigo</div>
              @if (v.Status == StatusVaga.Manutencao)
              {
                <span class="vaga-tipo-txt">Manut.</span>
              }
              <div class="vaga-tipo @(v.Tipo==TipoVaga.Agua?"tipo-agua":"tipo-seco")">
                @if (v.Tipo == TipoVaga.Agua)
                {
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12c1.5-2 3-3 6-3s4.5 1 6 3 3 3 6 3"/></svg>
                }
                else
                {
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                }
              </div>
            </div>
          }
        </div>

        <div class="ctrls">
          <div class="ctrls-row">
            <button class="cbtn" @onclick="ZIn" title="Zoom +">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <button class="cbtn" @onclick="ZOut" title="Zoom -">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <button class="cbtn" @onclick="ZReset" title="Centralizar">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
            </button>
          </div>
        </div>
        <div class="hint-txt">Scroll para zoom · Arrastar para mover</div>
      }

      @if (_sel != null)
      {
        var sc2 = _sel.Status switch { StatusVaga.Livre=>"livre", StatusVaga.Ocupada=>"ocupada", StatusVaga.EmMovimentacao=>"emmovimentacao", StatusVaga.Manutencao=>"manutencao", _=>"livre" };
        var lb  = _sel.Status switch { StatusVaga.Livre=>"Livre", StatusVaga.Ocupada=>"Ocupada", StatusVaga.EmMovimentacao=>"Em Movimentacao", StatusVaga.Manutencao=>"Manutencao", _=>"" };
        <div class="det-panel" @onclick:stopPropagation="true">
          <div class="det-top">
            <div class="det-cod">Vaga @_sel.Codigo</div>
            <button class="det-x" @onclick="()=>_sel=null">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <span class="det-badge @sc2">@lb</span>
          <div class="det-row"><span class="det-key">Tipo</span><span class="det-val">@(_sel.Tipo==TipoVaga.Agua?"Molhada":"Seca")</span></div>
          <div class="det-row"><span class="det-key">Corredor</span><span class="det-val">@(_sel.Corredor?.Nome??"--")</span></div>
          <div class="det-row"><span class="det-key">Tamanho</span><span class="det-val">@_sel.TamanhoMaxPes pes</span></div>
          <div class="det-row"><span class="det-key">Dimensoes</span><span class="det-val">@_sel.Largura x @_sel.Altura px</span></div>
          <div class="det-emb-lbl">Embarcacoes</div>
          @if (!_sel.EmbarcacoesNaVaga.Any(e=>e.Ativa))
          { <span style="font-size:.78rem;color:rgba(255,255,255,.35)">Nenhuma alocada</span> }
          else
          { @foreach(var ve in _sel.EmbarcacoesNaVaga.Where(e=>e.Ativa)) { <span class="det-emb-tag">@ve.Embarcacao?.Nome</span> } }
          <a href="/vagas/@_sel.Id" class="det-link">Editar vaga</a>
        </div>
      }
    </div>
  </div>
</div>

@code {
    private List<Vaga> _vagas = new();
    private bool _load = true;
    private Vaga? _sel;
    private int _livres, _ocupadas, _mov, _manut;
    private double _px, _py, _sc = 1;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _vagas    = await VagaService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _livres   = _vagas.Count(v => v.Status == StatusVaga.Livre);
        _ocupadas = _vagas.Count(v => v.Status == StatusVaga.Ocupada);
        _mov      = _vagas.Count(v => v.Status == StatusVaga.EmMovimentacao);
        _manut    = _vagas.Count(v => v.Status == StatusVaga.Manutencao);
        _load     = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _load) return;
        // Inicia o JS do mapa apos render — sem DotNetRef por enquanto
        await JS.InvokeVoidAsync("layoutMarina.init", null, "marina-canvas").AsTask()
               .ContinueWith(_ => { });
    }

    private void Sel(Vaga v) => _sel = _sel?.Id == v.Id ? null : v;
    private void DeselecionarVaga() => _sel = null;
    private void ZIn()    => _sc = Math.Min(3, _sc + .15);
    private void ZOut()   => _sc = Math.Max(.25, _sc - .15);
    private void ZReset() => (_sc, _px, _py) = (1, 0, 0);
}
