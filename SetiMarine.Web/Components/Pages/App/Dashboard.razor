@page "/dashboard"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject VagaService VagaService
@inject MovimentacaoService MovService
@inject OrdemServicoService OSService
@inject PedidoService PedidoSvc
@inject UsuarioContextService UserCtx

<PageTitle>Dashboard — SetiMarine</PageTitle>

<style>
.dash { display:flex;flex-direction:column;gap:1.25rem; }
.dash-header { display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.8rem;margin-bottom:.25rem; }
.dash-title { font-size:1.35rem;font-weight:700;letter-spacing:-.01em;color:var(--ink-900); }
.dash-sub   { font-size:.78rem;color:var(--ink-400);margin-top:3px;text-transform:capitalize; }

/* Métricas */
.metrics { display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem; }
.metrics-2 { display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem; }
@@media(max-width:1100px){ .metrics{ grid-template-columns:repeat(3,1fr); } .metrics-2{ grid-template-columns:repeat(3,1fr); } }
@@media(max-width:700px)  { .metrics{ grid-template-columns:repeat(2,1fr); } .metrics-2{ grid-template-columns:repeat(2,1fr); } }
.mc { background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:.85rem 1rem;
      display:flex;align-items:center;gap:.85rem;position:relative;overflow:hidden;
      transition:box-shadow .18s,transform .18s; }
.mc:hover { box-shadow:0 4px 14px rgba(0,0,0,.08);transform:translateY(-2px); }
.mc-bar { position:absolute;top:0;left:0;right:0;height:3px; }
.mc.g .mc-bar{background:var(--s-free);}   .mc.b .mc-bar{background:var(--navy-700);}
.mc.y .mc-bar{background:#c9a84c;}          .mc.r .mc-bar{background:var(--s-maint);}
.mc.tl .mc-bar{background:#1ab3a6;}         .mc.p .mc-bar{background:#7c5cbf;}
.mc.or .mc-bar{background:#d07c2e;}         .mc.sl .mc-bar{background:#3a7fd5;}
.mc-ico { width:36px;height:36px;border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.mc.g  .mc-ico{background:rgba(74,138,92,.1);  color:var(--s-free);}
.mc.b  .mc-ico{background:rgba(36,53,149,.08); color:var(--navy-700);}
.mc.y  .mc-ico{background:rgba(201,168,76,.12);color:#9a7420;}
.mc.r  .mc-ico{background:rgba(164,68,54,.09); color:var(--s-maint);}
.mc.tl .mc-ico{background:rgba(26,179,166,.1); color:#1ab3a6;}
.mc.p  .mc-ico{background:rgba(124,92,191,.1); color:#7c5cbf;}
.mc.or .mc-ico{background:rgba(208,124,46,.1); color:#d07c2e;}
.mc.sl .mc-ico{background:rgba(58,127,213,.1); color:#3a7fd5;}
.mc-lbl { font-size:.62rem;font-weight:600;color:var(--ink-400);text-transform:uppercase;letter-spacing:.1em;margin-bottom:2px; }
.mc-val { font-size:1.8rem;font-weight:700;line-height:1; }
.mc.g .mc-val{color:var(--s-free);}  .mc.b .mc-val{color:var(--navy-700);}
.mc.y .mc-val{color:#9a7420;}         .mc.r .mc-val{color:var(--s-maint);}
.mc.tl .mc-val{color:#1ab3a6;}        .mc.p .mc-val{color:#7c5cbf;}
.mc.or .mc-val{color:#d07c2e;}         .mc.sl .mc-val{color:#3a7fd5;}

/* Linha inferior */
.dash-bottom { display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem; }
@@media(max-width:1100px){ .dash-bottom{ grid-template-columns:1fr 1fr; } }
@@media(max-width:700px)  { .dash-bottom{ grid-template-columns:1fr; } }
.dash-panel { background:var(--paper);border:1px solid var(--line);border-radius:4px; }
.dash-panel-head { display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border-bottom:1px solid var(--line); }
.dash-panel-title { font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-600); }
.dash-panel-body { padding:.75rem 1rem; }

/* Passeio */
.passeio-item { display:flex;align-items:center;gap:.75rem;padding:.5rem 0;border-bottom:1px solid var(--line); }
.passeio-item:last-child { border-bottom:none; }
.passeio-dot { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
.passeio-info { flex:1;min-width:0; }
.passeio-nome { font-size:.82rem;font-weight:500;color:var(--ink-900);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.passeio-sub  { font-size:.68rem;color:var(--ink-400); }
.passeio-badge{ font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.15rem .45rem;border-radius:20px; }

/* OS Pendentes */
.os-item { display:flex;align-items:center;gap:.75rem;padding:.5rem 0;border-bottom:1px solid var(--line);text-decoration:none; }
.os-item:last-child { border-bottom:none; }
.os-item:hover .os-tipo { color:var(--navy-700); }
.os-num  { font-size:.72rem;color:var(--ink-300);font-family:monospace;flex-shrink:0; }
.os-info { flex:1;min-width:0; }
.os-tipo { font-size:.82rem;font-weight:500;color:var(--ink-900);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.os-sub  { font-size:.68rem;color:var(--ink-400); }

/* Pedidos recentes */
.ped-item { display:flex;align-items:center;gap:.75rem;padding:.5rem 0;border-bottom:1px solid var(--line);text-decoration:none; }
.ped-item:last-child { border-bottom:none; }
.ped-item:hover .ped-desc { color:var(--navy-700); }
.ped-info { flex:1;min-width:0; }
.ped-desc { font-size:.82rem;font-weight:500;color:var(--ink-900);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.ped-sub  { font-size:.68rem;color:var(--ink-400); }
.ped-val  { font-size:.82rem;font-weight:600;color:var(--ink-700);white-space:nowrap; }
</style>

<div class="dash">

    <div class="dash-header">
        <div>
            <div class="dash-title">Visão Geral</div>
            <div class="dash-sub">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</div>
        </div>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
            <a href="/vagas/layout" class="btn btn-ghost btn-sm">Mapa da Marina</a>
            <a href="/movimentacoes/nova" class="btn btn-ghost btn-sm">+ Movimentação</a>
            <a href="/pedidos/novo" class="btn btn-ghost btn-sm">+ Pedido</a>
            <a href="/servicos/nova" class="btn btn-primary btn-sm">+ Ordem de Serviço</a>
        </div>
    </div>

    @if (_load)
    {
        <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
            <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
            <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
        </div>
    }
    else
    {
        <!-- Vagas -->
        <div class="metrics">
            <div class="mc g">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
                <div><div class="mc-lbl">Vagas Livres</div><div class="mc-val">@_livres</div></div>
            </div>
            <div class="mc b">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2"/><path d="M7 20c0-4.4 2.24-8 5-8s5 3.6 5 8"/><path d="M12 12V3"/></svg></div>
                <div><div class="mc-lbl">Ocupadas</div><div class="mc-val">@_ocupadas</div></div>
            </div>
            <div class="mc y">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
                <div><div class="mc-lbl">Movimentação</div><div class="mc-val">@_emMov</div></div>
            </div>
            <div class="mc r">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
                <div><div class="mc-lbl">Manutenção</div><div class="mc-val">@_manut</div></div>
            </div>
            <div class="mc tl">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 4-6 4 10"/><path d="M3 21h18"/></svg></div>
                <div><div class="mc-lbl">Em Passeio</div><div class="mc-val">@_passeio.Count</div></div>
            </div>
        </div>

        <!-- Pedidos e OS -->
        <div class="metrics-2">
            <div class="mc p">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg></div>
                <div>
                    <div class="mc-lbl">Pedidos Abertos</div>
                    <div class="mc-val">@_pedidosAbertos</div>
                </div>
            </div>
            <div class="mc or">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                <div>
                    <div class="mc-lbl">Em Andamento</div>
                    <div class="mc-val">@_pedidosAndamento</div>
                </div>
            </div>
            <div class="mc sl">
                <div class="mc-bar"></div>
                <div class="mc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
                <div>
                    <div class="mc-lbl">OS Abertas</div>
                    <div class="mc-val">@_osAbertas.Count</div>
                </div>
            </div>
        </div>

        <!-- Painéis -->
        <div class="dash-bottom">

            <!-- Em Passeio -->
            <div class="dash-panel">
                <div class="dash-panel-head">
                    <span class="dash-panel-title">Em Passeio agora</span>
                    <a href="/movimentacoes" style="font-size:.72rem;color:var(--ink-400);text-decoration:none;">ver todas →</a>
                </div>
                <div class="dash-panel-body">
                    @if (!_passeio.Any())
                    {
                        <div style="font-size:.75rem;color:var(--ink-300);padding:.5rem 0;">Nenhuma embarcação fora da marina.</div>
                    }
                    else
                    {
                        @foreach (var m in _passeio)
                        {
                            var (dotCor, stLabel, bgCor) = m.Status switch
                            {
                                StatusMovimentacao.Descendo   => ("#9a7420",       "Descendo",   "rgba(184,138,46,.1)"),
                                StatusMovimentacao.NaAgua     => ("var(--s-free)", "Na água",    "rgba(74,138,92,.1)"),
                                StatusMovimentacao.Retornando => ("#9a7420",       "Retornando", "rgba(184,138,46,.1)"),
                                _                             => ("var(--ink-300)","—",          "transparent"),
                            };
                            <div class="passeio-item">
                                <div class="passeio-dot" style="background:@dotCor;"></div>
                                <div class="passeio-info">
                                    <div class="passeio-nome">@(m.Embarcacao?.Nome ?? "—")</div>
                                    <div class="passeio-sub">@(m.Embarcacao?.Cliente?.Nome ?? "—")</div>
                                </div>
                                <span class="passeio-badge" style="background:@bgCor;color:@dotCor;">@stLabel</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- OS Pendentes / Em Execução -->
            <div class="dash-panel">
                <div class="dash-panel-head">
                    <span class="dash-panel-title">Ordens de serviço abertas</span>
                    <a href="/servicos" style="font-size:.72rem;color:var(--ink-400);text-decoration:none;">ver todas →</a>
                </div>
                <div class="dash-panel-body">
                    @if (!_osAbertas.Any())
                    {
                        <div style="font-size:.75rem;color:var(--ink-300);padding:.5rem 0;">Nenhuma OS em aberto.</div>
                    }
                    else
                    {
                        @foreach (var o in _osAbertas.Take(8))
                        {
                            var cor = o.Status == StatusOS.EmExecucao ? "#9a7420" : "var(--ink-400)";
                            <a href="/servicos/@o.Id" class="os-item">
                                <span class="os-num">#@o.Id</span>
                                <div class="os-info">
                                    <div class="os-tipo">@o.TipoServico</div>
                                    <div class="os-sub">@(o.Embarcacao?.Nome ?? "—") · @(o.Responsavel?.Nome ?? "Não atribuído")</div>
                                </div>
                                <span style="font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:@cor;white-space:nowrap;">
                                    @(o.Status == StatusOS.EmExecucao ? "Em execução" : "Pendente")
                                </span>
                            </a>
                        }
                    }
                </div>
            </div>

            <!-- Pedidos recentes -->
            <div class="dash-panel">
                <div class="dash-panel-head">
                    <span class="dash-panel-title">Pedidos recentes</span>
                    <a href="/pedidos" style="font-size:.72rem;color:var(--ink-400);text-decoration:none;">ver todos →</a>
                </div>
                <div class="dash-panel-body">
                    @if (!_pedidosRecentes.Any())
                    {
                        <div style="font-size:.75rem;color:var(--ink-300);padding:.5rem 0;">Nenhum pedido encontrado.</div>
                    }
                    else
                    {
                        @foreach (var p in _pedidosRecentes)
                        {
                            var (statusCor, statusLabel) = p.Status switch
                            {
                                StatusPedido.Aberto      => ("#3a7fd5", "Aberto"),
                                StatusPedido.EmAndamento => ("#d07c2e", "Andamento"),
                                StatusPedido.Concluido   => ("var(--s-free)", "Concluído"),
                                StatusPedido.Cancelado   => ("var(--s-maint)", "Cancelado"),
                                _                        => ("var(--ink-400)", "Rascunho"),
                            };
                            var tipoCor = p.Tipo switch
                            {
                                TipoPedido.OrdemServico => "#7c5cbf",
                                TipoPedido.Emprestimo   => "#1ab3a6",
                                _                       => "var(--ink-400)",
                            };
                            var tipoLabel = p.Tipo switch
                            {
                                TipoPedido.OrdemServico => "OS",
                                TipoPedido.Emprestimo   => "Emp.",
                                _                       => "Venda",
                            };
                            var total = p.Itens.Sum(i => i.ValorTotal) + p.Servicos.Sum(s => s.Valor ?? 0);
                            <a href="/pedidos/@p.Id" class="ped-item">
                                <div style="display:flex;flex-direction:column;align-items:center;gap:2px;flex-shrink:0;">
                                    <span style="font-size:.55rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:@tipoCor;background:rgba(0,0,0,.04);padding:.1rem .3rem;border-radius:3px;">@tipoLabel</span>
                                    <span style="font-size:.58rem;color:var(--ink-300);font-family:monospace;">#@p.Id</span>
                                </div>
                                <div class="ped-info">
                                    <div class="ped-desc">@(p.Cliente?.Nome ?? p.Embarcacao?.Nome ?? "—")</div>
                                    <div class="ped-sub">@p.CriadoEm.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                </div>
                                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;">
                                    <span class="ped-val">R$ @total.ToString("N2")</span>
                                    <span style="font-size:.58rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:@statusCor;">@statusLabel</span>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>

        </div>
    }

</div>

@code {
    private bool _load = true;
    private int  _livres, _ocupadas, _emMov, _manut;
    private int  _pedidosAbertos, _pedidosAndamento;
    private List<Movimentacao>  _passeio         = new();
    private List<OrdemServico>  _osAbertas        = new();
    private List<Pedido>        _pedidosRecentes  = new();

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();

        var vagas  = await VagaService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _livres    = vagas.Count(v => v.Status == StatusVaga.Livre);
        _ocupadas  = vagas.Count(v => v.Status == StatusVaga.Ocupada);
        _emMov     = vagas.Count(v => v.Status == StatusVaga.EmMovimentacao);
        _manut     = vagas.Count(v => v.Status == StatusVaga.Manutencao);

        var movs   = await MovService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _passeio   = movs.Where(m =>
            m.Status == StatusMovimentacao.Descendo  ||
            m.Status == StatusMovimentacao.NaAgua    ||
            m.Status == StatusMovimentacao.Retornando).ToList();

        var todasOS = await OSService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _osAbertas  = todasOS.Where(o => o.Status != StatusOS.Finalizado)
                              .OrderBy(o => o.Status)
                              .ToList();

        var pedidos       = await PedidoSvc.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _pedidosAbertos   = pedidos.Count(p => p.Status == StatusPedido.Aberto);
        _pedidosAndamento = pedidos.Count(p => p.Status == StatusPedido.EmAndamento);
        _pedidosRecentes  = pedidos
            .Where(p => p.Status != StatusPedido.Cancelado)
            .Take(6)
            .ToList();

        _load = false;
    }
}
