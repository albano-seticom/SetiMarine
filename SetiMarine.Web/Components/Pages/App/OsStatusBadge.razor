@using SetiMarine.Domain.Enums

@switch (Status)
{
    case StatusOS.Pendente:
        <span class="badge" style="background:rgba(120,120,120,.1);color:var(--ink-500);">Pendente</span>
        break;
    case StatusOS.EmExecucao:
        <span class="badge badge-mov">Em Execução</span>
        break;
    case StatusOS.Finalizado:
        <span class="badge badge-free">Finalizado</span>
        break;
}

@code {
    [Parameter, EditorRequired] public StatusOS Status { get; set; }
}
