@page "/vagas/layout"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject VagaService VagaService
@inject CorredorService CorredorService
@inject SecaoService SecaoSvc
@inject AlocacaoService AlocacaoService
@inject MovimentacaoService MovService
@inject UsuarioContextService UserCtx

<PageTitle>Mapa da Marina — SetiMarine</PageTitle>

<style>
@@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.4)}}
.live-dot { width:7px;height:7px;border-radius:50%;background:#1ab3a6;animation:pulse 2s ease-in-out infinite;flex-shrink:0; }

/* ── Painel por tipo (Molhada / Seca) ──────────────── */
.tipo-panel    { margin-bottom:1.75rem;border-radius:10px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.14); }
.tipo-hd       { display:flex;justify-content:space-between;align-items:center;
                 padding:.85rem 1.25rem;cursor:pointer;user-select:none; }
.tipo-mol-hd   { background:linear-gradient(135deg,#061925,#0a2235);border:1px solid rgba(26,179,166,.22); }
.tipo-sec-hd   { background:linear-gradient(135deg,#1a1200,#231b00);border:1px solid rgba(201,168,76,.22); }
.tipo-hd-left  { display:flex;align-items:center;gap:.65rem; }
.tipo-titulo   { font-size:.86rem;font-weight:800;letter-spacing:.45px;text-transform:uppercase; }
.tipo-mol-txt  { color:#1ab3a6; }
.tipo-sec-txt  { color:#c9a84c; }
.tipo-hd-count { font-size:.67rem;color:rgba(255,255,255,.28);font-weight:400; }
.tipo-body     { border:1px solid rgba(0,212,255,.07);border-top:none;
                 background:#040b18;padding:1.1rem 1.1rem .6rem; }
.tipo-sec-bdy  { border-color:rgba(201,168,76,.08); }
.tipo-chevron  { color:rgba(255,255,255,.28);transition:transform .22s;display:flex;align-items:center; }
.tipo-chevron.aberto { transform:rotate(180deg); }
.tipo-hd-actions { display:flex;align-items:center;gap:.6rem; }

/* ── Seção block ────────────────────────────────────── */
.secao-blk     { margin-bottom:1rem;border:1px solid rgba(255,255,255,.06);border-radius:7px;overflow:hidden; }
.secao-hd      { display:flex;justify-content:space-between;align-items:center;padding:.55rem 1rem;background:#060f1e; }
.secao-hd-left { display:flex;align-items:center;gap:.5rem; }
.secao-hd-nome { font-size:.72rem;font-weight:700;letter-spacing:.2px;text-transform:uppercase;color:rgba(255,255,255,.7); }
.secao-count   { font-size:.62rem;color:rgba(255,255,255,.25); }
.btn-cor-add   { background:none;border:1px dashed rgba(255,255,255,.14);color:rgba(255,255,255,.3);
                 border-radius:4px;padding:.25rem .65rem;font-size:.67rem;cursor:pointer;
                 display:flex;align-items:center;gap:.3rem;transition:all .15s; }
.btn-cor-add:hover { border-color:rgba(26,179,166,.45);color:#1ab3a6; }

/* ── Corpo e grid ───────────────────────────────────── */
.mapa-body  { background:#050d1a;
    background-image:linear-gradient(rgba(0,212,255,.02) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(0,212,255,.02) 1px,transparent 1px);
    background-size:40px 40px; }
.empty-mapa { display:flex;align-items:center;justify-content:center;min-height:90px;
              flex-direction:column;gap:.4rem;color:rgba(255,255,255,.28); }
.mapa-grid   { padding:1rem 1.4rem 1.3rem;overflow-x:auto; }
.corredor-hd { font-size:.61rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;
               color:rgba(0,212,255,.38);margin-bottom:.5rem;margin-top:1.1rem;padding-left:50px; }
.corredor-hd:first-child { margin-top:0; }
.vaga-row    { display:flex;align-items:center;gap:6px;margin-bottom:6px;flex-wrap:nowrap; }
.vaga-lbl    { width:42px;min-width:42px;text-align:right;font-size:.67rem;font-weight:600;
               color:rgba(255,255,255,.28);flex-shrink:0;padding-right:6px;
               border-right:1px solid rgba(0,200,255,.09);
               white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }

/* ── Célula de vaga ─────────────────────────────────── */
.vs { width:64px;height:52px;border-radius:6px;border:1.5px solid;
      display:grid;place-items:center;flex-shrink:0;cursor:pointer;user-select:none;
      position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s; }
.vs:hover { transform:scale(1.07);z-index:2;box-shadow:0 0 0 3px rgba(255,255,255,.1); }
.vs.sel   { z-index:3;box-shadow:0 0 0 3px rgba(255,255,255,.38) !important; }
.vs.livre        { background:rgba(26,179,166,.1);  border-color:rgba(26,179,166,.4); }
.vs.ocupada      { background:rgba(22,53,103,.22);  border-color:rgba(29,71,133,.5); }
.vs.movimentacao { background:rgba(201,168,76,.15); border-color:rgba(201,168,76,.5); }
.vs.manutencao   { background:rgba(232,69,60,.12);  border-color:rgba(232,69,60,.45); }
.vs.sel.livre        { border-color:#1ab3a6; }
.vs.sel.ocupada      { border-color:#4d8fd4; }
.vs.sel.movimentacao { border-color:#c9a84c; }
.vs.sel.manutencao   { border-color:#e8453c; }
.vs-cod  { font-size:.62rem;font-weight:700;color:rgba(255,255,255,.75);letter-spacing:.4px;text-align:center; }
.vs-emb  { width:38px;height:38px;object-fit:contain;opacity:.78;pointer-events:none; }
.vs-cnt  { position:absolute;top:3px;right:4px;min-width:14px;height:14px;border-radius:7px;
           background:#1ab3a6;color:#060f1e;font-size:.52rem;font-weight:800;
           display:flex;align-items:center;justify-content:center;padding:0 3px; }

/* botão "+" ao final da linha de vagas */
.vs-add { width:64px;height:52px;border-radius:6px;border:1.5px dashed rgba(255,255,255,.14);
          background:none;display:grid;place-items:center;flex-shrink:0;cursor:pointer;
          color:rgba(255,255,255,.22);transition:border-color .15s,color .15s,background .15s; }
.vs-add:hover { border-color:rgba(26,179,166,.5);color:#1ab3a6;background:rgba(26,179,166,.05); }

/* ── Modal detalhe ──────────────────────────────────── */
.emb-row      { display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;
                background:var(--surface,rgba(0,0,0,.03));border:1px solid var(--line);
                border-radius:4px;margin-bottom:.4rem; }
.emb-row-nome { flex:1;font-size:.83rem;font-weight:500;color:var(--ink-900); }
.emb-row-cli  { font-size:.72rem;color:var(--ink-400); }
.emb-row-rm   { background:none;border:none;cursor:pointer;color:var(--ink-300);
                padding:3px;border-radius:3px;display:flex;align-items:center;transition:color .15s; }
.emb-row-rm:hover { color:var(--s-maint); }
.modal-sec    { font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
                color:var(--ink-400);margin:1.1rem 0 .55rem; }
</style>

<div class="page-head">
    <div>
        <span class="eyebrow">Operações</span>
        <h1>Mapa da Marina</h1>
    </div>
    <div class="page-head-actions">
        <a href="/vagas" class="btn btn-ghost btn-sm">Lista de Vagas</a>
    </div>
</div>

@if (_load)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando mapa...</span>
    </div>
}
else
{

<!-- ═══ PAINEL MOLHADAS ═══ -->
<div class="tipo-panel">
    <div class="tipo-hd tipo-mol-hd" @onclick="() => _abreMol = !_abreMol">
        <div class="tipo-hd-left">
            <div class="live-dot"></div>
            <span class="tipo-titulo tipo-mol-txt">Vagas Molhadas</span>
            <span class="tipo-hd-count">@_secoesMol.Count seção@(_secoesMol.Count != 1 ? "ões" : "") · @_todasVagas.Count(v => v.Tipo == TipoVaga.Agua) vagas</span>
        </div>
        <div class="tipo-hd-actions" @onclick:stopPropagation="true">
            <button class="btn-cor-add" @onclick="() => AbrirModalNovaSecao(TipoVaga.Agua)">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Seção
            </button>
            <div class="tipo-chevron @(_abreMol ? "aberto" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
        </div>
    </div>

    @if (_abreMol)
    {
        <div class="tipo-body" @onclick="Deselecionar">
            @if (!_secoesMol.Any())
            {
                <div class="empty-mapa">
                    <span style="font-size:.76rem;">Nenhuma seção molhada.</span>
                    <button class="btn-cor-add" style="margin-top:.4rem;" @onclick="() => AbrirModalNovaSecao(TipoVaga.Agua)" @onclick:stopPropagation="true">
                        + Criar seção molhada
                    </button>
                </div>
            }
            else
            {
                @foreach (var sec in _secoesMol.OrderBy(s => s.Ordem).ThenBy(s => s.Nome))
                {
                    var cors       = _corredores.Where(c => c.SecaoId == sec.Id).OrderBy(c => c.Ordem).ThenBy(c => c.Nome).ToList();
                    var totalVagas = cors.Sum(c => _todasVagas.Count(v => v.CorredorId == c.Id));
                    <div class="secao-blk">
                        <div class="secao-hd">
                            <div class="secao-hd-left">
                                <span class="secao-hd-nome">@sec.Nome</span>
                                <span class="secao-count">@totalVagas vaga@(totalVagas != 1 ? "s" : "")</span>
                            </div>
                            <button class="btn-cor-add" @onclick="() => AbrirModalNovoCorredor(sec.Id)" @onclick:stopPropagation="true">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Corredor
                            </button>
                        </div>
                        <div class="mapa-body">
                            @if (!cors.Any())
                            {
                                <div class="empty-mapa" style="min-height:70px;">
                                    <span style="font-size:.73rem;">Clique em "+ Corredor" para criar.</span>
                                </div>
                            }
                            else
                            {
                                <div class="mapa-grid">
                                    @foreach (var cor in cors)
                                    {
                                        var vagas = _todasVagas.Where(v => v.CorredorId == cor.Id).OrderBy(v => v.Codigo).ToList();
                                        <div class="corredor-hd">@cor.Nome</div>
                                        <div class="vaga-row">
                                            <span class="vaga-lbl">@ShortLabel(cor.Nome)</span>
                                            @foreach (var v in vagas)
                                            {
                                                var css   = StatusCss(v.Status);
                                                var embs  = v.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
                                                var first = embs.FirstOrDefault();
                                                var isSel = _sel?.Id == v.Id;
                                                <div class="vs @css @(isSel ? "sel" : "")"
                                                     @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true"
                                                     title="@(v.Codigo + (first?.Embarcacao != null ? " · " + first.Embarcacao.Nome : ""))">
                                                    @if (first?.Embarcacao != null)
                                                    { <img src="/images/boats/top/@SvgForTipo(first.Embarcacao.Tipo)" alt="@first.Embarcacao.Nome" class="vs-emb" /> }
                                                    else
                                                    { <span class="vs-cod">@v.Codigo</span> }
                                                    @if (embs.Count > 1) { <span class="vs-cnt">@embs.Count</span> }
                                                </div>
                                            }
                                            <button class="vs-add" title="Nova vaga molhada"
                                                    @onclick="() => AbrirModalNova(TipoVaga.Agua, cor.Id)" @onclick:stopPropagation="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<!-- ═══ PAINEL SECAS ═══ -->
<div class="tipo-panel">
    <div class="tipo-hd tipo-sec-hd" @onclick="() => _abreSec = !_abreSec">
        <div class="tipo-hd-left">
            <div class="live-dot" style="background:#c9a84c;"></div>
            <span class="tipo-titulo tipo-sec-txt">Vagas Secas</span>
            <span class="tipo-hd-count">@_secoesSec.Count seção@(_secoesSec.Count != 1 ? "ões" : "") · @_todasVagas.Count(v => v.Tipo == TipoVaga.Seco) vagas</span>
        </div>
        <div class="tipo-hd-actions" @onclick:stopPropagation="true">
            <button class="btn-cor-add" style="border-color:rgba(201,168,76,.2);color:rgba(201,168,76,.5);"
                    @onclick="() => AbrirModalNovaSecao(TipoVaga.Seco)">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Seção
            </button>
            <div class="tipo-chevron @(_abreSec ? "aberto" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
        </div>
    </div>

    @if (_abreSec)
    {
        <div class="tipo-body tipo-sec-bdy" @onclick="Deselecionar">
            @if (!_secoesSec.Any())
            {
                <div class="empty-mapa">
                    <span style="font-size:.76rem;">Nenhuma seção seca.</span>
                    <button class="btn-cor-add" style="margin-top:.4rem;border-color:rgba(201,168,76,.25);color:rgba(201,168,76,.5);"
                            @onclick="() => AbrirModalNovaSecao(TipoVaga.Seco)" @onclick:stopPropagation="true">
                        + Criar seção seca
                    </button>
                </div>
            }
            else
            {
                @foreach (var sec in _secoesSec.OrderBy(s => s.Ordem).ThenBy(s => s.Nome))
                {
                    var cors       = _corredores.Where(c => c.SecaoId == sec.Id).OrderBy(c => c.Ordem).ThenBy(c => c.Nome).ToList();
                    var totalVagas = cors.Sum(c => _todasVagas.Count(v => v.CorredorId == c.Id));
                    <div class="secao-blk" style="border-color:rgba(201,168,76,.1);">
                        <div class="secao-hd" style="background:#120f00;">
                            <div class="secao-hd-left">
                                <span class="secao-hd-nome">@sec.Nome</span>
                                <span class="secao-count">@totalVagas vaga@(totalVagas != 1 ? "s" : "")</span>
                            </div>
                            <button class="btn-cor-add" style="border-color:rgba(201,168,76,.2);color:rgba(201,168,76,.4);"
                                    @onclick="() => AbrirModalNovoCorredor(sec.Id)" @onclick:stopPropagation="true">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Corredor
                            </button>
                        </div>
                        <div class="mapa-body">
                            @if (!cors.Any())
                            {
                                <div class="empty-mapa" style="min-height:70px;">
                                    <span style="font-size:.73rem;">Clique em "+ Corredor" para criar.</span>
                                </div>
                            }
                            else
                            {
                                <div class="mapa-grid">
                                    @foreach (var cor in cors)
                                    {
                                        var vagas = _todasVagas.Where(v => v.CorredorId == cor.Id).OrderBy(v => v.Codigo).ToList();
                                        <div class="corredor-hd" style="color:rgba(201,168,76,.4);">@cor.Nome</div>
                                        <div class="vaga-row">
                                            <span class="vaga-lbl">@ShortLabel(cor.Nome)</span>
                                            @foreach (var v in vagas)
                                            {
                                                var css   = StatusCss(v.Status);
                                                var embs  = v.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
                                                var first = embs.FirstOrDefault();
                                                var isSel = _sel?.Id == v.Id;
                                                <div class="vs @css @(isSel ? "sel" : "")"
                                                     @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true"
                                                     title="@(v.Codigo + (first?.Embarcacao != null ? " · " + first.Embarcacao.Nome : ""))">
                                                    @if (first?.Embarcacao != null)
                                                    { <img src="/images/boats/top/@SvgForTipo(first.Embarcacao.Tipo)" alt="@first.Embarcacao.Nome" class="vs-emb" /> }
                                                    else
                                                    { <span class="vs-cod">@v.Codigo</span> }
                                                    @if (embs.Count > 1) { <span class="vs-cnt">@embs.Count</span> }
                                                </div>
                                            }
                                            <button class="vs-add" title="Nova vaga seca"
                                                    @onclick="() => AbrirModalNova(TipoVaga.Seco, cor.Id)" @onclick:stopPropagation="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<!-- Corredores/seções sem tipo (compatibilidade) -->
@if (_corredores.Any(c => c.SecaoId == null) || _secoes.Any(s => s.TipoPreferencial == null))
{
    <div class="tipo-panel" style="opacity:.7;">
        <div class="tipo-hd" style="background:#0c0c0c;border:1px solid rgba(255,255,255,.08);cursor:default;">
            <div class="tipo-hd-left">
                <span class="tipo-titulo" style="color:rgba(255,255,255,.35);font-size:.76rem;">Sem classificação</span>
            </div>
        </div>
        <div class="tipo-body" style="border-color:rgba(255,255,255,.05);" @onclick="Deselecionar">
            @foreach (var sec in _secoes.Where(s => s.TipoPreferencial == null).OrderBy(s => s.Nome))
            {
                var cors = _corredores.Where(c => c.SecaoId == sec.Id).OrderBy(c => c.Nome).ToList();
                <div class="secao-blk">
                    <div class="secao-hd">
                        <div class="secao-hd-left">
                            <span class="secao-hd-nome">@sec.Nome</span>
                        </div>
                        <button class="btn-cor-add" @onclick="() => AbrirModalNovoCorredor(sec.Id)" @onclick:stopPropagation="true">+ Corredor</button>
                    </div>
                    <div class="mapa-body">
                        <div class="mapa-grid">
                            @foreach (var cor in cors)
                            {
                                var vagas = _todasVagas.Where(v => v.CorredorId == cor.Id).OrderBy(v => v.Codigo).ToList();
                                <div class="corredor-hd">@cor.Nome</div>
                                <div class="vaga-row">
                                    <span class="vaga-lbl">@ShortLabel(cor.Nome)</span>
                                    @foreach (var v in vagas)
                                    {
                                        var css   = StatusCss(v.Status);
                                        var embs  = v.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
                                        var first = embs.FirstOrDefault();
                                        var isSel = _sel?.Id == v.Id;
                                        <div class="vs @css @(isSel ? "sel" : "")"
                                             @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true"
                                             title="@v.Codigo">
                                            @if (first?.Embarcacao != null)
                                            { <img src="/images/boats/top/@SvgForTipo(first.Embarcacao.Tipo)" alt="@first.Embarcacao.Nome" class="vs-emb" /> }
                                            else
                                            { <span class="vs-cod">@v.Codigo</span> }
                                            @if (embs.Count > 1) { <span class="vs-cnt">@embs.Count</span> }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            @foreach (var cor in _corredores.Where(c => c.SecaoId == null).OrderBy(c => c.Nome))
            {
                var vagas = _todasVagas.Where(v => v.CorredorId == cor.Id).OrderBy(v => v.Codigo).ToList();
                <div class="secao-blk">
                    <div class="secao-hd">
                        <div class="secao-hd-left">
                            <span class="secao-hd-nome">@cor.Nome</span>
                            <span class="secao-count">sem seção</span>
                        </div>
                    </div>
                    <div class="mapa-body">
                        <div class="mapa-grid">
                            <div class="corredor-hd">@cor.Nome</div>
                            <div class="vaga-row">
                                <span class="vaga-lbl">@ShortLabel(cor.Nome)</span>
                                @foreach (var v in vagas)
                                {
                                    var css   = StatusCss(v.Status);
                                    var embs  = v.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
                                    var first = embs.FirstOrDefault();
                                    var isSel = _sel?.Id == v.Id;
                                    <div class="vs @css @(isSel ? "sel" : "")"
                                         @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true"
                                         title="@v.Codigo">
                                        @if (first?.Embarcacao != null)
                                        { <img src="/images/boats/top/@SvgForTipo(first.Embarcacao.Tipo)" alt="@first.Embarcacao.Nome" class="vs-emb" /> }
                                        else
                                        { <span class="vs-cod">@v.Codigo</span> }
                                        @if (embs.Count > 1) { <span class="vs-cnt">@embs.Count</span> }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

}

<!-- ═══ MODAL: Detalhe da Vaga ═══ -->
@if (_modalDetalhe && _sel != null)
{
    var embsAtivas  = _sel.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
    var disponiveis = _todasEmb.Where(e => embsAtivas.All(ea => ea.EmbarcacaoId != e.Id)).ToList();

    <Modal Title="@($"Vaga {_sel.Codigo}")" OnClose="FecharModais" Width="480px">

        <div style="display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;margin-bottom:1rem;">
            <StatusVagaBadge Status="@_sel.Status" />
            <span style="font-size:.8rem;color:var(--ink-400);">@(_sel.Tipo == TipoVaga.Agua ? "Molhada" : "Seca")</span>
            @if (_sel.Corredor != null)
            { <span style="font-size:.8rem;color:var(--ink-400);">· Corredor @_sel.Corredor.Nome</span> }
            @if (_sel.TamanhoMaxPes > 0)
            { <span style="font-size:.8rem;color:var(--ink-400);">· @_sel.TamanhoMaxPes pés</span> }
        </div>

        <div class="modal-sec">Embarcações na vaga</div>

        @if (!embsAtivas.Any())
        {
            <div style="font-size:.8rem;color:var(--ink-300);margin-bottom:.75rem;">Nenhuma embarcação alocada nesta vaga.</div>
        }
        else
        {
            @foreach (var ve in embsAtivas)
            {
                <div class="emb-row">
                    <div>
                        <div class="emb-row-nome">@(ve.Embarcacao?.Nome ?? "—")</div>
                        @if (ve.Embarcacao?.Cliente != null)
                        { <div class="emb-row-cli">@ve.Embarcacao.Cliente.Nome</div> }
                    </div>
                    <button class="emb-row-rm" title="Remover" @onclick="() => DesalocarAsync(ve.Id)">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            }
        }

        @if (disponiveis.Any() && _sel.Status != StatusVaga.Manutencao)
        {
            <div class="modal-sec">Vincular embarcação</div>
            <div class="field" style="margin-bottom:.75rem;">
                <select value="@_embIdStr" @onchange="e => _embIdStr = e.Value?.ToString() ?? string.Empty">
                    <option value="">Selecione a embarcação...</option>
                    @foreach (var e in disponiveis)
                    { <option value="@e.Id">@e.Nome@(e.Cliente != null ? $" ({e.Cliente.Nome})" : "")</option> }
                </select>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="AlocarAsync" disabled="@(_embIdStr == "" || _alocando)">
                @(_alocando ? "Vinculando..." : "+ Vincular")
            </button>
        }

        @if (_erroPanel != null)
        {
            <div style="margin-top:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_erroPanel</div>
        }

        <div class="form-actions" style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line);">
            <button class="btn btn-ghost" @onclick="FecharModais">Fechar</button>
            <a href="/vagas/@_sel.Id" class="btn btn-ghost btn-sm">Editar vaga →</a>
        </div>

    </Modal>
}

<!-- ═══ MODAL: Nova Seção ═══ -->
@if (_modalNovaSecao)
{
    <Modal Title="Nova Seção" OnClose="FecharModais" Width="420px">
        <div class="form-section">
            <div class="form-row">
                <div class="field">
                    <label>Nome *</label>
                    <input @bind="_novaSecaoNome" @bind:event="oninput" placeholder="Ex: Píer Norte, Galpão A..." maxlength="60" />
                </div>
                <div class="field">
                    <label>Tipo *</label>
                    <select value="@_novaSecaoTipoStr" @onchange="e => _novaSecaoTipoStr = e.Value?.ToString() ?? string.Empty">
                        <option value="">Selecione...</option>
                        <option value="Agua">Molhada (Água)</option>
                        <option value="Seco">Seca</option>
                    </select>
                </div>
            </div>
        </div>

        @if (_novaErro != null)
        {
            <div style="margin-bottom:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_novaErro</div>
        }

        <div class="form-actions">
            <button class="btn btn-ghost" @onclick="FecharModais">Cancelar</button>
            <button class="btn btn-primary" @onclick="SalvarNovaSecaoAsync"
                    disabled="@(_novaSecaoNome.Trim() == "" || _novaSecaoTipoStr == "" || _salvandoVaga)">
                @(_salvandoVaga ? "Criando..." : "Criar Seção")
            </button>
        </div>
    </Modal>
}

<!-- ═══ MODAL: Novo Corredor ═══ -->
@if (_modalNovoCorredor)
{
    <Modal Title="Novo Corredor" OnClose="FecharModais" Width="420px">
        <div class="form-section">
            <div class="form-row">
                <div class="field">
                    <label>Nome *</label>
                    <input @bind="_novaCorredorNome" @bind:event="oninput" placeholder="Ex: Corredor A" maxlength="60" />
                </div>
                <div class="field">
                    <label>Seção *</label>
                    <select value="@_novaCorredorSecaoIdStr" @onchange="e => _novaCorredorSecaoIdStr = e.Value?.ToString() ?? string.Empty">
                        <option value="">Selecione a seção...</option>
                        @foreach (var s in _secoes.OrderBy(s => s.Ordem).ThenBy(s => s.Nome))
                        { <option value="@s.Id">@s.Nome</option> }
                    </select>
                </div>
            </div>
        </div>

        @if (_novaErro != null)
        {
            <div style="margin-bottom:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_novaErro</div>
        }

        <div class="form-actions">
            <button class="btn btn-ghost" @onclick="FecharModais">Cancelar</button>
            <button class="btn btn-primary" @onclick="SalvarNovoCorredorAsync"
                    disabled="@(_novaCorredorNome.Trim() == "" || _novaCorredorSecaoIdStr == "" || _salvandoVaga)">
                @(_salvandoVaga ? "Criando..." : "Criar Corredor")
            </button>
        </div>
    </Modal>
}

<!-- ═══ MODAL: Nova Vaga ═══ -->
@if (_modalNovaVaga)
{
    <Modal Title="@($"Nova Vaga {(_modalTipo == TipoVaga.Agua ? "Molhada" : "Seca")}")" OnClose="FecharModais" Width="420px">
        <div class="form-section">
            <div class="form-row">
                <div class="field">
                    <label>Código *</label>
                    <input @bind="_novaCod" @bind:event="oninput" placeholder="Ex: A-01" maxlength="20" />
                </div>
                <div class="field">
                    <label>Corredor *</label>
                    <select value="@_novaCorredorIdStr" @onchange="e => _novaCorredorIdStr = e.Value?.ToString() ?? string.Empty">
                        <option value="">Selecione o corredor...</option>
                        @foreach (var c in _corredores.OrderBy(c => c.Nome))
                        { <option value="@c.Id">@c.Nome</option> }
                    </select>
                </div>
            </div>
        </div>

        @if (_novaErro != null)
        {
            <div style="margin-bottom:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_novaErro</div>
        }

        <div class="form-actions">
            <button class="btn btn-ghost" @onclick="FecharModais">Cancelar</button>
            <button class="btn btn-primary" @onclick="SalvarNovaVagaAsync"
                    disabled="@(_novaCod.Trim() == "" || _novaCorredorIdStr == "" || _salvandoVaga)">
                @(_salvandoVaga ? "Criando..." : "Criar Vaga")
            </button>
        </div>
    </Modal>
}

@code {
    private List<Vaga>       _todasVagas = new();
    private List<Embarcacao> _todasEmb   = new();
    private List<Corredor>   _corredores = new();
    private List<Secao>      _secoes     = new();
    private List<Secao>      _secoesMol  = new();
    private List<Secao>      _secoesSec  = new();
    private Vaga?            _sel;
    private bool             _load       = true;
    private bool             _abreMol    = true;
    private bool             _abreSec    = true;

    // modais
    private bool     _modalDetalhe;
    private bool     _modalNovaVaga;
    private bool     _modalNovaSecao;
    private bool     _modalNovoCorredor;
    private TipoVaga _modalTipo;

    // vincular embarcação
    private bool    _alocando;
    private string  _embIdStr  = "";
    private string? _erroPanel;

    // nova vaga (quick-add)
    private string  _novaCod           = "";
    private string  _novaCorredorIdStr = "";
    private string? _novaErro;
    private bool    _salvandoVaga;

    // nova seção (quick-add)
    private string _novaSecaoNome    = "";
    private string _novaSecaoTipoStr = "";

    // novo corredor (quick-add)
    private string _novaCorredorNome       = "";
    private string _novaCorredorSecaoIdStr = "";

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarSecoesCorrAsync();
        await RecarregarAsync();
    }

    private async Task CarregarSecoesCorrAsync()
    {
        _secoes     = await SecaoSvc.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _corredores = await CorredorService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _secoesMol  = _secoes.Where(s => s.TipoPreferencial == TipoVaga.Agua).ToList();
        _secoesSec  = _secoes.Where(s => s.TipoPreferencial == TipoVaga.Seco).ToList();
    }

    private async Task RecarregarAsync()
    {
        _todasVagas = await VagaService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _todasEmb   = await MovService.ListarEmbarcacoesAsync(UserCtx.EmpresaId);

        if (_sel != null)
        {
            var fresh = await VagaService.ObterPorIdAsync(_sel.Id, UserCtx.EmpresaId);
            _sel = fresh;
        }
        _load = false;
    }

    private async Task SelecionarAsync(Vaga v)
    {
        _erroPanel = null;
        _embIdStr  = "";
        var fresh  = await VagaService.ObterPorIdAsync(v.Id, UserCtx.EmpresaId);
        _sel       = fresh ?? v;
        _modalDetalhe = true;
    }

    private void Deselecionar() { _sel = null; _erroPanel = null; _embIdStr = ""; }

    private void AbrirModalNova(TipoVaga tipo, int? corredorId = null)
    {
        _modalTipo         = tipo;
        _novaCod           = "";
        _novaCorredorIdStr = corredorId?.ToString() ?? "";
        _novaErro          = null;
        _modalNovaVaga     = true;
    }

    private void AbrirModalNovaSecao(TipoVaga? tipo = null)
    {
        _novaSecaoNome    = "";
        _novaSecaoTipoStr = tipo == TipoVaga.Agua ? "Agua" : tipo == TipoVaga.Seco ? "Seco" : "";
        _novaErro         = null;
        _modalNovaSecao   = true;
    }

    private void AbrirModalNovoCorredor(int? secaoId = null)
    {
        _novaCorredorNome       = "";
        _novaCorredorSecaoIdStr = secaoId?.ToString() ?? "";
        _novaErro               = null;
        _modalNovoCorredor      = true;
    }

    private void FecharModais()
    {
        _modalDetalhe      = false;
        _modalNovaVaga     = false;
        _modalNovaSecao    = false;
        _modalNovoCorredor = false;
        _erroPanel         = null;
        _embIdStr          = "";
        _novaErro          = null;
    }

    private async Task AlocarAsync()
    {
        if (_sel == null || !int.TryParse(_embIdStr, out var eid) || eid == 0) return;
        _alocando  = true;
        _erroPanel = null;
        try
        {
            await AlocacaoService.AlocarEmbarcacaoAsync(_sel.Id, eid, UserCtx.EmpresaId);
            _embIdStr = "";
            await RecarregarAsync();
        }
        catch (Exception ex) { _erroPanel = ex.Message; }
        finally { _alocando = false; }
    }

    private async Task DesalocarAsync(int vagaEmbarcacaoId)
    {
        _erroPanel = null;
        try
        {
            await AlocacaoService.DesalocarEmbarcacaoAsync(vagaEmbarcacaoId, UserCtx.EmpresaId);
            await RecarregarAsync();
        }
        catch (Exception ex) { _erroPanel = ex.Message; }
    }

    private async Task SalvarNovaVagaAsync()
    {
        _novaErro = null;
        if (_novaCod.Trim() == "") { _novaErro = "Informe o código da vaga."; return; }
        if (_novaCorredorIdStr == "") { _novaErro = "Selecione o corredor."; return; }
        _salvandoVaga = true;
        try
        {
            var vaga = new Vaga
            {
                EmpresaId  = UserCtx.EmpresaId,
                Codigo     = _novaCod.Trim().ToUpper(),
                Tipo       = _modalTipo,
                Status     = StatusVaga.Livre,
                Ativa      = true,
                Largura    = 90,
                Altura     = 56,
                CorredorId = int.TryParse(_novaCorredorIdStr, out var cid) ? cid : null,
            };
            await VagaService.CriarAsync(vaga);
            _modalNovaVaga = false;
            await RecarregarAsync();
        }
        catch (Exception ex) { _novaErro = ex.Message; }
        finally { _salvandoVaga = false; }
    }

    private async Task SalvarNovaSecaoAsync()
    {
        _novaErro = null;
        if (_novaSecaoNome.Trim() == "") { _novaErro = "Informe o nome da seção."; return; }
        if (_novaSecaoTipoStr == "") { _novaErro = "Selecione o tipo (Molhada ou Seca)."; return; }
        _salvandoVaga = true;
        try
        {
            await SecaoSvc.CriarAsync(new Secao
            {
                EmpresaId        = UserCtx.EmpresaId,
                Nome             = _novaSecaoNome.Trim(),
                Ativo            = true,
                TipoPreferencial = Enum.TryParse<TipoVaga>(_novaSecaoTipoStr, out var t) ? t : null,
            });
            await CarregarSecoesCorrAsync();
            _modalNovaSecao = false;
        }
        catch (Exception ex) { _novaErro = ex.Message; }
        finally { _salvandoVaga = false; }
    }

    private async Task SalvarNovoCorredorAsync()
    {
        _novaErro = null;
        if (_novaCorredorNome.Trim() == "") { _novaErro = "Informe o nome do corredor."; return; }
        if (_novaCorredorSecaoIdStr == "") { _novaErro = "Selecione a seção."; return; }
        _salvandoVaga = true;
        try
        {
            await CorredorService.CriarAsync(new Corredor
            {
                EmpresaId = UserCtx.EmpresaId,
                Nome      = _novaCorredorNome.Trim(),
                SecaoId   = int.TryParse(_novaCorredorSecaoIdStr, out var sid) && sid > 0 ? sid : null,
                Ativo     = true,
            });
            await CarregarSecoesCorrAsync();
            _modalNovoCorredor = false;
            await RecarregarAsync();
        }
        catch (Exception ex) { _novaErro = ex.Message; }
        finally { _salvandoVaga = false; }
    }

    private static string StatusCss(StatusVaga s) => s switch
    {
        StatusVaga.Livre          => "livre",
        StatusVaga.Ocupada        => "ocupada",
        StatusVaga.EmMovimentacao => "movimentacao",
        StatusVaga.Manutencao     => "manutencao",
        _                         => "livre",
    };

    private static string SvgForTipo(SetiMarine.Domain.Enums.TipoEmbarcacao tipo) => tipo switch
    {
        SetiMarine.Domain.Enums.TipoEmbarcacao.Veleiro => "veleiro-top.svg",
        SetiMarine.Domain.Enums.TipoEmbarcacao.JetSki  => "jetski-top.svg",
        _                                               => "lancha-top.svg",
    };

    private static string ShortLabel(string corredorNome)
    {
        if (corredorNome.Length <= 4) return corredorNome;
        var parts = corredorNome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[0][..Math.Min(2, parts[0].Length)] + parts[1][..Math.Min(1, parts[1].Length)]
                                : corredorNome[..Math.Min(4, corredorNome.Length)];
    }
}
