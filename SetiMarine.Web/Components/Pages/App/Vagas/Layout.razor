@page "/vagas/layout"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject VagaService VagaService
@inject CorredorService CorredorService
@inject UsuarioContextService UserCtx

<PageTitle>Mapa da Marina — SetiMarine</PageTitle>

<style>
.layout-counters { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
.layout-counter  { padding: .6rem 1rem; border: 1px solid var(--line); border-radius: 3px; min-width: 110px; }
.layout-counter-val { font-size: 1.4rem; font-weight: 700; line-height: 1; }
.layout-counter-lbl { font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-400); margin-top: .15rem; }

.layout-legend { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.layout-legend-item { display: flex; align-items: center; gap: .35rem; font-size: .72rem; color: var(--ink-500); }
.layout-legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

.corredor-section { margin-bottom: 2rem; }
.corredor-header {
    display: flex; align-items: center; gap: .75rem;
    margin-bottom: .85rem; padding-bottom: .5rem;
    border-bottom: 1px solid var(--line);
}
.corredor-nome { font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-500); }
.corredor-count { font-size: .65rem; color: var(--ink-300); }

.vagas-grid { display: flex; flex-wrap: wrap; gap: .5rem; }

.vaga-card {
    width: 88px; height: 64px;
    border-radius: 4px;
    border: 1.5px solid;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: .2rem;
    cursor: pointer;
    text-decoration: none;
    transition: transform .1s, box-shadow .12s;
    padding: 4px;
    position: relative;
    overflow: hidden;
}
.vaga-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }

.vaga-card.livre       { background: rgba(74,138,92,.09);  border-color: rgba(74,138,92,.4); }
.vaga-card.ocupada     { background: rgba(36,53,149,.09);  border-color: rgba(36,53,149,.35); }
.vaga-card.movimentacao { background: rgba(184,138,46,.1); border-color: rgba(184,138,46,.4); }
.vaga-card.manutencao  { background: rgba(164,68,54,.08);  border-color: rgba(164,68,54,.3); }

.vaga-cod {
    font-size: .72rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    line-height: 1;
}
.vaga-card.livre       .vaga-cod { color: var(--s-free); }
.vaga-card.ocupada     .vaga-cod { color: var(--navy-700); }
.vaga-card.movimentacao .vaga-cod { color: #9a7420; }
.vaga-card.manutencao  .vaga-cod { color: var(--s-maint); }

.vaga-emb {
    font-size: .58rem; color: var(--ink-500);
    max-width: 76px; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
    text-align: center; line-height: 1.2;
}

.vaga-tipo-tag {
    position: absolute; top: 3px; right: 4px;
    font-size: .5rem; letter-spacing: .08em; text-transform: uppercase;
    opacity: .55;
}
.vaga-card.livre .vaga-tipo-tag       { color: var(--s-free); }
.vaga-card.ocupada .vaga-tipo-tag     { color: var(--navy-700); }
.vaga-card.movimentacao .vaga-tipo-tag { color: #9a7420; }
.vaga-card.manutencao .vaga-tipo-tag  { color: var(--s-maint); }

.sem-corredor-lbl { font-size: .68rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-300); }
</style>

<div class="page-head">
    <div>
        <span class="eyebrow">Vagas</span>
        <h1>Mapa da Marina</h1>
    </div>
    <div class="page-head-actions">
        <div class="layout-legend">
            <div class="layout-legend-item">
                <div class="layout-legend-dot" style="background:rgba(74,138,92,.5);border:1.5px solid rgba(74,138,92,.6);"></div>Livre
            </div>
            <div class="layout-legend-item">
                <div class="layout-legend-dot" style="background:rgba(36,53,149,.35);border:1.5px solid rgba(36,53,149,.5);"></div>Ocupada
            </div>
            <div class="layout-legend-item">
                <div class="layout-legend-dot" style="background:rgba(184,138,46,.4);border:1.5px solid rgba(184,138,46,.55);"></div>Movimentação
            </div>
            <div class="layout-legend-item">
                <div class="layout-legend-dot" style="background:rgba(164,68,54,.3);border:1.5px solid rgba(164,68,54,.45);"></div>Manutenção
            </div>
        </div>
        <a href="/vagas" class="btn btn-ghost btn-sm">Lista</a>
        <a href="/vagas/nova" class="btn btn-primary btn-sm">+ Nova Vaga</a>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;justify-content:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <!-- Contadores -->
    <div class="layout-counters">
        <div class="layout-counter">
            <div class="layout-counter-val" style="color:var(--s-free);">@_livres</div>
            <div class="layout-counter-lbl">Livres</div>
        </div>
        <div class="layout-counter">
            <div class="layout-counter-val" style="color:var(--navy-700);">@_ocupadas</div>
            <div class="layout-counter-lbl">Ocupadas</div>
        </div>
        <div class="layout-counter">
            <div class="layout-counter-val" style="color:#9a7420;">@_emMov</div>
            <div class="layout-counter-lbl">Em Movimentação</div>
        </div>
        <div class="layout-counter">
            <div class="layout-counter-val" style="color:var(--s-maint);">@_manut</div>
            <div class="layout-counter-lbl">Manutenção</div>
        </div>
        <div class="layout-counter" style="border-color:rgba(36,53,149,.15);">
            <div class="layout-counter-val" style="color:var(--ink-600);">@_total</div>
            <div class="layout-counter-lbl">Total de vagas</div>
        </div>
    </div>

    <!-- Vagas agrupadas por corredor -->
    @foreach (var grupo in _grupos)
    {
        <div class="corredor-section">
            <div class="corredor-header">
                @if (grupo.Key != null)
                {
                    <span class="corredor-nome">@grupo.Key.Nome</span>
                    @if (!string.IsNullOrEmpty(grupo.Key.Descricao))
                    {
                        <span class="corredor-count">— @grupo.Key.Descricao</span>
                    }
                }
                else
                {
                    <span class="sem-corredor-lbl">Sem corredor</span>
                }
                <span class="corredor-count">@grupo.Vagas.Count vaga@(grupo.Vagas.Count != 1 ? "s" : "")</span>
            </div>

            <div class="vagas-grid">
                @foreach (var v in grupo.Vagas)
                {
                    var cssClass = v.Status switch
                    {
                        StatusVaga.Livre          => "livre",
                        StatusVaga.Ocupada        => "ocupada",
                        StatusVaga.EmMovimentacao => "movimentacao",
                        StatusVaga.Manutencao     => "manutencao",
                        _                         => "livre",
                    };
                    var embNome = v.EmbarcacoesNaVaga.FirstOrDefault(e => e.Ativa)?.Embarcacao?.Nome;
                    <a href="/vagas/@v.Id" class="vaga-card @cssClass" title="@v.Codigo — @(embNome ?? StatusLabel(v.Status))">
                        <div class="vaga-tipo-tag">@(v.Tipo == TipoVaga.Agua ? "A" : "S")</div>
                        <div class="vaga-cod">@v.Codigo</div>
                        @if (embNome != null)
                        {
                            <div class="vaga-emb">@embNome</div>
                        }
                        else if (v.Status == StatusVaga.Manutencao)
                        {
                            <div class="vaga-emb" style="color:var(--s-maint);opacity:.7;">manutenção</div>
                        }
                    </a>
                }
            </div>
        </div>
    }

    @if (!_grupos.Any())
    {
        <div style="padding:3rem 2rem;text-align:center;color:var(--ink-300);">
            <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.25rem;">Nenhuma vaga cadastrada</p>
            <a href="/vagas/nova" class="btn btn-primary btn-sm">Cadastrar Vaga</a>
        </div>
    }
}

@code {
    record GrupoVagas(Corredor? Key, List<Vaga> Vagas);

    private List<GrupoVagas> _grupos = new();
    private bool _carregando = true;
    private int _livres, _ocupadas, _emMov, _manut, _total;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        var vagas = await VagaService.ListarPorEmpresaAsync(UserCtx.EmpresaId);

        _total    = vagas.Count;
        _livres   = vagas.Count(v => v.Status == StatusVaga.Livre);
        _ocupadas = vagas.Count(v => v.Status == StatusVaga.Ocupada);
        _emMov    = vagas.Count(v => v.Status == StatusVaga.EmMovimentacao);
        _manut    = vagas.Count(v => v.Status == StatusVaga.Manutencao);

        _grupos = vagas
            .GroupBy(v => v.Corredor, new CorredorComparer())
            .Select(g => new GrupoVagas(g.Key, g.OrderBy(v => v.Codigo).ToList()))
            .OrderBy(g => g.Key?.Ordem ?? int.MaxValue)
            .ToList();

        _carregando = false;
    }

    private static string StatusLabel(StatusVaga s) => s switch
    {
        StatusVaga.Livre          => "Livre",
        StatusVaga.Ocupada        => "Ocupada",
        StatusVaga.EmMovimentacao => "Em Movimentação",
        StatusVaga.Manutencao     => "Manutenção",
        _                         => s.ToString(),
    };

    class CorredorComparer : IEqualityComparer<Corredor?>
    {
        public bool Equals(Corredor? x, Corredor? y) =>
            (x == null && y == null) || (x != null && y != null && x.Id == y.Id);
        public int GetHashCode(Corredor? obj) => obj?.Id.GetHashCode() ?? 0;
    }
}
