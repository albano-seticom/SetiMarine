@page "/vagas/layout"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject VagaService VagaService
@inject CorredorService CorredorService
@inject AlocacaoService AlocacaoService
@inject MovimentacaoService MovService
@inject UsuarioContextService UserCtx

<PageTitle>Mapa da Marina — SetiMarine</PageTitle>

<style>
/* ── Canvas base ─────────────────────────────────── */
.mapa-outer { border:1px solid rgba(22,53,103,.14);border-radius:6px;overflow:hidden;margin-bottom:1.25rem;box-shadow:0 2px 12px rgba(0,0,0,.08); }
.mapa-bar   { display:flex;justify-content:space-between;align-items:center;padding:.65rem 1rem;background:#060f1e; }
.mapa-title { font-size:.78rem;font-weight:700;letter-spacing:.3px;text-transform:uppercase;color:#fff;display:flex;align-items:center;gap:.5rem; }
.mapa-count { font-size:.65rem;font-weight:400;color:rgba(255,255,255,.35); }
.live-dot   { width:7px;height:7px;border-radius:50%;background:#1ab3a6;animation:pulse 2s ease-in-out infinite; }
@@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.4)}}
.leg        { display:flex;gap:.75rem; }
.leg-i      { display:flex;align-items:center;gap:.3rem;font-size:.65rem;color:rgba(255,255,255,.4); }
.leg-d      { width:9px;height:9px;border-radius:2px; }
.mapa-body  { position:relative;background:#050d1a;
    background-image:linear-gradient(rgba(0,212,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.02) 1px,transparent 1px);
    background-size:40px 40px;overflow:hidden;cursor:default;height:320px; }
.canvas-inner { position:absolute;width:3200px;height:1200px;transform-origin:0 0; }

/* ── Vaga card (tamanho fixo) ─────────────────────── */
.vi { position:absolute;width:90px;height:56px;border-radius:5px;border:1.5px solid;
      display:flex;flex-direction:column;align-items:center;justify-content:center;
      cursor:pointer;user-select:none;gap:2px;
      transition:border-color .15s,box-shadow .15s,transform .12s;overflow:hidden; }
.vi:hover { z-index:20;transform:scale(1.07);box-shadow:0 0 0 3px rgba(255,255,255,.1); }
.vi.sel   { z-index:30;box-shadow:0 0 0 3px rgba(255,255,255,.38) !important; }
.vi.livre        { background:rgba(26,179,166,.1);  border-color:rgba(26,179,166,.45); }
.vi.ocupada      { background:rgba(22,53,103,.22);  border-color:rgba(29,71,133,.55); }
.vi.movimentacao { background:rgba(201,168,76,.15); border-color:rgba(201,168,76,.5); }
.vi.manutencao   { background:rgba(232,69,60,.12);  border-color:rgba(232,69,60,.45); }
.vi.sel.livre        { border-color:#1ab3a6; }
.vi.sel.ocupada      { border-color:#4d8fd4; }
.vi.sel.movimentacao { border-color:#c9a84c; }
.vi.sel.manutencao   { border-color:#e8453c; }
.vcod { font-size:.7rem;font-weight:700;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.7);letter-spacing:.5px;text-align:center; }
.vcor { font-size:.55rem;color:rgba(255,255,255,.32);text-align:center;max-width:86px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }

/* indicator: nº embarcações */
.vi-embs { position:absolute;top:3px;right:4px;min-width:15px;height:15px;border-radius:8px;
           background:#1ab3a6;color:#060f1e;font-size:.58rem;font-weight:800;
           display:flex;align-items:center;justify-content:center;padding:0 3px;
           box-shadow:0 0 0 2px rgba(5,13,26,.6); }

/* botão "+" dentro do canvas */
.vi-add { position:absolute;width:90px;height:56px;border-radius:5px;
          border:1.5px dashed rgba(255,255,255,.14);background:none;
          display:flex;align-items:center;justify-content:center;
          cursor:pointer;color:rgba(255,255,255,.22);
          transition:border-color .15s,color .15s,background .15s; }
.vi-add:hover { border-color:rgba(26,179,166,.5);color:#1ab3a6;background:rgba(26,179,166,.05); }

/* controles zoom */
.ctrls { position:absolute;bottom:10px;left:10px;z-index:50;display:flex;gap:.3rem; }
.cbtn { width:28px;height:28px;border-radius:5px;background:rgba(5,13,26,.85);
        border:1px solid rgba(0,200,255,.12);color:rgba(255,255,255,.6);
        cursor:pointer;display:grid;place-items:center;backdrop-filter:blur(8px);transition:all .15s; }
.cbtn:hover { border-color:rgba(0,212,255,.35);color:#fff; }
.hint { position:absolute;bottom:10px;right:12px;font-size:.62rem;color:rgba(255,255,255,.18); }
.empty-mapa { display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:.5rem;color:rgba(255,255,255,.3); }

/* ── Conteúdo do modal de detalhe ─────────────────── */
.emb-row { display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;
           background:var(--surface,rgba(0,0,0,.03));border:1px solid var(--line);
           border-radius:4px;margin-bottom:.4rem; }
.emb-row-nome { flex:1;font-size:.83rem;font-weight:500;color:var(--ink-900); }
.emb-row-cli  { font-size:.72rem;color:var(--ink-400); }
.emb-row-rm { background:none;border:none;cursor:pointer;color:var(--ink-300);
              padding:3px;border-radius:3px;display:flex;align-items:center;transition:color .15s; }
.emb-row-rm:hover { color:var(--s-maint); }
.modal-sec { font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
             color:var(--ink-400);margin:1.1rem 0 .55rem; }
</style>

<div class="page-head">
    <div>
        <span class="eyebrow">Operações</span>
        <h1>Mapa da Marina</h1>
    </div>
    <div class="page-head-actions">
        <a href="/vagas" class="btn btn-ghost btn-sm">Lista de Vagas</a>
    </div>
</div>

@if (_load)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando mapa...</span>
    </div>
}
else
{

<!-- ═══ VAGAS MOLHADAS ═══ -->
<div class="mapa-outer">
    <div class="mapa-bar">
        <div class="mapa-title">
            <div class="live-dot"></div>
            Vagas Molhadas
            <span class="mapa-count">@_vagasMol.Count vagas</span>
        </div>
        <div class="leg">
            <div class="leg-i"><div class="leg-d" style="background:#1ab3a6"></div>Livre</div>
            <div class="leg-i"><div class="leg-d" style="background:#1d4785"></div>Ocupada</div>
            <div class="leg-i"><div class="leg-d" style="background:#c9a84c"></div>Mov.</div>
            <div class="leg-i"><div class="leg-d" style="background:#e8453c"></div>Manut.</div>
        </div>
    </div>
    <div class="mapa-body" @onclick="Deselecionar">
        @if (!_vagasMol.Any())
        {
            <div class="empty-mapa">
                <span>Nenhuma vaga molhada.</span>
                <button class="vi-add" style="position:relative;width:120px;height:40px;margin-top:.5rem;"
                        @onclick="() => AbrirModalNova(TipoVaga.Agua)" @onclick:stopPropagation="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span style="font-size:.75rem;margin-left:.3rem;">Nova vaga</span>
                </button>
            </div>
        }
        else
        {
            <div class="canvas-inner" style="transform:translate(@(_pxM.ToString("F1",_ci))px,@(_pyM.ToString("F1",_ci))px) scale(@(_scM.ToString("F3",_ci)))">
                @foreach (var (v, idx) in _vagasMol.Select((v, i) => (v, i)))
                {
                    var (vx, vy) = AutoPos(idx);
                    var css    = StatusCss(v.Status);
                    var isSel  = _sel?.Id == v.Id;
                    var embCnt = v.EmbarcacoesNaVaga.Count(e => e.Ativa);
                    <div class="vi @css @(isSel ? "sel" : "")" style="left:@(vx)px;top:@(vy)px;"
                         @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true">
                        @if (embCnt > 0) { <div class="vi-embs">@embCnt</div> }
                        <div class="vcod">@v.Codigo</div>
                        <div class="vcor">@(v.Corredor?.Nome ?? "")</div>
                    </div>
                }
                @{ var (apx, apy) = AutoPos(_vagasMol.Count); }
                <button class="vi-add" style="left:@(apx)px;top:@(apy)px;" title="Nova vaga molhada"
                        @onclick="() => AbrirModalNova(TipoVaga.Agua)" @onclick:stopPropagation="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>
            <div class="ctrls">
                <button class="cbtn" @onclick="ZInM"  ><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                <button class="cbtn" @onclick="ZOutM" ><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                <button class="cbtn" @onclick="ZResetM"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button>
            </div>
            <div class="hint">Clique na vaga · + para nova</div>
        }
    </div>
</div>

<!-- ═══ VAGAS SECAS ═══ -->
<div class="mapa-outer">
    <div class="mapa-bar">
        <div class="mapa-title">
            <div class="live-dot" style="background:#c9a84c;"></div>
            Vagas Secas
            <span class="mapa-count">@_vagasSec.Count vagas</span>
        </div>
        <div class="leg">
            <div class="leg-i"><div class="leg-d" style="background:#1ab3a6"></div>Livre</div>
            <div class="leg-i"><div class="leg-d" style="background:#1d4785"></div>Ocupada</div>
            <div class="leg-i"><div class="leg-d" style="background:#c9a84c"></div>Mov.</div>
            <div class="leg-i"><div class="leg-d" style="background:#e8453c"></div>Manut.</div>
        </div>
    </div>
    <div class="mapa-body" @onclick="Deselecionar">
        @if (!_vagasSec.Any())
        {
            <div class="empty-mapa">
                <span>Nenhuma vaga seca.</span>
                <button class="vi-add" style="position:relative;width:120px;height:40px;margin-top:.5rem;"
                        @onclick="() => AbrirModalNova(TipoVaga.Seco)" @onclick:stopPropagation="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span style="font-size:.75rem;margin-left:.3rem;">Nova vaga</span>
                </button>
            </div>
        }
        else
        {
            <div class="canvas-inner" style="transform:translate(@(_pxS.ToString("F1",_ci))px,@(_pyS.ToString("F1",_ci))px) scale(@(_scS.ToString("F3",_ci)))">
                @foreach (var (v, idx) in _vagasSec.Select((v, i) => (v, i)))
                {
                    var (vx, vy) = AutoPos(idx);
                    var css    = StatusCss(v.Status);
                    var isSel  = _sel?.Id == v.Id;
                    var embCnt = v.EmbarcacoesNaVaga.Count(e => e.Ativa);
                    <div class="vi @css @(isSel ? "sel" : "")" style="left:@(vx)px;top:@(vy)px;"
                         @onclick="() => SelecionarAsync(v)" @onclick:stopPropagation="true">
                        @if (embCnt > 0) { <div class="vi-embs">@embCnt</div> }
                        <div class="vcod">@v.Codigo</div>
                        <div class="vcor">@(v.Corredor?.Nome ?? "")</div>
                    </div>
                }
                @{ var (bpx, bpy) = AutoPos(_vagasSec.Count); }
                <button class="vi-add" style="left:@(bpx)px;top:@(bpy)px;" title="Nova vaga seca"
                        @onclick="() => AbrirModalNova(TipoVaga.Seco)" @onclick:stopPropagation="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>
            <div class="ctrls">
                <button class="cbtn" @onclick="ZInS"  ><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                <button class="cbtn" @onclick="ZOutS" ><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                <button class="cbtn" @onclick="ZResetS"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button>
            </div>
            <div class="hint">Clique na vaga · + para nova</div>
        }
    </div>
</div>

}

<!-- ═══ MODAL: Detalhe da Vaga + Vínculo ═══ -->
@if (_modalDetalhe && _sel != null)
{
    var embsAtivas  = _sel.EmbarcacoesNaVaga.Where(e => e.Ativa).ToList();
    var disponiveis = _todasEmb.Where(e => embsAtivas.All(ea => ea.EmbarcacaoId != e.Id)).ToList();
    var badgeCss    = StatusCss(_sel.Status);
    var badgeLbl    = _sel.Status switch {
        StatusVaga.Livre          => "Livre",
        StatusVaga.Ocupada        => "Ocupada",
        StatusVaga.EmMovimentacao => "Em Movimentação",
        StatusVaga.Manutencao     => "Manutenção",
        _                         => "",
    };

    <Modal Title="@($"Vaga {_sel.Codigo}")" OnClose="FecharModais" Width="480px">

        <!-- status + detalhes -->
        <div style="display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;margin-bottom:1rem;">
            <StatusVagaBadge Status="@_sel.Status" />
            <span style="font-size:.8rem;color:var(--ink-400);">@(_sel.Tipo == TipoVaga.Agua ? "Molhada" : "Seca")</span>
            @if (_sel.Corredor != null)
            { <span style="font-size:.8rem;color:var(--ink-400);">· Corredor @_sel.Corredor.Nome</span> }
            @if (_sel.TamanhoMaxPes > 0)
            { <span style="font-size:.8rem;color:var(--ink-400);">· @_sel.TamanhoMaxPes pes</span> }
        </div>

        <!-- embarcações na vaga -->
        <div class="modal-sec">Embarcações na vaga</div>

        @if (!embsAtivas.Any())
        {
            <div style="font-size:.8rem;color:var(--ink-300);margin-bottom:.75rem;">Nenhuma embarcação alocada nesta vaga.</div>
        }
        else
        {
            @foreach (var ve in embsAtivas)
            {
                <div class="emb-row">
                    <div>
                        <div class="emb-row-nome">@(ve.Embarcacao?.Nome ?? "—")</div>
                        @if (ve.Embarcacao?.Cliente != null)
                        { <div class="emb-row-cli">@ve.Embarcacao.Cliente.Nome</div> }
                    </div>
                    <button class="emb-row-rm" title="Remover" @onclick="() => DesalocarAsync(ve.Id)">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            }
        }

        <!-- vincular nova embarcação -->
        @if (disponiveis.Any() && _sel.Status != StatusVaga.Manutencao)
        {
            <div class="modal-sec">Vincular embarcação</div>
            <div class="field" style="margin-bottom:.75rem;">
                <select @bind="_embIdStr">
                    <option value="">Selecione a embarcação...</option>
                    @foreach (var e in disponiveis)
                    { <option value="@e.Id">@e.Nome@(e.Cliente != null ? $" ({e.Cliente.Nome})" : "")</option> }
                </select>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="AlocarAsync" disabled="@(_embIdStr == "" || _alocando)">
                @(_alocando ? "Vinculando..." : "+ Vincular")
            </button>
        }

        @if (_erroPanel != null)
        {
            <div style="margin-top:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_erroPanel</div>
        }

        <div class="form-actions" style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line);">
            <button class="btn btn-ghost" @onclick="FecharModais">Fechar</button>
            <a href="/vagas/@_sel.Id" class="btn btn-ghost btn-sm">Editar vaga →</a>
        </div>

    </Modal>
}

<!-- ═══ MODAL: Nova Vaga ═══ -->
@if (_modalNovaVaga)
{
    <Modal Title="@($"Nova Vaga {(_modalTipo == TipoVaga.Agua ? "Molhada" : "Seca")}")" OnClose="FecharModais" Width="420px">

        <div class="form-section">
            <div class="form-row">
                <div class="field">
                    <label>Código *</label>
                    <input @bind="_novaCod" @bind:event="oninput" placeholder="Ex: A-01" maxlength="20" />
                </div>
                <div class="field">
                    <label>Corredor</label>
                    <select @bind="_novaCorredorIdStr">
                        <option value="">Sem corredor</option>
                        @foreach (var c in _corredores)
                        { <option value="@c.Id">@c.Nome</option> }
                    </select>
                </div>
            </div>
        </div>

        @if (_novaErro != null)
        {
            <div style="margin-bottom:.75rem;padding:.75rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:3px;">@_novaErro</div>
        }

        <div class="form-actions">
            <button class="btn btn-ghost" @onclick="FecharModais">Cancelar</button>
            <button class="btn btn-primary" @onclick="SalvarNovaVagaAsync" disabled="@(_novaCod.Trim() == "" || _salvandoVaga)">
                @(_salvandoVaga ? "Criando..." : "Criar Vaga")
            </button>
        </div>

    </Modal>
}

@code {
    private static readonly System.Globalization.CultureInfo _ci = System.Globalization.CultureInfo.InvariantCulture;

    private List<Vaga>       _vagasMol  = new();
    private List<Vaga>       _vagasSec  = new();
    private List<Embarcacao> _todasEmb  = new();
    private List<Corredor>   _corredores = new();
    private Vaga?            _sel;
    private bool             _load      = true;

    // zoom molhadas / secas
    private double _scM = 1, _pxM, _pyM;
    private double _scS = 1, _pxS, _pyS;

    // modais
    private bool     _modalDetalhe;
    private bool     _modalNovaVaga;
    private TipoVaga _modalTipo;

    // vincular embarcação
    private bool    _alocando;
    private string  _embIdStr  = "";
    private string? _erroPanel;

    // nova vaga (quick-add)
    private string  _novaCod            = "";
    private string  _novaCorredorIdStr  = "";
    private string? _novaErro;
    private bool    _salvandoVaga;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _corredores = await CorredorService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        await RecarregarAsync();
    }

    private async Task RecarregarAsync()
    {
        var todas  = await VagaService.ListarPorEmpresaAsync(UserCtx.EmpresaId);
        _vagasMol  = todas.Where(v => v.Tipo == TipoVaga.Agua).OrderBy(v => v.Codigo).ToList();
        _vagasSec  = todas.Where(v => v.Tipo == TipoVaga.Seco).OrderBy(v => v.Codigo).ToList();
        _todasEmb  = await MovService.ListarEmbarcacoesAsync(UserCtx.EmpresaId);

        if (_sel != null)
        {
            var fresh = await VagaService.ObterPorIdAsync(_sel.Id, UserCtx.EmpresaId);
            _sel = fresh;
        }
        _load = false;
    }

    private async Task SelecionarAsync(Vaga v)
    {
        _erroPanel = null;
        _embIdStr  = "";
        var fresh  = await VagaService.ObterPorIdAsync(v.Id, UserCtx.EmpresaId);
        _sel       = fresh ?? v;
        _modalDetalhe = true;
    }

    private void Deselecionar() { _sel = null; _erroPanel = null; _embIdStr = ""; }

    private void AbrirModalNova(TipoVaga tipo)
    {
        _modalTipo          = tipo;
        _novaCod            = "";
        _novaCorredorIdStr  = "";
        _novaErro           = null;
        _modalNovaVaga      = true;
    }

    private void FecharModais()
    {
        _modalDetalhe  = false;
        _modalNovaVaga = false;
        _erroPanel     = null;
        _embIdStr      = "";
    }

    private async Task AlocarAsync()
    {
        if (_sel == null || !int.TryParse(_embIdStr, out var eid) || eid == 0) return;
        _alocando  = true;
        _erroPanel = null;
        try
        {
            await AlocacaoService.AlocarEmbarcacaoAsync(_sel.Id, eid, UserCtx.EmpresaId);
            _embIdStr = "";
            await RecarregarAsync();
        }
        catch (Exception ex) { _erroPanel = ex.Message; }
        finally { _alocando = false; }
    }

    private async Task DesalocarAsync(int vagaEmbarcacaoId)
    {
        _erroPanel = null;
        try
        {
            await AlocacaoService.DesalocarEmbarcacaoAsync(vagaEmbarcacaoId, UserCtx.EmpresaId);
            await RecarregarAsync();
        }
        catch (Exception ex) { _erroPanel = ex.Message; }
    }

    private async Task SalvarNovaVagaAsync()
    {
        _novaErro = null;
        if (_novaCod.Trim() == "") { _novaErro = "Informe o código da vaga."; return; }
        _salvandoVaga = true;
        try
        {
            var vaga = new Vaga
            {
                EmpresaId  = UserCtx.EmpresaId,
                Codigo     = _novaCod.Trim().ToUpper(),
                Tipo       = _modalTipo,
                Status     = StatusVaga.Livre,
                Ativa      = true,
                Largura    = 90,
                Altura     = 56,
                CorredorId = int.TryParse(_novaCorredorIdStr, out var cid) ? cid : null,
            };
            await VagaService.CriarAsync(vaga);
            _modalNovaVaga = false;
            await RecarregarAsync();
        }
        catch (Exception ex) { _novaErro = ex.Message; }
        finally { _salvandoVaga = false; }
    }

    private static (int x, int y) AutoPos(int i, int cols = 10)
    {
        const int W = 90, H = 56, GAP = 10, OX = 20, OY = 20;
        return (OX + i % cols * (W + GAP), OY + i / cols * (H + GAP));
    }

    private static string StatusCss(StatusVaga s) => s switch
    {
        StatusVaga.Livre          => "livre",
        StatusVaga.Ocupada        => "ocupada",
        StatusVaga.EmMovimentacao => "movimentacao",
        StatusVaga.Manutencao     => "manutencao",
        _                         => "livre",
    };

    private void ZInM()    => _scM = Math.Min(3,  _scM + .15);
    private void ZOutM()   => _scM = Math.Max(.2, _scM - .15);
    private void ZResetM() => (_scM, _pxM, _pyM) = (1, 0, 0);

    private void ZInS()    => _scS = Math.Min(3,  _scS + .15);
    private void ZOutS()   => _scS = Math.Max(.2, _scS - .15);
    private void ZResetS() => (_scS, _pxS, _pyS) = (1, 0, 0);
}
