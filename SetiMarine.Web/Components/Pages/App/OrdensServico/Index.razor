@page "/servicos"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject PedidoService PedidoSvc
@inject UsuarioContextService UserCtx

<PageTitle>Catálogo de Serviços — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Configuração</span>
        <h1>Catálogo de Serviços</h1>
    </div>
</div>

@* Formulário de adição / edição *@
<div style="background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:1rem 1.25rem;margin-bottom:1.5rem;">
    <p style="font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-400);margin-bottom:.75rem;">
        @(_editando?.Id > 0 ? "Editar serviço" : "Novo serviço")
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end;">
        <div class="field" style="margin:0;flex:3;min-width:180px;">
            <label>Nome do serviço</label>
            <input type="text" @bind="_editando!.Nome" placeholder="Ex: Limpeza Pós-Passeio" />
        </div>
        <div class="field" style="margin:0;min-width:110px;">
            <label>Valor padrão (R$)</label>
            <input type="number" @bind="_editando.ValorPadrao" min="0" step="0.01" placeholder="0,00" />
        </div>
        <div class="field" style="margin:0;min-width:100px;">
            <label>Duração (horas)</label>
            <input type="number" @bind="_editando.DuracaoHoras" min="0" step="0.5" placeholder="0" />
        </div>
        <div class="field" style="margin:0;min-width:100px;">
            <label>Frequência (dias)</label>
            <input type="number" @bind="_editando.FrequenciaDias" min="1" />
        </div>
        <div style="display:flex;gap:.5rem;padding-bottom:.1rem;">
            <button class="btn btn-primary btn-sm" @onclick="SalvarAsync">
                @(_editando.Id > 0 ? "Salvar" : "Adicionar")
            </button>
            @if (_editando.Id > 0)
            {
                <button class="btn btn-ghost btn-sm" @onclick="CancelarEdicao">Cancelar</button>
            }
        </div>
    </div>
    @if (_erro != null)
    {
        <p style="color:var(--s-maint);font-size:.82rem;margin-top:.5rem;">@_erro</p>
    }
</div>

@* Lista *@
@if (_carregando)
{
    <div style="padding:2rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_tipos.Any())
{
    <div style="padding:3rem 2rem;text-align:center;color:var(--ink-300);">
        <p style="font-size:.8rem;">Nenhum serviço cadastrado. Use o formulário acima para começar.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th style="width:130px;text-align:right;">Valor Padrão</th>
                    <th style="width:110px;text-align:right;">Duração</th>
                    <th style="width:130px;text-align:right;">Frequência</th>
                    <th style="width:80px;text-align:center;">Ativo</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tipos)
                {
                    <tr style="@(!t.Ativo ? "opacity:.45;" : "")">
                        <td style="font-weight:500;">@t.Nome</td>
                        <td style="text-align:right;color:var(--ink-600);">
                            @(t.ValorPadrao.HasValue ? t.ValorPadrao.Value.ToString("C2") : "—")
                        </td>
                        <td style="text-align:right;color:var(--ink-600);">
                            @(t.DuracaoHoras.HasValue ? $"{t.DuracaoHoras:0.#} h" : "—")
                        </td>
                        <td style="text-align:right;color:var(--ink-400);font-size:.82rem;">
                            A cada @t.FrequenciaDias dia@(t.FrequenciaDias != 1 ? "s" : "")
                        </td>
                        <td style="text-align:center;">
                            <span class="badge @(t.Ativo ? "badge-free" : "badge-maint")">
                                @(t.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div style="display:flex;gap:.35rem;justify-content:flex-end;">
                                <button class="btn btn-ghost btn-sm" title="Editar"
                                        @onclick="() => IniciarEdicao(t)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="btn btn-ghost btn-sm" title="@(t.Ativo ? "Desativar" : "Ativar")"
                                        @onclick="() => ToggleAtivoAsync(t)"
                                        style="color:@(t.Ativo ? "var(--s-maint)" : "var(--s-free)");">
                                    @if (t.Ativo)
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<TipoServicoConfig> _tipos = new();
    private TipoServicoConfig _editando = new() { FrequenciaDias = 15 };
    private bool _carregando = true;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _tipos = await PedidoSvc.ListarTiposServicoAsync(UserCtx.EmpresaId, apenasAtivos: false);
        _carregando = false;
    }

    private void IniciarEdicao(TipoServicoConfig t)
    {
        _editando = new TipoServicoConfig
        {
            Id             = t.Id,
            EmpresaId      = t.EmpresaId,
            Nome           = t.Nome,
            ValorPadrao    = t.ValorPadrao,
            DuracaoHoras   = t.DuracaoHoras,
            FrequenciaDias = t.FrequenciaDias,
            Ativo          = t.Ativo,
        };
        _erro = null;
    }

    private void CancelarEdicao()
    {
        _editando = new TipoServicoConfig { FrequenciaDias = 15 };
        _erro = null;
    }

    private async Task SalvarAsync()
    {
        _erro = null;
        if (string.IsNullOrWhiteSpace(_editando.Nome))
        {
            _erro = "Informe o nome do serviço.";
            return;
        }
        _editando.EmpresaId = UserCtx.EmpresaId;
        await PedidoSvc.SalvarTipoServicoAsync(_editando);
        CancelarEdicao();
        await CarregarAsync();
    }

    private async Task ToggleAtivoAsync(TipoServicoConfig t)
    {
        t.Ativo = !t.Ativo;
        await PedidoSvc.SalvarTipoServicoAsync(t);
        await CarregarAsync();
    }
}
