@page "/servicos"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject OrdemServicoService OSService
@inject UsuarioContextService UserCtx

<PageTitle>Ordens de Serviço — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Operações</span>
        <h1>Ordens de Serviço</h1>
    </div>
    <div class="page-head-actions">
        <div class="field" style="margin:0;min-width:150px;">
            <select @bind="_filtroStatus" @bind:after="CarregarAsync" style="height:34px;">
                <option value="">Todos os status</option>
                <option value="Pendente">Pendente</option>
                <option value="EmExecucao">Em Execução</option>
                <option value="Finalizado">Finalizado</option>
            </select>
        </div>
        <a href="/servicos/nova" class="btn btn-primary btn-sm">+ Nova OS</a>
    </div>
</div>

<!-- Contadores por status -->
<div style="display:flex;gap:.75rem;margin-bottom:1.75rem;flex-wrap:wrap;">
    @foreach (var (label, count, cor) in _contadores)
    {
        <div style="padding:.65rem 1rem;border:1px solid var(--line);border-radius:3px;min-width:120px;">
            <div style="font-size:1.4rem;font-weight:700;color:@cor;line-height:1;">@count</div>
            <div style="font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-400);margin-top:.15rem;">@label</div>
        </div>
    }
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;justify-content:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else if (!_os.Any())
{
    <div style="padding:3rem 2rem;text-align:center;color:var(--ink-300);">
        <p style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;margin-bottom:1.25rem;">Nenhuma ordem de serviço encontrada</p>
        <a href="/servicos/nova" class="btn btn-primary btn-sm">Criar Primeira OS</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width:56px">#</th>
                    <th>Embarcação</th>
                    <th>Cliente</th>
                    <th>Tipo de Serviço</th>
                    <th>Responsável</th>
                    <th>Valor</th>
                    <th>Criada em</th>
                    <th>Status</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in _os)
                {
                    <tr>
                        <td style="color:var(--ink-300);font-size:.8rem;font-family:monospace;">#@o.Id</td>
                        <td><strong style="font-weight:500;">@(o.Embarcacao?.Nome ?? "—")</strong></td>
                        <td style="color:var(--ink-500);">@(o.Embarcacao?.Cliente?.Nome ?? "—")</td>
                        <td style="color:var(--ink-500);">@o.TipoServico</td>
                        <td style="color:var(--ink-500);">@(o.Responsavel?.Nome ?? "—")</td>
                        <td style="font-weight:500;">@(o.ValorFinal.HasValue ? o.ValorFinal.Value.ToString("C2") : o.ValorEstimado.HasValue ? $"~{o.ValorEstimado.Value:C2}" : "—")</td>
                        <td style="color:var(--ink-500);font-size:.8rem;">@o.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td><OsStatusBadge Status="@o.Status" /></td>
                        <td>
                            <div style="display:flex;gap:.4rem;justify-content:flex-end;">
                                <a href="/servicos/@o.Id" class="btn btn-ghost btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <a href="/servicos/@o.Id/imprimir" target="_blank" class="btn btn-ghost btn-sm" title="Imprimir OS">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                </a>
                                @if (o.Status != StatusOS.Finalizado)
                                {
                                    <button class="btn btn-ghost btn-sm" title="Avançar status"
                                            @onclick="() => AvancarStatus(o)"
                                            style="color:var(--s-free);">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<OrdemServico> _os = new();
    private string _filtroStatus = "";
    private bool _carregando = true;
    private List<(string, int, string)> _contadores = new();

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        StatusOS? st = Enum.TryParse<StatusOS>(_filtroStatus, out var sv) ? sv : null;
        _os = await OSService.ListarPorEmpresaAsync(UserCtx.EmpresaId, st);
        _contadores = new()
        {
            ("Pendentes",    _os.Count(o => o.Status == StatusOS.Pendente),    "var(--ink-900)"),
            ("Em execução",  _os.Count(o => o.Status == StatusOS.EmExecucao),  "var(--navy-700)"),
            ("Finalizadas",  _os.Count(o => o.Status == StatusOS.Finalizado),  "var(--s-free)"),
        };
        _carregando = false;
    }

    private async Task AvancarStatus(OrdemServico o)
    {
        try { await OSService.AvancarStatusAsync(o.Id, UserCtx.EmpresaId); await CarregarAsync(); }
        catch { }
    }
}
