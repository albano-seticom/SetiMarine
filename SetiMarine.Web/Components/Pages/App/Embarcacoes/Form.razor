@page "/embarcacoes/nova"
@page "/embarcacoes/{Id:int}"
@layout AppLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SetiMarine.Application.Services
@using SetiMarine.Domain.Entities
@using SetiMarine.Domain.Enums
@inject EmbarcacaoService EmbarcacaoService
@inject NavigationManager Nav
@inject UsuarioContextService UserCtx

<PageTitle>@(_isNovo ? "Nova Embarcação" : "Editar Embarcação") — SetiMarine</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow"><a href="/embarcacoes" style="color:inherit;text-decoration:none;border-bottom:1px solid var(--line);">Embarcações</a> /</span>
        <h1>@(_isNovo ? "Nova Embarcação" : _embarcacao.Nome)</h1>
    </div>
</div>

@if (_carregando)
{
    <div style="padding:3rem 0;display:flex;align-items:center;gap:.75rem;color:var(--ink-300);">
        <div style="width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--navy-700);border-radius:50%;animation:spin .7s linear infinite;"></div>
        <span style="font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;">Carregando</span>
    </div>
}
else
{
    <EditForm Model="_embarcacao" OnValidSubmit="SalvarAsync" style="max-width:700px;">
        <DataAnnotationsValidator />

        <div class="form-section">
            <div class="form-section-title">Identificação</div>

            <div class="form-row" style="grid-template-columns:1fr auto;">
                <div class="field">
                    <label>Nome da Embarcação *</label>
                    <InputText @bind-Value="_embarcacao.Nome" placeholder="Ex: Voyager II" />
                    <ValidationMessage For="() => _embarcacao.Nome" />
                </div>
                <div class="field">
                    <label>Tipo</label>
                    <select @bind="_tipoStr">
                        <option value="Lancha">Lancha</option>
                        <option value="Veleiro">Veleiro</option>
                        <option value="Escuna">Escuna</option>
                        <option value="JetSki">Jet Ski</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Proprietário *</label>
                    <select @bind="_clienteIdStr">
                        <option value="">Selecione...</option>
                        @foreach (var c in _clientes)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Número de Registro</label>
                    <InputText @bind-Value="_embarcacao.NumeroRegistro" placeholder="Ex: BR-1234-ABC" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Fabricação</div>

            <div class="form-row">
                <div class="field">
                    <label>Fabricante</label>
                    <InputText @bind-Value="_embarcacao.Fabricante" placeholder="Ex: Cimitarra, Phantom..." />
                </div>
                <div class="field">
                    <label>Modelo</label>
                    <InputText @bind-Value="_embarcacao.Modelo" placeholder="Ex: 360 Sport" />
                </div>
                <div class="field">
                    <label>Ano</label>
                    <InputNumber @bind-Value="_embarcacao.AnoFabricacao" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Cor</label>
                    <InputText @bind-Value="_embarcacao.Cor" placeholder="Ex: Branco e Azul" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Dimensões</div>

            <div class="form-row">
                <div class="field">
                    <label>Comprimento (m) *</label>
                    <InputNumber @bind-Value="_embarcacao.ComprimentoMetros" />
                </div>
                <div class="field">
                    <label>Boca (m)</label>
                    <InputNumber @bind-Value="_embarcacao.BocaMetros" />
                </div>
                <div class="field">
                    <label>Calado (m)</label>
                    <InputNumber @bind-Value="_embarcacao.CaladoMetros" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Configurações</div>

            <div class="form-row" style="grid-template-columns:auto 1fr;">
                <div class="field" style="display:flex;align-items:flex-end;padding-bottom:.5rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink-900);">
                        <InputCheckbox @bind-Value="_embarcacao.Ativa" />
                        Embarcação ativa
                    </label>
                </div>
            </div>
        </div>

        @if (_erro != null)
        {
            <div style="margin-bottom:1.25rem;padding:.85rem 1rem;background:rgba(164,68,54,.08);border:1px solid rgba(164,68,54,.22);color:var(--s-maint);font-size:.82rem;border-radius:2px;">
                @_erro
            </div>
        }

        <div class="form-actions">
            <a href="/embarcacoes" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Embarcacao _embarcacao = new();
    private List<Cliente> _clientes = new();
    private bool _isNovo => Id is null;
    private bool _carregando = true;
    private bool _salvando;
    private string? _erro;

    private string _tipoStr = "Lancha";
    private string _clienteIdStr = "";

    protected override async Task OnInitializedAsync()
    {
        await UserCtx.InitAsync();
        _clientes = await EmbarcacaoService.ListarClientesAsync(UserCtx.EmpresaId);

        if (!_isNovo)
        {
            var existente = await EmbarcacaoService.ObterPorIdAsync(Id!.Value, UserCtx.EmpresaId);
            if (existente == null) { Nav.NavigateTo("/embarcacoes"); return; }
            _embarcacao = existente;
            _tipoStr = _embarcacao.Tipo.ToString();
            _clienteIdStr = _embarcacao.ClienteId.ToString();
        }
        else
        {
            _embarcacao = new Embarcacao { EmpresaId = UserCtx.EmpresaId, Ativa = true };
        }
        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro = null;
        try
        {
            if (!int.TryParse(_clienteIdStr, out var clienteId) || clienteId == 0)
            {
                _erro = "Selecione o proprietário da embarcação.";
                _salvando = false;
                return;
            }
            _embarcacao.ClienteId = clienteId;
            _embarcacao.Tipo = Enum.Parse<TipoEmbarcacao>(_tipoStr);

            if (_isNovo) await EmbarcacaoService.CriarAsync(_embarcacao);
            else         await EmbarcacaoService.EditarAsync(_embarcacao);
            Nav.NavigateTo("/embarcacoes");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
