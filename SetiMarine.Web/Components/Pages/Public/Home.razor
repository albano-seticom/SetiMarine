            ["hero.sub"]="Painel Kanban, mapa visual de vagas, WhatsApp integrado e app para seus clientes — tudo em uma plataforma.",
            ["hero.cta"]="Começar gratuitamente", ["hero.demo"]="Ver demonstração",
            ["map.eye"]="Mapa visual", ["map.title"]="Visualize toda a marina",
            ["map.sub"]="Clique em qualquer vaga para gerenciar — atualizado ao vivo",
            ["status.free"]="Livre", ["status.occupied"]="Ocupada",
            ["status.moving"]="Em movimentação", ["status.maint"]="Manutenção",
            ["zone.water"]="Vagas na água", ["zone.dry"]="Seco (dry stack)",
            ["plans.eye"]="Planos e preços", ["plans.title"]="Escolha seu plano",
            ["plans.sub"]="Planos flexíveis para marinas de todos os tamanhos",
            ["plan.cta"]="Assinar agora", ["plan.popular"]="Mais popular",
        },
        ["en"] = new() {
            ["nav.login"]="Sign in", ["nav.signup"]="Create account",
            ["hero.badge"]="Nautical SaaS · World-class platform",
            ["hero.h1.pre"]="Manage your marina", ["hero.h1.accent"]="in real time",
            ["hero.sub"]="Kanban board, visual berth map, WhatsApp integration and client app — all in one platform.",
            ["hero.cta"]="Get started free", ["hero.demo"]="Watch demo",
            ["map.eye"]="Visual map", ["map.title"]="See your entire marina",
            ["map.sub"]="Click any berth to manage — live updates via SignalR",
            ["status.free"]="Free", ["status.occupied"]="Occupied",
            ["status.moving"]="In movement", ["status.maint"]="Maintenance",
            ["zone.water"]="Wet berths", ["zone.dry"]="Dry stack",
            ["plans.eye"]="Plans & pricing", ["plans.title"]="Choose your plan",
            ["plans.sub"]="Flexible plans for marinas of all sizes",
            ["plan.cta"]="Subscribe now", ["plan.popular"]="Most popular",
        },
        ["es"] = new() {
            ["nav.login"]="Entrar", ["nav.signup"]="Crear cuenta",
            ["hero.badge"]="SaaS náutico · Nivel mundial",
            ["hero.h1.pre"]="Gestión de tu marina", ["hero.h1.accent"]="en tiempo real",
            ["hero.sub"]="Panel Kanban, mapa visual de amarres, WhatsApp integrado y app para tus clientes — todo en una plataforma.",
            ["hero.cta"]="Empezar gratis", ["hero.demo"]="Ver demo",
            ["map.eye"]="Mapa visual", ["map.title"]="Visualiza toda la marina",
            ["map.sub"]="Haz clic en cualquier amarre para gestionar",
            ["status.free"]="Libre", ["status.occupied"]="Ocupado",
            ["status.moving"]="En movimiento", ["status.maint"]="Mantenimiento",
            ["zone.water"]="Amarres en agua", ["zone.dry"]="Almacenaje en seco",
            ["plans.eye"]="Planes y precios", ["plans.title"]="Elige tu plan",
            ["plans.sub"]="Planes flexibles para marinas de todos los tamaños",
            ["plan.cta"]="Suscribirse", ["plan.popular"]="Más popular",
        },
    };

    record SlipData(string Code, string Status, string? Boat = null, string? ImgFile = null);
    record RowData(string Label, List<SlipData> Slips);

    private List<RowData> WaterRows = new()
    {
        new("A", new(){
            new("A1","occ","Boa Viagem","lancha-top.svg"), new("A2","occ","Sereia","lancha-top.svg"),
            new("A3","free"), new("A4","free"),
            new("A5","mov","Liberdade","lancha-top.svg"), new("A6","free"),
            new("A7","occ","Netuno","veleiro-top.svg"), new("A8","free"),
        }),
        new("B", new(){
            new("B1","free"), new("B2","occ","Mar Azul","lancha-top.svg"),
            new("B3","occ","Sol Nascente","lancha-top.svg"), new("B4","maint"),
            new("B5","free"), new("B6","occ","Vento Norte","veleiro-top.svg"),
            new("B7","free"), new("B8","free"),
        }),
    };

    private List<RowData> DryRows = new()
    {
        new("S1", new(){
            new("S1-1","occ","Aquarius","lancha-top.svg"), new("S1-2","occ","Titan","lancha-top.svg"),
            new("S1-3","free"), new("S1-4","free"),
            new("S1-5","occ","Atlantis","lancha-top.svg"), new("S1-6","free"),
        }),
        new("S2", new(){
            new("S2-1","free"), new("S2-2","mov","Poseidon","lancha-top.svg"),
            new("S2-3","occ","Brisa","veleiro-top.svg"), new("S2-4","free"),
            new("S2-5","free"), new("S2-6","occ","Orca","lancha-top.svg"),
        }),
    };
}
