@page "/"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@using SetiMarine.Infrastructure.Data
@using SetiMarine.Domain.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>SetiMarine — Gestão de Marinas em Tempo Real</PageTitle>

<style>
@@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@@300;400;500;600&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ocean:   #050d1a;
  --deep:    #071525;
  --surface: #0a1e30;
  --glass:   rgba(255,255,255,0.04);
  --border:  rgba(0,200,255,0.12);
  --cyan:    #00d4ff;
  --cyan2:   #00a8cc;
  --gold:    #c9a84c;
  --text:    #e8f4f8;
  --muted:   #5a8098;
  --radius:  12px;
}

html { scroll-behavior: smooth; }

body {
  background: var(--ocean);
  color: var(--text);
  font-family: 'Outfit', sans-serif;
  font-size: 16px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* -- NAV -- */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  height: 68px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(1.5rem, 5vw, 4rem);
  background: rgba(5,13,26,0.82);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
}

.nav-logo {
  display: flex; align-items: center;
  text-decoration: none;
}

.nav-logo-img {
  height: 72px;
  width: auto;
  display: block;
  border-radius: 6px;
}

.nav-right { display: flex; align-items: center; gap: .5rem; }

/* Language selector */
.lang-wrap { position: relative; }

.lang-btn {
  display: flex; align-items: center; gap: 6px;
  background: var(--glass); border: 1px solid var(--border);
  color: var(--text); padding: .4rem .85rem; border-radius: 8px;
  cursor: pointer; font-family: 'Outfit', sans-serif; font-size: .85rem;
  transition: border-color .2s, background .2s;
}
.lang-btn:hover { border-color: rgba(0,212,255,.3); background: rgba(0,212,255,.06); }

.sm-flag { width: 18px; height: 13px; border-radius: 2px; object-fit: cover; }
.sm-chev { font-size: .65rem; transition: transform .2s; }
.sm-chev.open { transform: rotate(180deg); }

.lang-drop {
  position: absolute; top: calc(100% + 8px); right: 0;
  background: var(--deep); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; min-width: 150px;
  box-shadow: 0 16px 40px rgba(0,0,0,.5);
  animation: fadeIn .15s ease;
}

@@keyframes fadeIn { from { opacity:0; transform:translateY(-6px) } to { opacity:1; transform:translateY(0) } }

.lang-opt {
  display: flex; align-items: center; gap: 10px;
  padding: .65rem 1rem; cursor: pointer; font-size: .88rem;
  color: var(--muted); transition: background .15s, color .15s;
}
.lang-opt:hover, .lang-opt.active { background: rgba(0,212,255,.08); color: var(--cyan); }

.nav-login {
  background: transparent; border: 1px solid var(--border);
  color: var(--muted); padding: .45rem 1.1rem; border-radius: 8px;
  cursor: pointer; font-family: 'Outfit', sans-serif; font-size: .88rem;
  transition: color .2s, border-color .2s;
}
.nav-login:hover { color: var(--text); border-color: rgba(0,212,255,.3); }

.nav-signup {
  background: var(--cyan); color: #030b14;
  border: none; padding: .5rem 1.25rem; border-radius: 8px;
  cursor: pointer; font-family: 'Outfit', sans-serif;
  font-size: .88rem; font-weight: 600;
  transition: background .2s, box-shadow .2s, transform .15s;
  box-shadow: 0 0 0 rgba(0,212,255,0);
}
.nav-signup:hover {
  background: #1ad8ff;
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(0,212,255,.3);
}


/* -- HERO -- */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center;
  padding: 8rem 1.5rem 0;
  position: relative; overflow: hidden;
}

/* Deep water gradient background */
.hero::before {
  content: '';
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,80,140,.55) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 80% 80%, rgba(0,40,80,.4) 0%, transparent 60%),
    linear-gradient(180deg, #050d1a 0%, #071525 60%, #0a1e30 100%);
}

/* Animated light rays */
.hero-rays {
  position: absolute; inset: 0; z-index: 0; overflow: hidden;
  pointer-events: none;
}
.ray {
  position: absolute; top: -10%; left: 50%;
  width: 1px; height: 70%;
  background: linear-gradient(180deg, rgba(0,212,255,.18) 0%, transparent 100%);
  transform-origin: top center;
  animation: rayFloat 8s ease-in-out infinite;
}
.ray:nth-child(1) { transform: translateX(-200px) rotate(-12deg); animation-delay: 0s; }
.ray:nth-child(2) { transform: translateX(-80px)  rotate(-5deg);  animation-delay: 1.2s; width: 2px; opacity: .6; }
.ray:nth-child(3) { transform: translateX(0px)    rotate(0deg);   animation-delay: 0.6s; }
.ray:nth-child(4) { transform: translateX(100px)  rotate(6deg);   animation-delay: 2s;  }
.ray:nth-child(5) { transform: translateX(220px)  rotate(13deg);  animation-delay: 0.3s; }

@@keyframes rayFloat {
  0%,100% { opacity: .4; }
  50% { opacity: .9; }
}

.hero-inner {
  position: relative; z-index: 2;
  max-width: 860px; margin: 0 auto;
  animation: heroReveal .9s ease both;
}

@@keyframes heroReveal {
  from { opacity:0; transform:translateY(28px) }
  to   { opacity:1; transform:translateY(0) }
}

.hero-chip {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(0,212,255,.1); border: 1px solid rgba(0,212,255,.25);
  color: var(--cyan); padding: .4rem 1.1rem; border-radius: 100px;
  font-size: .8rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
  margin-bottom: 2rem;
}
.chip-dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--cyan);
  animation: blink 2s ease-in-out infinite;
}
@@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

.hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(3rem, 7vw, 5.5rem);
  font-weight: 300; line-height: 1.12;
  letter-spacing: -0.02em; color: var(--text);
  margin-bottom: 1.5rem;
}

.hero-accent {
  font-style: italic; font-weight: 400;
  background: linear-gradient(90deg, var(--cyan), #60efff);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Underline wave decoration */
.hero-ul { position: relative; display: inline-block; }
.hero-ul::after {
  content: '';
  position: absolute; left: 0; bottom: -6px; right: 0; height: 3px;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  border-radius: 100px;
}

.hero-sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: var(--muted); max-width: 560px; margin: 0 auto 2.5rem;
  font-weight: 300;
}

.hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }

.btn-primary {
  background: var(--cyan); color: #030b14;
  border: none; padding: .85rem 2rem; border-radius: 10px;
  cursor: pointer; font-family: 'Outfit', sans-serif;
  font-size: 1rem; font-weight: 600;
  transition: background .2s, box-shadow .2s, transform .15s;
}
.btn-primary:hover {
  background: #1ad8ff; transform: translateY(-2px);
  box-shadow: 0 10px 32px rgba(0,212,255,.35);
}

.btn-ghost-hero {
  background: transparent; border: 1px solid rgba(0,212,255,.3);
  color: var(--cyan); padding: .85rem 2rem; border-radius: 10px;
  cursor: pointer; font-family: 'Outfit', sans-serif;
  font-size: 1rem; font-weight: 400;
  transition: background .2s, border-color .2s;
}
.btn-ghost-hero:hover { background: rgba(0,212,255,.07); border-color: rgba(0,212,255,.5); }

/* Stats bar */
.stats-bar {
  display: flex; justify-content: center; gap: clamp(2rem, 6vw, 5rem);
  padding: 1.75rem 2rem;
  background: rgba(7,21,37,.7); backdrop-filter: blur(12px);
  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  position: relative; z-index: 2;
}

.stat { text-align: center; }
.stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.8rem; font-weight: 600; color: var(--cyan);
  letter-spacing: -0.02em; line-height: 1;
}
.stat-lbl { font-size: .78rem; color: var(--muted); letter-spacing: .05em; text-transform: uppercase; margin-top: 4px; }

/* Wave divider */
.wave-div { position: relative; z-index: 1; line-height: 0; margin-top: -1px; }
.wave-div svg { display: block; width: 100%; }

/* -- SECTIONS SHARED -- */
.section {
  padding: 6rem clamp(1.5rem, 5vw, 4rem);
  max-width: 1200px; margin: 0 auto;
}

.eyebrow {
  display: inline-block;
  font-size: .75rem; font-weight: 500; letter-spacing: .15em;
  text-transform: uppercase; color: var(--cyan);
  margin-bottom: 1rem;
}

.sec-h {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 300; letter-spacing: -0.02em;
  line-height: 1.2; margin-bottom: 1rem;
}

.sec-p {
  color: var(--muted); font-size: 1.05rem; font-weight: 300;
  max-width: 540px;
}

/* -- MAP SECTION -- */
.map-section {
  background: var(--deep);
  padding: 6rem 0;
}

.map-header {
  text-align: center; padding: 0 clamp(1.5rem, 5vw, 4rem) 3rem;
}

.map-demo {
  max-width: 900px; margin: 0 auto;
  padding: 2rem clamp(1.5rem, 4vw, 3rem);
  background: rgba(10,30,48,.6);
  border: 1px solid var(--border); border-radius: 18px;
  backdrop-filter: blur(10px);
  box-shadow: 0 30px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(0,212,255,.05);
}

/* Legend */
.map-legend {
  display: flex; gap: 1.5rem; flex-wrap: wrap;
  margin-bottom: 2rem; padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}

.leg { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--muted); }
.leg-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
.leg-free  { background: rgba(0,212,255,.35); border: 1px solid rgba(0,212,255,.6); }
.leg-occ   { background: rgba(0,160,200,.7); }
.leg-mov   { background: rgba(201,168,76,.6); border: 1px solid var(--gold); }
.leg-maint { background: rgba(200,60,60,.4); border: 1px solid rgba(200,60,60,.7); }

/* Zone label */
.zone-lbl {
  font-size: .7rem; letter-spacing: .12em; text-transform: uppercase;
  color: var(--muted); margin-bottom: .75rem; margin-top: 1.5rem;
}
.zone-lbl:first-of-type { margin-top: 0; }

/* Slip grid */
.slip-row {
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 6px;
}

.row-lbl {
  width: 28px; text-align: right;
  font-size: .72rem; color: var(--muted);
  font-family: 'Outfit', sans-serif; font-weight: 500;
  flex-shrink: 0;
  padding-right: 6px;
  border-right: 1px solid var(--border);
}

.slip {
  width: 52px; height: 52px; border-radius: 8px;
  display: grid; place-items: center;
  position: relative; overflow: hidden;
  cursor: pointer; transition: transform .15s, box-shadow .15s;
  flex-shrink: 0;
}
.slip:hover { transform: scale(1.07); z-index: 2; }

.slip-free  {
  background: rgba(0,212,255,.06);
  border: 1px dashed rgba(0,212,255,.3);
}
.slip-occ   {
  background: rgba(0,140,180,.25);
  border: 1px solid rgba(0,180,230,.4);
  box-shadow: inset 0 0 12px rgba(0,140,180,.2);
}
.slip-mov   {
  background: rgba(201,168,76,.15);
  border: 1px solid rgba(201,168,76,.5);
  animation: movPulse 2s ease-in-out infinite;
}
.slip-maint {
  background: rgba(180,40,40,.15);
  border: 1px solid rgba(200,60,60,.4);
}

@@keyframes movPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(201,168,76,.3); }
  50%      { box-shadow: 0 0 0 4px rgba(201,168,76,.12); }
}

.slip-code { font-size: .6rem; color: var(--muted); font-weight: 500; }
.slip-boat { width: 36px; height: 36px; object-fit: contain; opacity: .8; }

/* -- PLANS -- */
.plans-section { padding: 6rem clamp(1.5rem, 5vw, 4rem); background: var(--ocean); }
.plans-header { text-align: center; margin-bottom: 3.5rem; }
.plans-header .sec-p { max-width: 420px; margin: 0 auto; }

.plans-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem; max-width: 1000px; margin: 0 auto;
}

.plan-card {
  background: var(--surface);
  border: 1px solid var(--border); border-radius: 16px;
  padding: 2rem 1.75rem;
  position: relative; overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}
.plan-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 50px rgba(0,0,0,.35);
}

.plan-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, rgba(0,212,255,.3), transparent);
}

.plan-card.featured {
  border-color: rgba(0,212,255,.4);
  background: linear-gradient(160deg, rgba(0,212,255,.07) 0%, var(--surface) 60%);
  box-shadow: 0 0 40px rgba(0,212,255,.1);
}
.plan-card.featured::before { background: linear-gradient(90deg, transparent, var(--cyan), transparent); }

.plan-badge {
  display: inline-block;
  background: rgba(0,212,255,.15); border: 1px solid rgba(0,212,255,.35);
  color: var(--cyan); font-size: .72rem; font-weight: 600;
  letter-spacing: .08em; text-transform: uppercase;
  padding: .25rem .75rem; border-radius: 100px;
  margin-bottom: 1.25rem;
}

.plan-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem; font-weight: 400;
  letter-spacing: .02em; margin-bottom: .75rem;
}

.plan-price { margin-bottom: 1.5rem; }
.price-val {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.8rem; font-weight: 300; color: var(--cyan);
  letter-spacing: -0.03em;
}
.price-mo { font-size: .9rem; color: var(--muted); margin-left: 2px; }
.price-consult {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.6rem; font-style: italic; color: var(--muted);
}

.plan-list {
  list-style: none; margin-bottom: 2rem;
}
.plan-list li {
  padding: .5rem 0; border-bottom: 1px solid var(--border);
  font-size: .9rem; color: var(--muted); font-weight: 300;
  display: flex; align-items: center; gap: 8px;
}
.plan-list li::before {
  content: '—'; color: var(--cyan); font-size: .7rem; flex-shrink: 0;
}

.plan-btn {
  width: 100%; padding: .8rem; border-radius: 9px;
  background: transparent; border: 1px solid var(--border);
  color: var(--text); cursor: pointer;
  font-family: 'Outfit', sans-serif; font-size: .92rem;
  transition: background .2s, border-color .2s, color .2s;
}
.plan-btn:hover { border-color: rgba(0,212,255,.4); color: var(--cyan); background: rgba(0,212,255,.05); }
.plan-btn.featured {
  background: var(--cyan); border-color: var(--cyan); color: #030b14;
  font-weight: 600;
}
.plan-btn.featured:hover { background: #1ad8ff; border-color: #1ad8ff; }

.plans-loading {
  text-align: center; padding: 3rem; color: var(--muted);
  font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem;
}

/* -- CTA SECTION -- */
.cta-section {
  background: var(--deep);
  padding: 6rem clamp(1.5rem, 5vw, 4rem);
  text-align: center; position: relative; overflow: hidden;
}

.cta-section::before {
  content: '';
  position: absolute; top: -200px; left: 50%; transform: translateX(-50%);
  width: 700px; height: 400px; border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0,80,140,.4) 0%, transparent 70%);
  pointer-events: none;
}

.cta-section h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 4vw, 3rem); font-weight: 300;
  letter-spacing: -0.02em; margin-bottom: .75rem;
  position: relative;
}

.cta-section p {
  color: var(--muted); font-weight: 300; margin-bottom: 3rem;
  position: relative;
}

.cta-cards {
  display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;
  position: relative;
}

.cta-card {
  background: rgba(10,30,48,.7); border: 1px solid var(--border);
  border-radius: 16px; padding: 2rem 2.5rem;
  min-width: 260px; text-align: center;
  backdrop-filter: blur(10px);
}
.cta-card h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.4rem; font-weight: 400; margin-bottom: .5rem;
}
.cta-card p { color: var(--muted); font-size: .9rem; margin-bottom: 1.5rem; }

.cta-btn-wh {
  background: var(--cyan); color: #030b14;
  border: none; padding: .75rem 1.75rem; border-radius: 9px;
  cursor: pointer; font-family: 'Outfit', sans-serif;
  font-size: .92rem; font-weight: 600;
  transition: background .2s, box-shadow .2s;
}
.cta-btn-wh:hover { background: #1ad8ff; box-shadow: 0 8px 24px rgba(0,212,255,.3); }

.cta-btn-ol {
  background: transparent; border: 1px solid var(--border);
  color: var(--text); padding: .75rem 1.75rem; border-radius: 9px;
  cursor: pointer; font-family: 'Outfit', sans-serif;
  font-size: .92rem; transition: border-color .2s, color .2s;
}
.cta-btn-ol:hover { border-color: rgba(0,212,255,.35); color: var(--cyan); }

/* -- FOOTER -- */
.footer {
  background: var(--ocean);
  border-top: 1px solid var(--border);
  padding: 1.75rem clamp(1.5rem, 5vw, 4rem);
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem;
}

.footer span { font-size: .8rem; color: var(--muted); }

.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-size: .8rem; color: var(--muted); text-decoration: none;
  transition: color .2s;
}
.footer-links a:hover { color: var(--cyan); }

.footer-brand {
  display: flex; align-items: center; gap: .85rem;
}
.footer-logo {
  height: 60px; width: auto; display: block;
  mix-blend-mode: screen;
}

/* Responsive */
@@media (max-width: 640px) {
  .nav-logo-img { height: 58px; }
  .stats-bar { gap: 1.5rem; }
  .stat-num { font-size: 1.4rem; }
  .slip { width: 42px; height: 42px; }
}
</style>

<div class="sm-root">

  <!-- NAV -->
  <nav class="nav">
    <a href="/" class="nav-logo">
      <img src="/images/marina/Logo_Setimarine_horizontal.png" alt="SetiMarine" class="nav-logo-img" />
    </a>

    <div class="nav-right">
      <div class="lang-wrap">
        <button class="lang-btn" @onclick="ToggleLang">
          <img class="sm-flag" src="@FlagUrl" alt="@CurrentLang" />
          <span>@LangLabel</span>
          <span class="sm-chev @(LangOpen ? "open" : "")">?</span>
        </button>
        @if (LangOpen)
        {
          <div class="lang-drop">
            <div class="lang-opt @(CurrentLang=="pt" ? "active" : "")" @onclick="@(() => SetLang("pt"))">
              <img class="sm-flag" src="/images/flags/br.png" alt="BR" /> Português
            </div>
            <div class="lang-opt @(CurrentLang=="en" ? "active" : "")" @onclick="@(() => SetLang("en"))">
              <img class="sm-flag" src="/images/flags/us.png" alt="US" /> English
            </div>
            <div class="lang-opt @(CurrentLang=="es" ? "active" : "")" @onclick="@(() => SetLang("es"))">
              <img class="sm-flag" src="/images/flags/es.png" alt="ES" /> Español
            </div>
          </div>
        }
      </div>
            <a href="javascript:void(0)" onclick="irPara('/login')" class="nav-login" style="text-decoration:none;cursor:pointer">Entrar</a>

            <a href="javascript:void(0)" onclick="irPara('/cadastro')" class="nav-signup" style="text-decoration:none;cursor:pointer">Criar conta</a>
    </div>
  </nav>

    <!-- HERO -->
    <section class="hero">

        <video id="hero-video" autoplay muted loop playsinline
               poster="/images/marina/marina-hero.jpg"
               style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;opacity:0.25;">
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <div class="hero-rays">
            <div class="ray"></div>
            <div class="ray"></div>
            <div class="ray"></div>
            <div class="ray"></div>
            <div class="ray"></div>
        </div>
        <div class="hero-inner">
            <div class="hero-chip">
                <div class="chip-dot"></div>
                @T("hero.badge")
            </div>
            <h1>
                @T("hero.h1.pre")<br />
                <span class="hero-accent hero-ul">@T("hero.h1.accent")</span>
            </h1>
            <p class="hero-sub">@T("hero.sub")</p>
            <div class="hero-btns">
                <button class="btn-primary" @onclick="@(() => Nav.NavigateTo("/cadastro"))">@T("hero.cta")</button>
                <button class="btn-ghost-hero">@T("hero.demo")</button>
            </div>
        </div>

    <!-- Wave bottom -->
    <div class="wave-div" style="position:absolute;bottom:0;left:0;right:0;z-index:3;">
      <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z"
              fill="rgba(7,21,37,0.9)"/>
        <path d="M0,55 C180,30 360,70 540,55 C720,40 900,70 1080,55 C1260,40 1380,60 1440,55 L1440,80 L0,80 Z"
              fill="#071525" opacity=".8"/>
      </svg>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="stat">
      <div class="stat-num">100%</div>
      <div class="stat-lbl">Tempo real</div>
    </div>
    <div class="stat">
      <div class="stat-num">PT/EN/ES</div>
      <div class="stat-lbl">Multilíngue</div>
    </div>
    <div class="stat">
      <div class="stat-num">WhatsApp</div>
      <div class="stat-lbl">Integrado</div>
    </div>
    <div class="stat">
      <div class="stat-num">PWA</div>
      <div class="stat-lbl">App do cliente</div>
    </div>
  </div>

  <!-- MAP SECTION -->
  <section class="map-section">
    <div class="map-header">
      <div class="eyebrow">@T("map.eye")</div>
      <h2 class="sec-h">@T("map.title")</h2>
      <p class="sec-p" style="margin:0 auto;">@T("map.sub")</p>
    </div>

    <div style="padding:0 clamp(1.5rem,5vw,4rem);">
      <div class="map-demo">
        <!-- Legend -->
        <div class="map-legend">
          <div class="leg"><div class="leg-dot leg-free"></div> @T("status.free")</div>
          <div class="leg"><div class="leg-dot leg-occ"></div> @T("status.occupied")</div>
          <div class="leg"><div class="leg-dot leg-mov"></div> @T("status.moving")</div>
          <div class="leg"><div class="leg-dot leg-maint"></div> @T("status.maint")</div>
        </div>

        <!-- Water berths -->
        <div class="zone-lbl">@T("zone.water")</div>
        @foreach (var row in WaterRows)
        {
          <div class="slip-row">
            <span class="row-lbl">@row.Label</span>
            @foreach (var slip in row.Slips)
            {
              <div class="slip slip-@slip.Status" title="@slip.Code @(slip.Boat != null ? "· " + slip.Boat : "")">
                @if (slip.Boat != null)
                {
                  <img src="/images/boats/top/@slip.ImgFile" alt="@slip.Boat" class="slip-boat" />
                }
                else
                {
                  <span class="slip-code">@slip.Code</span>
                }
              </div>
            }
          </div>
        }

        <!-- Dry stack -->
        <div class="zone-lbl" style="margin-top:1.75rem;">@T("zone.dry")</div>
        @foreach (var row in DryRows)
        {
          <div class="slip-row">
            <span class="row-lbl">@row.Label</span>
            @foreach (var slip in row.Slips)
            {
              <div class="slip slip-@slip.Status" title="@slip.Code @(slip.Boat != null ? "· " + slip.Boat : "")">
                @if (slip.Boat != null)
                {
                  <img src="/images/boats/top/@slip.ImgFile" alt="@slip.Boat" class="slip-boat" />
                }
                else
                {
                  <span class="slip-code">@slip.Code</span>
                }
              </div>
            }
          </div>
        }
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section class="plans-section">
    <div class="plans-header">
      <div class="eyebrow">@T("plans.eye")</div>
      <h2 class="sec-h">@T("plans.title")</h2>
      <p class="sec-p">@T("plans.sub")</p>
    </div>

    @if (CarregandoPlanos)
    {
      <div class="plans-loading">Carregando planos...</div>
    }
    else if (!Planos.Any())
    {
      <div class="plans-loading">Em breve — planos disponíveis aqui.</div>
    }
    else
    {
      <div class="plans-grid">
        @foreach (var plano in Planos)
        {
          <div class="plan-card @(plano.Destaque ? "featured" : "")">
            @if (plano.Destaque)
            {
              <div class="plan-badge">@T("plan.popular")</div>
            }
            <div class="plan-name">@plano.Nome</div>
            <div class="plan-price">
              @if (plano.Valor > 0)
              {
                <span class="price-val">R$ @plano.Valor.ToString("N0")</span><span class="price-mo">/mês</span>
              }
              else
              {
                <span class="price-consult">Sob consulta</span>
              }
            </div>
            <ul class="plan-list">
              @if (plano.LimiteEmbarcacoes > 0)
              { <li>Até @plano.LimiteEmbarcacoes embarcações</li> }
              else
              { <li>Embarcações ilimitadas</li> }
              @if (plano.LimiteUsuarios > 0)
              { <li>Até @plano.LimiteUsuarios usuários</li> }
              else
              { <li>Usuários ilimitados</li> }
              @if (!string.IsNullOrEmpty(plano.Recursos))
              {
                @foreach (var rec in plano.Recursos.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                { <li>@rec</li> }
              }
            </ul>
            <button class="plan-btn @(plano.Destaque ? "featured" : "")"
                    @onclick="@(() => IrParaCadastro(plano))">
              @(plano.Valor > 0 ? T("plan.cta") : "Falar com vendas")
            </button>
          </div>
        }
      </div>
    }
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <h2>Pronto para modernizar sua marina?</h2>
    <p>Sem taxa de adesão. Suporte em português. Configure em minutos.</p>
    <div class="cta-cards">
      <div class="cta-card">
        <h3>Nova marina</h3>
        <p>Crie sua conta e comece hoje mesmo.</p>
        <button class="cta-btn-wh" @onclick="@(() => Nav.NavigateTo("/cadastro"))">Criar conta grátis</button>
      </div>
      <div class="cta-card">
        <h3>Já tenho acesso</h3>
        <p>Entre com seu usuário e senha.</p>
        <!-- Botão Entrar removido -->
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-brand">
      <img src="/images/marina/Logo_Setimarine.png" alt="SetiMarine" class="footer-logo" />
      <span>© 2026 SetiMarine · SETICOM Tecnologia · Avaré – SP</span>
    </div>
    <div class="footer-links">
      <a href="#">Termos</a>
      <a href="#">Privacidade</a>
      <a href="#">Contato</a>
    </div>
  </footer>
    <script src="js/nav.js"></script>
</div>

@code {
    private List<Plano> Planos = new();
    private bool CarregandoPlanos = true;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Planos = await db.Planos
            .Where(p => p.Ativo)
            .OrderBy(p => p.Valor)
            .ToListAsync();
        CarregandoPlanos = false;
    }

    private void IrParaCadastro(Plano plano)
    {
        if (!string.IsNullOrEmpty(plano.LinkPagamento))
            Nav.NavigateTo(plano.LinkPagamento, forceLoad: true);
        else
            Nav.NavigateTo("/cadastro");
    }

